# apm_gateway/.env 예시 — 복사해서 .env로 쓴다(.env는 커밋하지 않는다 · 루트 .gitignore의 .env 패턴).
# 인라인 주석 금지(주석은 별도 줄). list 값은 JSON 배열.
# 이 파일의 JENNIFER_* 키는 게이트웨이 프로세스 전용이다 — 에이전트를 붙인 WAS 호스트 셸에 export하지 않는다(R-29).

# ── 제니퍼 소스 설정은 두 방식 중 하나만 쓴다(둘 다 쓰면 기동 실패 — plans/87 J8 · D-287 ③) ──
# (1) 단일 설정 — 뷰 서버 하나(소스 id default · 알람 dbId jennifer · 존 없음)
# 제니퍼 뷰 서버 Open API 주소(5.7.0.1+ HTTPS는 인증서 호스트명으로 — SNI) · AIOps 전용 토큰(콘솔 발급)
JENNIFER_API_URL=
JENNIFER_API_TOKEN=
# (2) 다중 설정 — 소스 id JSON 배열(소문자 슬러그 · 예약어 default·api · 선언 순서 = 조회·표시 순서)
# 예: ["bank","common","legacy"] — id는 루트 config/db_registry.yaml solutions[apm].sources[]의 id와 같게(존은 레지스트리가 정한다)
# 소스마다 접두 키 JENNIFER_<ID>_<접미>를 둔다. <ID>는 id 대문자(bank → JENNIFER_BANK_API_URL).
#   필수: JENNIFER_<ID>_API_URL · JENNIFER_<ID>_API_TOKEN(소스별 AIOps 전용 토큰)
#   선택(비면 아래 전역 값): JENNIFER_<ID>_DOMAIN_IDS · JENNIFER_<ID>_API_TIMEOUT_SECONDS · JENNIFER_<ID>_RATE_LIMIT_PER_SEC · JENNIFER_<ID>_MAX_RESPONSE_BYTES
# 알람 dbId는 jennifer_<id>다. 소비자(noise_gate) 호출 상한 5초보다 소스 타임아웃을 짧게 둔다(R-33).
JENNIFER_SOURCES=

# 전역 값 — 단일 설정의 값이자 다중 설정 선택 키의 기본값
# 조회 도메인 제한(비면 전체) — 예: [1000]
JENNIFER_DOMAIN_IDS=[]
JENNIFER_API_TIMEOUT_SECONDS=10
JENNIFER_RATE_LIMIT_PER_SEC=5
JENNIFER_MAX_RESPONSE_BYTES=4194304

# 게이트웨이 MCP 서버(SSE)
APM_GATEWAY_HOST=127.0.0.1
APM_GATEWAY_PORT=9096
APM_GATEWAY_LOG_LEVEL=INFO
# 전송 인증(정적 Bearer · D-125) — 비면 무인증(운영 필수)
APM_GATEWAY_BEARER_TOKEN=

# naive reference_time 해석 · alarmTime 렌더 시간대
APM_TIMEZONE=Asia/Seoul
APM_INSTANCE_CACHE_SECONDS=600
APM_PROFILE_CALLS_PER_INVESTIGATION=5

# 이벤트 폴러(옵트인) — alarm:raw 발행 · 주기 하한 10초
APM_EVENT_POLLER_ENABLED=false
APM_EVENT_POLL_INTERVAL_SECONDS=30
APM_EVENT_MIN_LEVEL=warning
APM_EVENT_STREAM_KEY=alarm:raw
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
