# 복사해서 .env로 쓴다(.env는 커밋하지 않는다).
# 설치본(jennifer-server-<버전>.zip)과 라이선스 파일(license, 선택)을 둔 저장소 밖 절대 경로
JENNIFER_DIST_DIR=
JENNIFER_VERSION=5.7.0.1
# arm64 네이티브가 실패하면 linux/amd64(에뮬레이션)로 바꾼다
JENNIFER_PLATFORM=linux/arm64
JENNIFER_VIEW_HOST_PORT=17900
SAMPLE_WAS_HOST_PORT=18080
JENNIFER_DOMAIN_ID=1000
JENNIFER_INST_NAME=sample-was-01
TZ=Asia/Seoul
# 기동 전 점검(Bootstrap Check) 끄기 — 자원 부족으로 기동이 막힐 때만 1(로컬 한정)
DISABLE_BOOTSTRAP_CHECK=0
