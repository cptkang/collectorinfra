<?xml version="1.0" encoding="UTF-8"?>
<!-- 선택: Maven을 쓸 수 있을 때만. 폐쇄망에서는 build.sh(javac + jar)를 쓴다.
     extension jar는 뷰서버가 제공하므로 provided — 산출 jar에 넣지 않는다.
     저장소 접근이 안 되면 systemPath로 뷰서버의 extension jar를 가리킨다(아래 주석).
     버전은 운영 뷰서버의 extension jar와 맞춘다(1.5.8 = 제니퍼 5.5+ · 1.3.0 = 구버전 — 소스는 둘 다 컴파일된다).
     바이트코드는 Java 8(52) — extension jar 자체도 52라 5.5+(Java 17 JVM)에서도 그대로 로드된다. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.collectorinfra</groupId>
    <artifactId>collectorinfra-jennifer-adapter</artifactId>
    <version>0.2.0</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <repositories>
        <repository>
            <id>jennifer</id>
            <url>https://maven.jennifersoft.com/nexus/content/groups/public</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.aries</groupId>
            <artifactId>extension</artifactId>
            <version>1.5.8</version>
            <scope>provided</scope>
            <!-- 저장소 없이:
            <scope>system</scope>
            <systemPath>${env.EXT_JAR}</systemPath>
            -->
        </dependency>
    </dependencies>

    <build>
        <finalName>collectorinfra-jennifer-adapter-${project.version}</finalName>
    </build>
</project>
