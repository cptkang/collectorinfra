# ============================================================
# 민감 키 전용 환경변수 파일
# ============================================================
# 이 파일을 .encenv로 복사하여 실제 API 키를 입력하세요.
#   cp .encenv.example .encenv
#
# .encenv는 .gitignore에 등록되어 git에 업로드되지 않습니다.
# API 키, 시크릿 등 민감 정보만 이 파일에 관리하세요.
# ============================================================

# Gemini API 키 (LLM_PROVIDER=gemini 시 필수)
# Google AI Studio에서 발급: https://aistudio.google.com/apikey
LLM_GEMINI_API_KEY=

# Ollama Gateway API 키 (선택, 게이트웨이 사용 시)
LLM_API_KEY=

# FabriX API 키 (LLM_PROVIDER=fabrix 시)
LLM_FABRIX_API_KEY=
LLM_FABRIX_CLIENT_KEY=

# 운영자 비밀번호 (기본값 없음 — 운영 모드 AUTH_ENABLED=true 시 필수, 미설정이면 기동 거부)
ADMIN_PASSWORD=
# 운영자 토큰 JWT 시크릿 (운영 모드 필수). 생성: openssl rand -hex 32  또는  python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=
# 사용자 토큰 JWT 시크릿 (운영 모드 필수, ADMIN_JWT_SECRET과 반드시 다른 값 — 시크릿 분리로 권한 상승 차단)
AUTH_JWT_SECRET=

# Redis 비밀번호
REDIS_PASSWORD=

# worKB(사내메신저) 쪽지 발송 Bearer 인증 토큰 (알람 발송 채널 — 나머지 WORKB_* 설정은 .env)
WORKB_BEARER_TOKEN=
