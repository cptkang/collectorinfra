# ============================================================
# MCP 서버 (DBHub) — 환경변수 설정
# ============================================================
# config.toml과 함께 사용된다.
#   - config.toml: 서버 기본 설정 + 데이터소스 정의 (readonly, query_timeout, max_rows, pool 설정)
#   - .env: 서버 설정 오버라이드 + DB 연결 문자열 (보안상 TOML에 기재하지 않음)
#
# 환경변수 오버라이드 규칙:
#   - SERVER_* → config.toml의 [server] 섹션 오버라이드
#   - {SOURCE_NAME_UPPER}_CONNECTION → config.toml [[sources]]의 connection 오버라이드
#     소스명을 대문자로 변환한 것이 환경변수 접두사 (예: infra_db → INFRA_DB_CONNECTION)
#   - 이미 시스템 환경변수로 설정된 값은 .env보다 우선
#
# 소스별 세부 설정(readonly, query_timeout, max_rows, pool_min_size, pool_max_size)은
# config.toml에서만 변경 가능하다.
# ============================================================

# === MCP 서버 설정 ===
# 서버 이름 (FastMCP 인스턴스 식별용, 클라이언트 로그에 표시)
SERVER_NAME=dbhub-server
# 바인딩 호스트 (0.0.0.0: 모든 인터페이스 | 127.0.0.1: 로컬만)
SERVER_HOST=0.0.0.0
# 서버 포트 (메인 앱의 DBHUB_SERVER_URL 포트와 일치해야 함)
SERVER_PORT=9099
# 네트워크 전송 방식 (sse: Server-Sent Events — 별도 VM/컨테이너 간 통신 시 필수)
SERVER_TRANSPORT=sse
# 로그 레벨 (debug | info | warning | error)
SERVER_LOG_LEVEL=info

# === 전송 인증 (선택) ===
# SSE 전송에 정적 Bearer 토큰을 요구한다. 미설정이면 **인증 없이 뜬다** — 별도 VM에
# 노출하는 배치에서는 반드시 설정할 것. config.toml [server].bearer_token으로도 지정 가능.
# MCP_BEARER_TOKEN=

# === 도구 표면 게이트 (배치별로 값이 다르다 — D-122) ===
# 본체 NL→SQL 파이프라인 배치: EXPOSE_EXECUTE_SQL=true  (client가 execute_sql을 직접 호출)
# SRE 조사(HolmesGPT) 배치   : EXPOSE_EXECUTE_SQL=false / EXPOSE_RAW_PROMQL=false
#   → 원시 SQL·PromQL을 열면 LLM이 방언 오류로 조사 step을 소진한다.
# 값은 config.toml의 동명 설정을 덮어쓴다.
# EXPOSE_EXECUTE_SQL=true
# EXPOSE_RAW_PROMQL=false
# EXPOSE_POLESTAR_TOOLS=true
# 폴스타 도메인 deny(D-022/D-028) 적용 여부. 폴스타를 서빙하지 않는 배치는 false로 옵트아웃.
# POLESTAR_DOMAIN_GUARD=true

# === 폴스타 실시간 프로세스 API (polestar_process_snapshot 도구) ===
# 비면 도구가 명시적 오류를 반환한다(침묵 폴백 없음).
# PROCESS_API_BASE_URL=

# === Prometheus (PromQL 도구 — D-119 · docs/27) ===
# 미설정이면 PromQL 도구가 **전건 실패**한다: {"error": "PROMETHEUS_URL 미설정 …"}.
# 전제: 메트릭에 nodename 라벨이 있고 값이 폴스타 server_name과 같아야 한다(docs/27 §3.5).
# 개발 픽스처는 http://localhost:9190 (testdata/prometheus/docker-compose.yml)
# PROMETHEUS_URL=
# 인증 헤더 "전체 값"을 적는다 (예: Bearer eyJ...). 비면 헤더를 붙이지 않는다.
# PROMETHEUS_AUTH_HEADER=
# 서버가 강제하는 쿼리 timeout(초). 원시 패스스루 포함 모든 PromQL 호출에 적용된다.
# PROMETHEUS_QUERY_TIMEOUT=30

# === OpenMetrics (exporter 직접 스크레이프 · 폴스타 브리지 — plans/92 · D-210 · docs/27 §10) ===
# 전부 기본 off/기본값이면 현행 동작과 비트 동일하다(om_* 도구 미등록 · /metrics 라우트 부재).
# 스크레이프 허용목록([[openmetrics.targets]])과 브리지 소스([[openmetrics.bridge_sources]])는
# config.toml에서만 정한다 — LLM은 URL을 넘기지 못하고 서버 허용목록만 쓴다.
#
# --- S0: 트랙 A 도구(om_metric_instant · om_metric_catalog) ---
# 도구 등록 여부. 배치 표면 스위치(D-122) — SRE 조사 배치에서 exporter 현재값이 필요할 때 true.
# EXPOSE_OPENMETRICS_TOOLS=false
# 스크레이프 1회 timeout(초)
# OPENMETRICS_SCRAPE_TIMEOUT=10
# 응답 본문 상한(바이트, 기본 4 MiB). 넘으면 오류로 반환한다.
# OPENMETRICS_MAX_BODY_BYTES=4194304
# 도구 1회 반환 시리즈 상한. 넘으면 절단하고 truncated=true를 싣는다.
# OPENMETRICS_MAX_SERIES=200
#
# --- S1: PromQL 병행(PROMETHEUS_URL이 설정된 배치에서만 의미) ---
# OM 도구(EXPOSE_OPENMETRICS_TOOLS) 켜짐 + PROMETHEUS_URL 설정이면 prom_metric_instant에 source·cross_check 인자가 붙는다.
# 교차 검증 일괄 실행: scripts/prom_om_cross_check.py --metric <이름>
# prom_metric_instant source="auto" 강등 정책: off(강등 없음 · 기본) | on_unavailable | on_empty
#   편입 초기(nodename 규약 미확정)는 on_empty, 안정기는 on_unavailable 권고(plans/92 §4.8.6).
# OPENMETRICS_FALLBACK_POLICY=off
# Prometheus nodename 커버리지 캐시 TTL(초)
# OPENMETRICS_COVERAGE_TTL_SECONDS=600
# 교차 검증 value_drift 상대 허용 오차
# OPENMETRICS_CROSS_CHECK_TOLERANCE=0.05
# stale 판정 기준 스크레이프 주기(초)
# OPENMETRICS_SCRAPE_INTERVAL_HINT=15
#
# --- B-2: 폴스타 → OpenMetrics 브리지(GET /metrics) ---
# 라우트 등록 여부. 인증은 MCP_BEARER_TOKEN을 그대로 탄다 — Prometheus 쪽 authorization 설정이 필요하다.
# EXPOSE_POLESTAR_EXPORTER=false
# 브리지 응답 캐시 TTL(초). 원천이 시간 통계라 짧게 둘 이유가 없다.
# OPENMETRICS_BRIDGE_CACHE_SECONDS=300

# === 데이터소스 연결 문자열 ===
# config.toml의 [[sources]] name에 대응하는 환경변수로 DB 연결 정보를 설정한다.
# 연결 문자열이 비어있거나 주석 처리된 소스는 자동으로 비활성 처리된다.
#
# 환경변수명 규칙: {config.toml의 name을 대문자로}_CONNECTION
#   config.toml name="infra_db"      → INFRA_DB_CONNECTION
#   config.toml name="infra_db2"     → INFRA_DB2_CONNECTION
#   config.toml name="polestar"      → POLESTAR_CONNECTION
#   config.toml name="cloud_portal"  → CLOUD_PORTAL_CONNECTION
#
# ※ 클라이언트(루트 .env)의 DBHUB_SOURCE_NAME / ACTIVE_DB_IDS 값도
#    config.toml의 name과 정확히 일치해야 한다.

# --- 개발환경 예시 (Docker 컨테이너 접속 — 로컬 개발 시 해제) ---
# 연결 문자열이 비어있거나 주석 처리된 소스는 자동 비활성이므로, 그대로 복사해도 안전하다.

# PostgreSQL (Docker, port 5433) — config.toml name="infra_db"
# 형식: postgresql://user:password@host:port/dbname
# INFRA_DB_CONNECTION=postgresql://infra_user:password@localhost:5433/infra_db

# DB2 (Docker, port 50000) — config.toml name="infra_db2"
# ibm_db 연결 문자열 형식 (세미콜론 구분, 키=값 쌍)
# INFRA_DB2_CONNECTION=DATABASE=infradb;HOSTNAME=localhost;PORT=50000;PROTOCOL=TCPIP;UID=db2inst1;PWD=db2pass2024;

# Polestar PostgreSQL (Docker, port 5434) — config.toml name="polestar"
# DB2 대신 macOS 호환 PostgreSQL로 Polestar 테스트 환경 구동 시 사용
# POLESTAR_CONNECTION=postgresql://polestar_user:password@localhost:5434/infradb

# --- 운영환경 (멀티 DB, 필요 시 활성화) ---
# config.toml에 [[sources]] 정의가 있어야 연결 문자열이 적용된다.
# 정의 없는 소스에 연결 문자열만 설정하면 **조용히 무시된다**(오류 없음).
# POLESTAR_CONNECTION=postgresql://user:pass@host:5432/polestar_db
# CLOUD_PORTAL_CONNECTION=postgresql://user:pass@host:5432/cloud_portal_db
# ITSM_CONNECTION=postgresql://user:pass@host:5432/itsm_db

# 폴스타 존별 소스 — config.toml name="polestar_cm_gp" / "polestar_cm_yd" / "polestar_b0"
# gp·yd는 PostgreSQL, b0는 DB2(ibm_db 연결 문자열 형식)다.
# POLESTAR_CM_GP_CONNECTION=postgresql://user:pass@host:5432/polestar_gp
# POLESTAR_CM_YD_CONNECTION=postgresql://user:pass@host:5432/polestar_yd
# POLESTAR_B0_CONNECTION=DATABASE=polestar;HOSTNAME=host;PORT=50000;PROTOCOL=TCPIP;UID=user;PWD=pass;

# 자산관리 MariaDB — config.toml name="itam" (plans/95)
# 형식: mariadb://user:password@host:port/database (특수문자는 퍼센트 인코딩 · ?옵션 미지원)
# 계정은 SELECT 전용이어야 한다(D-003). 운영 값은 게이트 G-2·G-3(database명·읽기 전용 계정·경로) 확정 후.
# 로컬 샌드박스(testdata/itam/setup.sh, port 3307):
# ITAM_CONNECTION=mariadb://itam_ro:itam_ro_pass_2024@localhost:3307/INST1
