# ============================================================
# 인프라 데이터 조회 에이전트 — 환경변수 설정
# ============================================================
# 이 파일을 .env로 복사하여 실제 값으로 수정하세요.
#   cp .env.example .env
#
# pydantic-settings 규칙:
#   - list[str] 필드는 반드시 JSON 배열 형식 (예: ["a","b"])
#   - bool 필드는 true / false (소문자)
# ============================================================

# === LLM 설정 ===
# provider: ollama | fabrix | gemini
LLM_PROVIDER=ollama
# 오픈소스 LLM 모델명 (예: llama3.1:8b, llama3.1:70b, gemma2:9b, gemma3:12b, qwen2.5:14b, mistral:7b)
LLM_MODEL=llama3.1:8b
# Ollama 서버 주소
LLM_OLLAMA_BASE_URL=http://localhost:11434
# Ollama 요청 타임아웃 (초) — 모델/프롬프트 복잡도에 따라 조정
LLM_OLLAMA_TIMEOUT=180
# Ollama Gateway API 키 → .encenv에서 관리 (LLM_API_KEY)

# Gemini 설정 (LLM_PROVIDER=gemini 시)
# API 키는 .encenv 파일에서 관리 (LLM_GEMINI_API_KEY)
# Gemini 모델명 (비어있으면 LLM_MODEL 사용)
# 권장: gemini-2.0-flash (안정), gemini-3.1-pro (최신)
LLM_GEMINI_MODEL=gemini-2.0-flash

# FabriX 설정 (LLM_PROVIDER=fabrix 시)
LLM_FABRIX_BASE_URL=
# FabriX API 키 / 클라이언트 키 → .encenv에서 관리 (FABRIX_API_KEY, FABRIX_CLIENT_KEY)
# FabriX 모델명 (비어있으면 LLM_MODEL 사용)
LLM_FABRIX_CHAT_MODEL=

# === DB 연결 ===
# db_backend: dbhub (MCP 서버 경유) | direct (PostgreSQL 직접 연결)
DB_BACKEND=direct
# direct 모드 시 PostgreSQL 연결 문자열
DB_CONNECTION_STRING=postgresql://infra_user:password@localhost:5433/infra_db

# === MCP 서버 (DBHub) 설정 (DB_BACKEND=dbhub 시) ===
DBHUB_SERVER_URL=http://localhost:9099/sse
# ※ 반드시 mcp_server/config.toml의 [[sources]] name 값과 정확히 일치해야 함
# ※ 불일치 시 "알 수 없는 소스" 에러 발생
DBHUB_SOURCE_NAME=infra_db
# MCP 호출 전체 대기시간 (초)
DBHUB_MCP_CALL_TIMEOUT=60

# === 클라이언트 쿼리 정책 ===
# SQL 생성 실패 시 최대 재시도 횟수
QUERY_MAX_RETRY_COUNT=3
# SQL 생성 시 기본 LIMIT 절 값
QUERY_DEFAULT_LIMIT=1000
# 데이터 충분성 검사: hint/synonym 매핑의 최소 매칭 비율 (0.0~1.0)
QUERY_SUFFICIENCY_REQUIRED_THRESHOLD=0.7
# 데이터 충분성 검사: LLM 추론 매핑의 최소 매칭 비율 (0.0~1.0)
QUERY_SUFFICIENCY_OPTIONAL_THRESHOLD=0.5

# === 보안 ===
# 마스킹 대상 컬럼명 목록 (JSON 배열 형식 필수)
SECURITY_SENSITIVE_COLUMNS=["password","secret","token","api_key","private_key","credential"]
# 마스킹 치환 문자열
SECURITY_MASK_PATTERN=***MASKED***
# 부분 마스킹 대상 컬럼 (JSON 배열 형식, 예: ["email","phone"])
SECURITY_PARTIAL_MASK_COLUMNS=[]
# IP 주소 마스킹 여부
SECURITY_MASK_IP=false
# 이메일 주소 마스킹 여부
SECURITY_MASK_EMAIL=false

# === API 서버 ===
API_HOST=0.0.0.0
API_PORT=8000
# CORS 허용 오리진 (JSON 배열 형식, 운영: ["https://your-domain.com"])
API_CORS_ORIGINS=["*"]
# 일반 질의 타임아웃 (초) — 그래프 전체 실행 제한
API_QUERY_TIMEOUT=60
# 파일 업로드 질의 타임아웃 (초) — 엑셀/Word 템플릿 처리 시 LLM 호출이 많으므로 넉넉히
API_FILE_QUERY_TIMEOUT=120

# === 운영자 인증 ===
ADMIN_USERNAME=admin
# 운영자 비밀번호 / JWT 시크릿 → .encenv에서 관리 (ADMIN_PASSWORD, ADMIN_JWT_SECRET)
# JWT 토큰 만료 시간 (시간)
ADMIN_JWT_EXPIRE_HOURS=24

# === 체크포인트 (대화 상태 저장) ===
# checkpoint_backend: sqlite | postgres
CHECKPOINT_BACKEND=sqlite
# SQLite 파일 경로 또는 :memory:
CHECKPOINT_DB_URL=checkpoints.db

# === 로그 ===
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis 비밀번호 → .encenv에서 관리 (REDIS_PASSWORD)
# TLS/SSL 사용 여부
REDIS_SSL=false
# Redis 소켓 타임아웃 (초)
REDIS_SOCKET_TIMEOUT=5

# === 스키마 캐시 ===
# 캐시 백엔드: redis | file
SCHEMA_CACHE_BACKEND=redis
# 파일 캐시 디렉토리 (SCHEMA_CACHE_BACKEND=file 시)
SCHEMA_CACHE_CACHE_DIR=.cache/schema
# 스키마 캐시 활성화 여부
SCHEMA_CACHE_ENABLED=true
# 컬럼 설명 자동 생성 여부 (LLM 사용)
SCHEMA_CACHE_AUTO_GENERATE_DESCRIPTIONS=true

# === 시멘틱 라우팅 (멀티 DB) ===
# true: 멀티 DB 시멘틱 라우팅 활성화 (ACTIVE_DB_IDS가 있으면 자동 활성화)
ENABLE_SEMANTIC_ROUTING=false
# 활성 DB ID 목록 (쉼표 구분, MCP 서버에 등록된 소스명과 일치해야 함)
# ACTIVE_DB_IDS=polestar,cloud_portal,itsm,itam

# === deepagents 의도 분해 오케스트레이션 (Plan 48 / D-037) ===
# 복합 의도를 sub-task로 분해하여 순차/병렬/데이터-의존 실행.
# 미입력(아래 줄 주석 유지) 시 멀티 DB 환경에서 '신규 경로가 기본 동작'한다.
#   - 강제 비활성(기존 semantic_router로 회귀): ENABLE_DEEPAGENT_ORCHESTRATION=false
#   - 강제 활성: ENABLE_DEEPAGENT_ORCHESTRATION=true
# semantic_routing과 상호 배타 — 둘 다 활성이면 orchestration이 우선한다.
# ENABLE_DEEPAGENT_ORCHESTRATION=true

# === deepagents 실제 패키지 — 트랙 B (Plan 49 / D-037) ===
# vLLM 오케스트레이터(tool-calling) + FabriX 워커(실질 응답처리) 분리 도입.
# 명시적 opt-in(기본 false) — vLLM 인프라가 필요하므로 자동 활성화하지 않는다.
# true + vLLM 가용 시 트랙 B, 그 외(false 또는 vLLM 미서빙)는 semantic_router 사용(가용성 분기).
# ENABLE_DEEPAGENTS_PACKAGE=true
# 오케스트레이터 provider: vllm(운영) | gemini(테스트/PoC 전용 — 외부 egress 필요, 폐쇄망 부적합)
ORCHESTRATOR_PROVIDER=vllm
# vLLM (OpenAI 호환) 오케스트레이터 — Qwen3.5-9B 서빙 엔드포인트
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_MODEL=Qwen3.5-9B
# vLLM은 보통 API 키 불필요 (필요 시 .encenv에서 ORCHESTRATOR_API_KEY 관리)
# ORCHESTRATOR_TIMEOUT=120
# ORCHESTRATOR_HEALTH_TIMEOUT=3
#
# [테스트 모드] vLLM 없이 Gemini로 deepagents 파이프라인 검증 (Plan 49 §4.7):
#   ORCHESTRATOR_PROVIDER=gemini
#   ORCHESTRATOR_MODEL=gemini-2.5-pro
#   API 키는 LLM_GEMINI_API_KEY(GOOGLE_API_KEY) 재사용 (또는 ORCHESTRATOR_API_KEY 별도 지정)

# === Polestar 전용 프롬프트 ===
# Polestar EAV 구조 전용 시스템 프롬프트를 적용할 DB ID
# ACTIVE_DB_IDS에 포함된 DB 중 Polestar 전용 프롬프트를 적용할 DB ID (콤마 구분)
# 비어있으면 모든 DB에 범용 프롬프트 적용
POLESTAR_DB_IDS=polestar

# === 멀티턴 대화 / Human-in-the-loop ===
# SQL 실행 전 사용자 승인 요구 여부
ENABLE_SQL_APPROVAL=false
# 대화 세션 최대 턴 수
CONVERSATION_MAX_TURNS=20
# 대화 세션 유효 시간 (시간)
CONVERSATION_TTL_HOURS=24

# ── 알람 이력 패턴 분석 (Plan 47) ─────────
ALARM_HISTORY_ENABLED=true
# 조회 기간(일): 90=일·주·월 주기 판정 가능(기본), 월 주기 작업이 많으면 180
ALARM_HISTORY_LOOKBACK_DAYS=90
ALARM_HISTORY_MAX_ROWS=2000
ALARM_HISTORY_CACHE_TTL_SECONDS=300
ALARM_ENRICH_TIMEOUT_SECONDS=5
ALARM_BURST_THRESHOLD_24H=5

# ── 알람 영향 프로세스 보강 (Plan 47-1) ─────────
# CPU/메모리 발생 알람 시점에 폴스타 실시간 프로세스 API를 hostname으로 조회.
# 내부망 시스템 — http://, 인증 불필요. CSV는 db_id=base_url 형식 (JSON 아님).
ALARM_PROCESS_ENRICH_ENABLED=true
ALARM_PROCESS_API_BASE_URLS_CSV=polestar_cm_gp=http://polestar.kbonecloud.com,polestar_cm_yd=http://yd-polestar.kbonecloud.com
ALARM_PROCESS_API_TIMEOUT_SECONDS=3
ALARM_PROCESS_TOP_N=5

# ── 알람 노이즈 캔슬링 게이트 (Plan 52, 기본 비활성 — 옵트인) ─────────
# enable_noise_gate=false면 기존 알람 발송 경로가 무변경(회귀 0). true로 켜면 4-티어
# (PAGE/TICKET/DASHBOARD/SUPPRESS) 발송 판단 게이트가 작동한다.
# ★ 게이트 활성 시 ALARM_MIN_SEVERITY=1 권장(§4.8): 게이트가 강등·억제를 수행하므로
#   주의(severity 1)까지 게이트에 도달해야 매트릭스 하단 행이 동작한다.
#   (severity 0 해소·severity 3 심각은 워커·게이트 어디서도 드롭하지 않음)
NOISE_ENABLE_NOISE_GATE=false
# ── E1 (현재 구현) ──
NOISE_SUPPRESS_MAX_SEVERITY=2            # 억제 허용 상한 (심각도 3은 항상 PAGE)
# IMPORTANCE_ID 코드→라벨 매핑(인스턴스별 확정 필요, 빈값=전부 보통취급). 예: 1=낮음,2=보통,3=높음
NOISE_IMPORTANCE_VALUE_MAP_CSV=
NOISE_SELF_HEAL_WINDOW_SECONDS=300       # 자가복구 상관 창(발생+해소 매칭)
NOISE_REPEAT_INTERVAL_SECONDS=14400      # 재발생 재통보 간격(4h, 핑거프린트 dedup TTL)
NOISE_NOISE_CONTEXT_TIMEOUT_SECONDS=3.0
NOISE_NOISE_CONTEXT_CACHE_TTL_SECONDS=300
NOISE_RESOLVED_TO_DASHBOARD=false        # 독립 해소(severity 0)를 DASHBOARD로 표시할지
NOISE_DECISION_STORE_PATH=logs/alarm_decisions.jsonl
NOISE_DECISION_STORE_ENABLED=true
# ── E2 (의존성 억제·인히비션 구현, 그 외 자리예약) ──
NOISE_DEBOUNCE_SECONDS=0
NOISE_FLAP_HIGH_THRESHOLD=20.0
NOISE_FLAP_LOW_THRESHOLD=5.0
NOISE_FLAPPING_ENABLED=false              # (E2) 플래핑 억제 on/off (상태 진동 시 안정화까지 보류)
NOISE_DEPENDENCY_SUPPRESSION=false        # (E2) 부모 리소스 비정상 시 자식 연쇄 노이즈 억제
NOISE_INHIBITION_ENABLED=false            # (E2) 동일 서버 상위 심각도 발생 중 하위 음소거
NOISE_INHIBITION_WINDOW_SECONDS=300       # (E2) 상위 심각도 활성 간주 창
NOISE_STORM_GROUPING_ENABLED=false        # (E2) 스톰 그룹핑 on/off (동일 서버 다발 시 대표 외 억제)
NOISE_STORM_WINDOW_SECONDS=60             # (E2) 스톰 사건창(초)
NOISE_STORM_THRESHOLD=5                   # (E2) 창 내 이 수 초과 시 스톰
NOISE_SEV3_REPEAT_INTERVAL_SECONDS=14400  # (§6.1) 심각도3 재통보 간격(기본=공통 4h, 운영서 단축 가능)
# ── E3 (자리예약, 미구현) ──
NOISE_BUSINESS_HOURS_CSV=
NOISE_META_ALERT_SUPPRESS_RATIO=0.9
NOISE_ENABLE_AI_SEVERITY_BOOST=false
NOISE_AI_SEVERITY_ESCALATE_ONLY=true
NOISE_ENABLE_LLM_ACTIONABILITY=false

# NOTE: DB 연결 문자열은 MCP 서버 VM에서 관리합니다.
# MCP 서버 설정: mcp_server/config.toml + mcp_server/.env
