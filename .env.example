# ============================================================
# 인프라 데이터 조회 에이전트 — 환경변수 설정
# ============================================================
# 이 파일을 .env로 복사하여 실제 값으로 수정하세요.
#   cp .env.example .env
#
# pydantic-settings 규칙:
#   - list[str] 필드는 반드시 JSON 배열 형식 (예: ["a","b"])
#   - bool 필드는 true / false (소문자)
#   - 값 뒤 인라인 주석 금지 (KEY=v  # 주석 → 주석이 값에 포함되어 파싱 에러)
#
# 웹UI 편집: 운영자 대시보드(/admin) "환경변수 설정" 탭에서 이 파일의 모든 옵션을
#   조회·수정할 수 있다(타입별 위젯·형식 검증·백업 포함). 시크릿(.encenv 관리 키)은
#   읽기 전용이며, 대부분의 설정은 저장 후 서버 재시작이 필요하다.
#   ※ 이 파일의 키 직전 주석 블록이 웹UI 도움말로 그대로 노출된다.
#     주석 처리된 선택 키(# KEY=값)도 같다. .encenv 관리 키의 도움말은 .encenv.example에서 읽는다.
#
# 고급(C등급 — 기본값을 그대로 쓰는 내부 설정)은 # KEY=값 으로 접어 두었다. 적힌 값이 코드 기본값과
#   같으므로 그대로 두면 된다. 바꿀 때만 주석을 풀어 값을 고친다(웹UI는 「고급 설정 표시」로 본다).
# ============================================================

# === LLM 설정 ===
# provider: ollama | fabrix | gemini | mlx (mlx는 Apple Silicon 로컬 테스트 전용)
LLM_PROVIDER=ollama
# 오픈소스 LLM 모델명 (예: llama3.1:8b, llama3.1:70b, gemma2:9b, gemma3:12b, qwen2.5:14b, mistral:7b)
LLM_MODEL=llama3.1:8b
# Ollama 서버 주소
LLM_OLLAMA_BASE_URL=http://localhost:11434
# Ollama 요청 타임아웃 (초) — 모델/프롬프트 복잡도에 따라 조정
LLM_OLLAMA_TIMEOUT=180
# Ollama Gateway API 키 → .encenv에서 관리 (LLM_API_KEY)
# 정식 키(시크릿)는 아래 — .encenv의 LLM_API_KEY와 한쪽만 설정
# LLM_OLLAMA_API_KEY=

# MLX 설정 (LLM_PROVIDER=mlx 시 — Apple Silicon 로컬 테스트 전용, plans/100)
# 앱 밖에 mlx_lm.server를 127.0.0.1로 띄우고 OpenAI 호환 /v1로 붙는다. 설치·기동 명령은 docs/03_setup_guide.md MLX 절.
# 운영 기준선으로 인용하지 않는다(워커가 FabriX가 아니다). 과금 없음 — 승인 게이트 비대상
# MLX 서버 /v1 주소. 서버가 무인증·CORS *이므로 127.0.0.1 바인딩을 유지한다
LLM_MLX_BASE_URL=http://127.0.0.1:8080/v1
# 서버 --model과 같은 모델 ID. 비어있으면 default_model을 보내 서버 --model로 매핑하지만
# 응답·산출물에 실제 모델명이 남지 않으므로 명시를 권장한다
# 32GB 맥북 권장은 아래 9B다(5.6GB · 생성 약 47토큰/초). Qwen3.8-27B-4bit(16.1GB)는 품질이 낫지만
# 2026-09-17 M1 Max 32GB 파이프라인 실행에서 Metal 메모리 부족·시스템 강제 종료가 나 쓰지 않는다(docs/03_setup_guide.md MLX 절)
LLM_MLX_MODEL=mlx-community/Qwen3.5-9B-OptiQ-4bit
# 응답 최대 생성 토큰. 서버 기본값(512)에서 응답이 잘리므로 항상 보낸다. ORCHESTRATOR_PROVIDER=mlx도 이 값을 쓴다
LLM_MLX_MAX_TOKENS=4096
# 요청 타임아웃(초). 스트리밍 청크 대기 상한도 이 값을 따른다(prefill이 끝나야 첫 청크가 온다).
# 콜드 prefill 실측 9B 초당 약 350토큰 · 27B 초당 약 107토큰이라 긴 프롬프트 첫 요청은 수 분 걸린다(27B는 900 권장)
LLM_MLX_TIMEOUT=600
# 추론(thinking) 모드. false 권장 — true면 생성 예산을 추론에 써서 응답 본문이 빌 수 있다
LLM_MLX_ENABLE_THINKING=false

# Gemini 설정 (LLM_PROVIDER=gemini 시)
# API 키는 .encenv 파일에서 관리 (LLM_GEMINI_API_KEY)
# Gemini 모델명 (비어있으면 LLM_MODEL 사용 — 기본값 빈 값)
# 권장: gemini-2.0-flash (안정), gemini-3.1-pro (최신)
# LLM_GEMINI_MODEL=gemini-2.0-flash
# FabriX 설정 (LLM_PROVIDER=fabrix 시)
LLM_FABRIX_BASE_URL=
# FabriX API 키 / 클라이언트 키 → .encenv에서 관리 (FABRIX_API_KEY, FABRIX_CLIENT_KEY)
# FabriX 모델명 (비어있으면 LLM_MODEL 사용)
LLM_FABRIX_CHAT_MODEL=
# FabriX 하이퍼파라미터 기본 프로파일 — SQL 생성 등 중간 호출에 적용. JSON 객체 형식
# (예: {"temperature": 0.0}). 비어있으면 llmConfig 미전송 = FabriX 서버 기본값
LLM_FABRIX_LLM_CONFIG=
# 최종 사용자 응답 합성 전용 프로파일 (예: {"temperature": 0.5, "top_k": 40, "top_p": 0.9}).
# 비어있으면 기본 프로파일로 폴백
LLM_FABRIX_ANSWER_LLM_CONFIG=
# FabriX 호출 1건의 벽시계 총상한(초, D-198). 클라이언트 read timeout은 하트비트(STATUS/SYNC)가
# 계속 오면 무기한 대기를 막지 못한다(2026-09-07 실측) — 총상한이 벽시계 기준으로 끊는다
LLM_FABRIX_TOTAL_TIMEOUT=300

# === DB 연결 ===
# db_backend: dbhub (MCP 서버 경유) | direct (PostgreSQL 직접 연결)
DB_BACKEND=direct
# direct 모드 시 PostgreSQL 연결 문자열 (기본값 빈 값 — 로컬 도커 개발 예시는 아래)
# DB_CONNECTION_STRING=postgresql://infra_user:infra_pass_2024@localhost:5433/infra_db

# === MCP 서버 (DBHub) 설정 (DB_BACKEND=dbhub 시) ===
# 관측 데이터를 읽는 MCP 서버 주소(SSE). DB 레벨 제한(타임아웃·최대 행수)은 MCP 서버 쪽 설정이다
DBHUB_SERVER_URL=http://localhost:9099/sse
# ※ 반드시 mcp_server/config.toml의 [[sources]] name 값과 정확히 일치해야 함
# ※ 불일치 시 "알 수 없는 소스" 에러 발생 (기본값 빈 값)
# DBHUB_SOURCE_NAME=infra_db
# MCP 호출 전체 대기시간 (초)
DBHUB_MCP_CALL_TIMEOUT=60
# 전송 인증 Bearer 토큰(시크릿) — mcp_server의 MCP_BEARER_TOKEN과 일치시킬 것. 비면 무헤더.
# ※ .encenv가 아니라 여기(.env)에 둔다 — DBHubConfig는 .env만 읽는다(src/config.py env_file 실측)
# DBHUB_BEARER_TOKEN=

# === 클라이언트 쿼리 정책 ===
# SQL 생성 실패 시 최대 재시도 횟수
# QUERY_MAX_RETRY_COUNT=3
# SQL 생성 시 기본 LIMIT 절 값
QUERY_DEFAULT_LIMIT=1000
# 데이터 충분성 검사: hint/synonym 매핑의 최소 매칭 비율 (0.0~1.0)
QUERY_SUFFICIENCY_REQUIRED_THRESHOLD=0.7
# 데이터 충분성 검사: LLM 추론 매핑의 최소 매칭 비율 (0.0~1.0)
# QUERY_SUFFICIENCY_OPTIONAL_THRESHOLD=0.5
# 모호한 사용자 의사 표현(유사어 등록·SQL 실행 승인)의 LLM 분류 (Plan 67 R3-(ii), 기본 OFF).
# OFF에서도 결정적 판정은 동작하고 확정 불가 입력은 재질의·거부(fail-closed) 처리 —
# ON은 그 확정 불가분만 LLM 1콜로 회복한다(과금 D-127 유의)
QUERY_INTENT_LLM_ASSIST=false
# 폼필 확인 이력(D-151) TTL(일) — sliding(적용 시 연장). 0이면 기능 OFF
QUERY_FORM_MEMORY_TTL_DAYS=7

# === 보안 ===
# 마스킹 대상 컬럼명 목록 (JSON 배열 형식 필수 — 아래가 코드 기본값 전체)
SECURITY_SENSITIVE_COLUMNS=["password","passwd","pwd","secret","secret_key","token","access_token","refresh_token","api_key","apikey","private_key","priv_key","credential","credentials","ssn","social_security","credit_card","card_number","pin","pin_code","auth","authorization"]
# 마스킹 치환 문자열
SECURITY_MASK_PATTERN=***MASKED***
# 부분 마스킹 대상 컬럼 (JSON 배열 형식, 예: ["email","phone"])
# SECURITY_PARTIAL_MASK_COLUMNS=[]
# IP 주소 마스킹 여부
SECURITY_MASK_IP=false
# 이메일 주소 마스킹 여부
SECURITY_MASK_EMAIL=false

# --- FabriX 개인정보(PII) 필터 진단·예방 (src/security/pii_filter.py) ---
# 판정 규칙 근거: docs/pii_filtering_rules.md / 규칙 변경은 pii_filter.PII_RULES 에서.
# FabriX가 프롬프트/응답을 PII로 차단할 때 유형·텍스트·filter_log_id 경고 1건 로깅 (차단 시에만 발화)
SECURITY_PII_FILTER_LOG_ENABLED=true
# 위 로그의 감지 문자열을 원문 그대로 남길지 (기본 false=마스킹). 오탐(타임스탬프 등) 판정 시에만 한시적 true
SECURITY_PII_FILTER_LOG_UNMASK=false
# 프롬프트 주입 전 샘플 데이터(라이브 DB 행)의 PII를 형식보존 마스킹 스크럽 (기본 true=차단 예방)
SECURITY_PII_SCRUB_SAMPLES=true
# 차단 시 전송 프롬프트·응답 전문을 logs/pii_block/ 에 무마스킹 덤프 (기본 true, D-155 후속1)
# 트리거 특정: python scripts/pii_probe.py <덤프파일> (이등분 재전송, 최신 100개 보존)
SECURITY_PII_BLOCK_DUMP_ENABLED=true
# 날짜·타임스탬프 무해화(구분자 점 치환) 스크럽 (기본 false, D-155 후속3).
# 계좌번호(851) 차단인데 계좌 유사 문자열이 없으면 날짜형 광폭 매칭 의심 — 진단 로그의
# "[의심]" 표기로 확정 후 true로 전환 (2026-06-17 02:30:45 → 2026.06.17.02:30:45)
SECURITY_PII_SCRUB_SUSPECT_DATES=false

# === API 서버 ===
# API 서버 바인딩 주소
API_HOST=0.0.0.0
# API 서버 포트
API_PORT=8000
# CORS 허용 오리진 (JSON 배열 형식, 운영: ["https://your-domain.com"])
API_CORS_ORIGINS=["*"]
# 일반 질의 타임아웃 (초) — 그래프 전체 실행 제한. 관리자 설정 화면에서도 바꿀 수 있다(설정 리로드로 반영)
API_QUERY_TIMEOUT=120
# 파일 업로드 질의 타임아웃 (초) — 엑셀/Word 템플릿 처리 시 LLM 호출이 많으므로 넉넉히
API_FILE_QUERY_TIMEOUT=120
# SSE 진행 신호(progress·heartbeat) — 기본 on(plans/89 · D-204, plans/80 §5.4-③ 명시 예외)
API_SSE_PROGRESS_EVENTS=true
# 무이벤트 구간 heartbeat 주기(초). 0이면 하트비트 없음. 무이벤트 상한(API_QUERY_TIMEOUT)은 불변
API_SSE_HEARTBEAT_INTERVAL_SEC=5
# 존 동시 조회에서 먼저 끝난 존 그룹 결과의 행 미리보기 행 수(마스킹 후 전송). 0이면 건수·소요 알림만 — plans/82 v7 · D-249
API_SSE_GROUP_PREVIEW_ROWS=10

# === 운영자 인증 ===
# 기본값 빈 값 (D-071 — 기본 크레덴셜 제거. 운영 모드에서 미설정 시 기동 거부)
# ADMIN_USERNAME=admin
# 운영자 비밀번호 / JWT 시크릿 → .encenv에서 관리 (ADMIN_PASSWORD, ADMIN_JWT_SECRET, AUTH_JWT_SECRET)
# JWT 토큰 만료 시간 (시간)
ADMIN_JWT_EXPIRE_HOURS=24

# === 사용자 인증 (Plan 39/59) ===
# 운영 모드. true면 로그인 필수 + 운영자 크레덴셜/시크릿 미설정 시 기동 거부
AUTH_ENABLED=false
# 사용자 인증 DB 접속 문자열 (비밀번호 포함 가능 — 화면에서는 마스킹된다)
AUTH_AUTH_DB_URL=
# 사용자 JWT 시크릿 → .encenv에서 관리 (AUTH_JWT_SECRET — 운영자 시크릿과 분리, D-070)
# 사용자 JWT 토큰 만료 시간 (시간)
AUTH_JWT_EXPIRE_HOURS=8
# 로그인 실패 잠금: 계정을 잠그기까지 허용하는 최대 실패 횟수
AUTH_MAX_LOGIN_ATTEMPTS=5
# 로그인 실패 잠금: 잠긴 계정이 자동으로 풀리기까지의 시간(분)
AUTH_LOCKOUT_MINUTES=30
# 비밀번호 최소 길이
AUTH_PASSWORD_MIN_LENGTH=8
# 신규 사용자 기본 허용 DB ID (쉼표 구분 — 현재 미소비 자리예약)
AUTH_DEFAULT_ALLOWED_DB_IDS=

# === 감사 로그 (Plan 40/59-a) ===
# 감사 로그 보관 일수. 이 기간이 지난 DB 로그는 기동 시 1회 + 하루 1회 자동 삭제(0 이하면 비활성)
# AUDIT_RETENTION_DAYS=90
# 감사 기록 저장 경로별 on/off — JSONL 파일
AUDIT_JSONL_ENABLED=true
# 감사 기록 저장 경로별 on/off — DB(PostgreSQL). 운영자 화면의 감사 로그 조회는 이쪽을 읽는다
AUDIT_DB_ENABLED=true
# 민감 테이블 목록 (JSON 배열 형식 — 현재 미소비 자리예약)
# AUDIT_SENSITIVE_TABLES=[]
# 로그인 실패 경보 임계(회)
AUDIT_ALERT_ON_FAILED_LOGIN=5
# 대량 결과 경보 임계(행) — 한 번에 이 행 수 이상 조회하면 경보를 남긴다
AUDIT_ALERT_ON_LARGE_RESULT=5000
# 심야 경보 시간대 시작 시각(시, 0~23 — 현재 미소비 자리예약)
# AUDIT_NIGHT_ALERT_START=2
# 심야 경보 시간대 종료 시각(시, 0~23 — 현재 미소비 자리예약)
# AUDIT_NIGHT_ALERT_END=6

# === 체크포인트 (대화 상태 저장) ===
# checkpoint_backend: sqlite | postgres
CHECKPOINT_BACKEND=sqlite
# SQLite 파일 경로 또는 :memory:
CHECKPOINT_DB_URL=checkpoints.db

# === 로그 ===
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# === 실행 로그·트레이스 (D-140/D-141) ===
# 실행된 SQL 전량을 logs/sql/YYYY-MM-DD.sql에 기록
OBS_SQL_LOG_ENABLED=true
# SQL 로그 보존 일수 (0 이하면 자동 정리 비활성)
# OBS_SQL_LOG_RETENTION_DAYS=30
# 정상 응답을 내지 못한 요청의 노드별 단계를 logs/trace/에 덤프 (정상 요청은 파일 미생성)
OBS_TRACE_ENABLED=true
# 트레이스 보존 일수 (0 이하면 자동 정리 비활성)
# OBS_TRACE_RETENTION_DAYS=14
# 요청당 트레이스 링버퍼 단계 상한 (초과 시 가장 오래된 단계부터 밀어냄)
OBS_TRACE_MAX_STEPS=200
# ── 본체 자기 관측 /metrics — plans/92 O4 (기본 off = 라우트 부재·요청 계측 없음 · 재시작 필요) ──
# Prometheus 노출 형식 GET /api/v1/metrics(OpenMetrics 1.0 / text 0.0.4 Accept 협상)와 HTTP 요청 계측 on/off. JSON 운영 지표 /api/v1/alarm/metrics와 다른 주소
# OBS_METRICS_ENDPOINT_ENABLED=false
# 지표 주소 /api/v1/metrics의 정적 Bearer 토큰 — 수집기 authorization.credentials와 같은 값. 켰는데 비어 있으면 503으로 거부(무인증 노출 금지)
# OBS_METRICS_BEARER_TOKEN=

# === Redis ===
# Redis 서버 주소
REDIS_HOST=localhost
# Redis 포트
REDIS_PORT=6379
# Redis 논리 DB 번호
REDIS_DB=0
# Redis 비밀번호 → .encenv에서 관리 (REDIS_PASSWORD)
# TLS/SSL 사용 여부
REDIS_SSL=false
# Redis 소켓 타임아웃 (초)
REDIS_SOCKET_TIMEOUT=5

# === 스키마 캐시 ===
# 캐시 백엔드: redis | file
SCHEMA_CACHE_BACKEND=redis
# 파일 캐시 디렉토리 (SCHEMA_CACHE_BACKEND=file 시)
# SCHEMA_CACHE_CACHE_DIR=.cache/schema
# 스키마 캐시 활성화 여부
SCHEMA_CACHE_ENABLED=true
# 스키마 fingerprint 재검증 주기(초)
SCHEMA_CACHE_FINGERPRINT_TTL_SECONDS=1800
# 관리자 DB 구조 탭이 컬럼 설명·유사어 초안을 만들 때 동시에 띄우는 LLM 호출 수 상한(질의 경로 무관)
SCHEMA_CACHE_ADMIN_LLM_CONCURRENCY=2
# 관리자 DB 구조 분석을 FK 연결 묶음으로 나눌 때 한 번의 분석에 넣는 테이블 수 상한(질의 경로 무관)
SCHEMA_CACHE_STRUCTURE_GROUP_MAX_TABLES=40

# === 동의어 매칭 보강 (Plan 61 트랙 B / D-075) ===
# 전 기능 기본 OFF — 활성 전에는 기존 정확일치 경로가 바이트 단위 무변경(회귀 0).
# 주의: .env 계열 파일에는 인라인 주석 금지(값 뒤 # 금지). 설명은 반드시 별도 줄.
# E5-1 유연 매칭(자모 분해·편집거리·부분어) on/off
# 활성화 예: SYNONYM_FUZZY_MATCH=true — 배선 지점은 field_mapper(폼필 헤더 매핑)와
#   schema_analyzer allowed_tables 보완. 텍스트 질의의 EAV 매핑은 LLM 프롬프트 의존이라 무관.
SYNONYM_FUZZY_MATCH=false
# E5-2 실측 값 검색(distinct resource_type·EAV NAME 인덱싱·검색) on/off
SYNONYM_VALUE_RETRIEVAL=false
# E5-4 임베딩 의미 검색(D-084): 정확→퍼지(E5-1)→임베딩 계단의 마지막 단. ON이어도 아래
# 백엔드 요건 미충족·의존성(pip install ".[semantic]") 미반입이면 경고 1회 후 무매칭
SYNONYM_SEMANTIC_MATCH=false
# 임베딩 백엔드: local(sentence-transformers 인프로세스 CPU 상주) | vllm(OpenAI 호환 /v1/embeddings)
SYNONYM_SEMANTIC_BACKEND=local
# local 백엔드: 오프라인 반입한 다국어 모델 디렉토리 경로 (빈 값 = 미가용)
# SYNONYM_SEMANTIC_MODEL_PATH=
# vllm 백엔드: vLLM /v1 엔드포인트 (아래 모델명과 하나라도 비면 미가용)
SYNONYM_SEMANTIC_VLLM_BASE_URL=
# vllm 백엔드: 서빙 임베딩 모델명 (위 엔드포인트와 하나라도 비면 미가용)
SYNONYM_SEMANTIC_VLLM_MODEL=
# vllm 백엔드 SSL 인증서 검증 (사설 인증서 vLLM 대응 시 false — D-060 계열)
SYNONYM_SEMANTIC_VLLM_VERIFY_SSL=true
# 임베딩 코사인 확정 임계 (미만은 확정 매핑 아닌 후보 제시/LLM 위임)
SYNONYM_SEMANTIC_CONFIDENCE_MIN=0.65
# 퍼지/의미 매칭 확정 신뢰도 임계(이하는 확정 매핑 아닌 후보 제시)
SYNONYM_MATCH_CONFIDENCE_MIN=0.85
# E5-3 유사어 보완 테이블 상한(D-051, 기본 15). 낮추면 토큰↓·리콜↓
SYNONYM_MAX_SYNONYM_SUPPLEMENT_TABLES=15
# E5-3 사전 위생·거버넌스 마스터 스위치(유사어 메타 추적·충돌 우선순위). 기본 OFF=저장 무변경
SYNONYM_GOVERNANCE=false
# 장기 미사용 감쇠/정리 임계(일). governance ON + 명시적 prune 호출 시에만 적용
# SYNONYM_DECAY_DAYS=180

# === 시맨틱 모델 결정적 SQL 조합 (Plan 61 트랙 C / D-076) ===
# 전 기능 기본 OFF — 활성 전에는 기존 SQL 생성 경로가 바이트 단위 무변경(회귀 0).
# 주의: .env 계열 파일에는 인라인 주석 금지(값 뒤 # 금지). 설명은 반드시 별도 줄.
# E6 결정적 조합 경로 전체 스위치(커버리지 내 정형 질의는 시맨틱 모델로 결정적 컴파일)
# 활성화 예: TEXT2SQL_SEMANTIC_COMPOSE=true — db_id별 시맨틱 모델 파일
#   config/semantic_models/<db_id>.yaml 이 있는 DB에서만 컴파일 시도(없으면 기존 경로).
#   커버리지 밖(서버명 필터·LOB 속성·80% 임계·동적 기간 등)은 SEMANTIC_FALLBACK으로 라우팅.
TEXT2SQL_SEMANTIC_COMPOSE=false
# 커버리지 밖 라우팅(3단 폴백). 트랙 A 착수로 기본값 candidate_then_human 전환.
# 값: candidate_then_human(트랙 A→저신뢰 시 사람검토) | llm(과도기 자유생성) | human(항상 검토).
# multi_candidate OFF이면 candidate_then_human/human은 llm으로 우아하게 강등(회귀 0).
TEXT2SQL_SEMANTIC_FALLBACK=candidate_then_human
# 3단 폴백 2차 게이트 — 트랙 A 선택 신뢰도 임계(미달 시 사람검토 강등). 0.0=전패 시에만 강등
TEXT2SQL_FALLBACK_CONFIDENCE_MIN=0.0

# === 다중 후보 생성·선택 (Plan 61 트랙 A / D-073·D-074) ===
# 전 기능 기본 OFF — 활성 전에는 기존 단일 생성 경로가 바이트 단위 무변경(회귀 0).
# 주의: .env 계열 파일에는 인라인 주석 금지(값 뒤 # 금지). 설명은 반드시 별도 줄.
# E2/E4 다중 후보 경로 전체 스위치(N개 후보 생성 → 실행기반 선택)
TEXT2SQL_MULTI_CANDIDATE=false
# 후보 수 N(비용 무제한 §9-4 — E1 하네스로 이득 곡선 측정 후 상향)
TEXT2SQL_CANDIDATE_COUNT=3
# 다양화 방식: multi_prompt(현행/분할정복/실행계획 CoT) | temperature(재샘플 보조)
TEXT2SQL_CANDIDATE_STRATEGIES=multi_prompt
# E3 복잡도 게이트: true면 복잡 질의만 다중 후보(단순 질의는 단일 — 품질 목적, 비용 컷 아님)
TEXT2SQL_COMPLEXITY_GATE=false
# E4 선택 전략: hybrid(결과일관성 1차 + LLM 쌍대비교 병용) | consistency | llm
TEXT2SQL_SELECTION=hybrid

# === Text2SQL 세부 옵트인 (Plan 63/67/69 · D-090/D-128/D-131/D-133/D-159) ===
# 무선언(프로필 없는) DB의 범용 기간 해석 힌트 주입 (Plan 63 P3 / D-090). 폴스타 등
# 프로필 보유 DB는 선언 우선으로 동작 불변
TEXT2SQL_GENERIC_LLM_MAPPING=false
# 질의 이력 검색 기반 few-shot 동적 선택 (Plan 67 N2 / D-133). ON이면 고정 few-shot 대신
# 검증된 질의-SQL 이력에서 유사도 상위 예시를 주입 (기본 OFF = 프롬프트 바이트 무변경)
TEXT2SQL_QUERY_HISTORY_FEWSHOT=false
# 주입할 상위 예시 수(토큰 증가 상한)
TEXT2SQL_QUERY_HISTORY_TOP_K=3
# 어휘·퍼지 유사도 확정 임계(미만은 고정 few-shot 유지)
TEXT2SQL_QUERY_HISTORY_MIN_SCORE=0.35
# 단계적 컬럼 도출 루프 (Plan 67 S2 / D-128). ON이면 NL→SMQ를 1방 선택 대신 도구 기반
# 다회 탐색으로 도출 (커버리지 판정·SQL 조립은 결정적 유지)
TEXT2SQL_STEPWISE_DERIVATION=false
# tool-calling 라운드 상한
TEXT2SQL_STEPWISE_MAX_ROUNDS=6
# 누적 tool 호출 상한(한 라운드에서 여러 번 부를 수 있어 라운드 상한과 별개)
TEXT2SQL_STEPWISE_MAX_TOOL_CALLS=24
# 루프 전체 타임아웃(초)
TEXT2SQL_STEPWISE_TIMEOUT_SECONDS=60.0
# 상위어 모호성 처리 (Plan 67 N4 / D-133): 상위어만 언급한 질의에서 형제 하위어를 결정적으로
# 채운다(전체 제시 — 조용한 오답 방지)
TEXT2SQL_HYPERNYM_AMBIGUITY=false
# 폴스타 프롬프트 잔여 블록 정본 렌더 (Plan 67 R1 / D-131). OFF = 프롬프트 sha256 무변경
TEXT2SQL_PROMPT_KNOWLEDGE_RENDER=false
# 멀티 DB 경로 관련 테이블 게이트 (D-159 공동존 토큰 폭증 근본수정). 기본 ON — OFF는
# 폐쇄망 P1 장애(cm_gp 136,707tok > FabriX 95,232 한도) 재현 — 비상 복귀용 kill-switch
TEXT2SQL_MULTI_RELEVANT_GATE=true
# 데이터 평면 프롬프트 토큰 예산 (D-159). 초과 시 재료(유사어·설명)→샘플 순 절단, 그래도
# 넘으면 호출 없이 명시 실패(침묵 강등 금지). 0 이하면 가드 비활성
TEXT2SQL_PROMPT_TOKEN_BUDGET=90000

# === 활성 알람 결정적 조립 (기본 OFF 옵트인) ===
# true: "활성 + 심각도 + 목록/건수" 알람 질의의 SQL을 코드가 직접 조립한다(LLM 우회,
# 미인식 질의는 현행 LLM 폴백). 3존 동일 별칭이라 병합 CSV 칼럼 분리도 해소된다.
# 발동은 "[알람조립]" 로그로 확인한다.
TEXT2SQL_ALARM_DETERMINISTIC=false

# === 멀티 DB 경로 검증 강화 (Plan 69 P4-3, 기본 OFF 옵트인) ===
# true: 멀티 DB 경로가 간이 검증 대신 단일 경로와 같은 full validator(테이블·컬럼 존재,
# EAV 금지 조인, 폴스타 어댑터 가드 포함)를 소비한다. 같은 SQL이 단일 조회에선 차단되고
# 멀티 조회에선 통과하던 방어 비대칭의 해소. 거부는 "[멀티검증강화] 거부" 로그로 계측된다.
TEXT2SQL_MULTI_FULL_VALIDATION=false

# === 단일/멀티 경로 대칭 (Plan 69 P3-2 · plans/88 G-3) ===
# true: 멀티 DB 경로에도 단일 경로의 주입(어댑터 템플릿·스키마 한정 규칙·값 인덱스·선행 스코프 결정적
# 전달 D-099)을 넣는다 — 양 경로 프롬프트 바이트가 바뀐다. 단일 DB 운영(ACTIVE_DB_IDS 1개)에서는 무영향.
# 2026-09-10 확정: false 명시. on 전환은 plans/82 2차(존 편입) 착수 조건 — 그때 plans/88 §11.3 ③ 3-c와 함께.
TEXT2SQL_PATH_PARITY=false

# === 0건 원인 진단 (Plan 82 Wave 8 / D-176 후속1) ===
# true: 결과가 0건일 때만 조건 누적 COUNT 프로브를 돌려 **어느 조건에서 끊겼는지**(MFS/XSS)를
# 응답에 낸다. 결과가 있으면 프로브 호출 0회이고, false면 0건 응답 문구가 바이트 단위로 무변경.
TEXT2SQL_EMPTY_DIAGNOSIS_ENABLED=true
# 프로브 상한 K. 초과분은 측정하지 않고 절단 사실을 응답에 노출한다.
TEXT2SQL_EMPTY_DIAGNOSIS_MAX_PROBES=5

# === 급증(기간 대비 상승) 조건 조립 (Plan 82 Wave 9 / D-176 후속2) ===
# true: "파일시스템 사용률이 갑자기 80% 이상으로 상승" 류를 LLM 자유 생성 대신
# 코드가 비교 SQL로 조립한다(엔진 방언 분기 · 파일시스템 축 한정).
TEXT2SQL_SPIKE_CONDITION_ENABLED=true
# 질의에 수치가 없을 때 쓰는 기본 차분 임계(%p). 선언 파일 config/change_terms.yaml이 정본이며
# 이 값은 운영 override다. 사용 시 값이 응답에 노출된다.
TEXT2SQL_SPIKE_DEFAULT_DELTA_PP=20.0

# === 복합 질의 호스트 조사 (Plan 78 §6.2 — 전부 기본 off/보수값) ===
# W1: 선행 결과 → 조사 대상 전달 (채팅·이벤트 공통)
COMPOSITE_PRIOR_TARGETS_ENABLED=false
# W1-3: 해석 3단(LLM 컬럼 지목). off면 1·2단만 — 비용·비결정성 최소화
COMPOSITE_TARGET_COLUMN_LLM_ENABLED=false
# fan-out 상한. 초과분은 절단하고 절단 사실을 결과에 싣는다
COMPOSITE_MAX_TARGETS=10
# W2: 동시 조사 수
COMPOSITE_FANOUT_CONCURRENCY=3
# W2: 대상(호스트) 1대 조사 타임아웃(초). 넘으면 그 대상만 실패로 처리하고 나머지는 계속한다
COMPOSITE_TARGET_TIMEOUT_SECONDS=10.0
# W2: fan-out 전체 타임아웃(초). 넘으면 그때까지의 결과로 답한다
COMPOSITE_TOTAL_TIMEOUT_SECONDS=45.0
# W2-8: 단기 조사 캐시 TTL(초). 기본 0=끔 — 실시간 조회가 조용히 캐시되지 않도록 명시로만 켠다
COMPOSITE_SNAPSHOT_TTL_SECONDS=0
# W3: 조사 경로 진입
COMPOSITE_INVESTIGATION_ENABLED=false
# W6: 조사 감사. 기본 on (감사는 끄는 것이 예외)
COMPOSITE_AUDIT_ENABLED=true

# === 호스트 가용성 사전 판정 (Plan 81 / D-175 — 기본 on, G-1 사용자 확정 2026-08-28) ===
# off는 "꺼진 서버에 프로세스 0건을 정상 결과로 서술"하는 현행 결함 재현 — 비상 복귀용
COMPOSITE_AVAILABILITY_PRECHECK_ENABLED=true
# unavailable 판정 시 수집 생략 여부. false면 문구만 병기하고 조회 진행(관찰 모드)
COMPOSITE_AVAILABILITY_BLOCK_ON_UNAVAILABLE=true
# Tier 2 신선도 신호 (measurement 왕복 +1 — 기본 off, "추가 왕복 0" 원칙)
COMPOSITE_AVAILABILITY_STALENESS_ENABLED=false

# === 존 순회 대상 소재 탐색 (Plan 82 Wave 5 / D-176 후속3) ===
# true: 대상 존이 미해소일 때("abd00 서버의 프로세스" 등) 인가된 폴스타 존을 순회해
# 서버 소재를 찾는다. 존당 SELECT 1회·LLM 0회(3존 약 150ms). false면 종전처럼
# "위치를 지정해 주세요" 안내로 끝난다.
COMPOSITE_HOST_DISCOVERY_ENABLED=true
# 첫 히트에서 순회를 멈출지. 기본 false = 전수 순회 — 동명 호스트가 여러 존에 있으면
# 첫 히트로 끊는 순간 그 사실이 은폐된다. 응답 약 100ms를 아끼려 할 때만 켠다.
COMPOSITE_DISCOVERY_EARLY_EXIT=false
# 탐색 결과 캐시 TTL(초). 0건과 조회 실패는 캐시하지 않는다(코드 가드) —
# 캐시하면 방금 등록한 서버가 TTL 동안 "없는 서버"가 된다.
COMPOSITE_DISCOVERY_CACHE_TTL_SECONDS=60.0

# === 범위 사전 선택 역질문 (Plan 82 Wave 6.5 / D-176 후속4) ===
# true: 전량 조회가 실행 그룹 2개 이상(은행존·공동존)에 걸칠 때 범위를 좁힐지 묻는다.
# "전체 조회"가 항상 첫 선택지·기본값이라 답하지 않아도 진행된다.
# 시간 임계는 두지 않는다(사용자 확정) — 대신 발동률을 관측해 습관화를 통제한다.
COMPOSITE_SCOPE_SELECT_ENABLED=true

# === 복합 질의 순차 의존 계약 (plans/88 · D-203) — 7종 전부 코드 기본값 on ===
# ★ 7종 전부 코드 기본값이 true다(2026-09-10 사용자 확정 — .env는 git 미추적이라 배포마다 유실될 수 있어 코드로 고정). 아래는 명시일 뿐이다.
# ※ 현행 동작(off)을 유지해야 하면 이 블록의 값을 false로 바꿔 명시할 것 — 신규 배포는 값을 적지 않아도 켜진다.
# 1차 3종: LLM 호출 수를 바꾸지 않는 결정적 판정. 현행(off) 동작 자체가 결함이라 운영에서 on
# (선행 조회가 0건이면 후속이 스코프 없이 **전체 서버**를 조회하는 침묵 오류 — plans/88 §3 R-1).
# 선행 결과 게이트: input_from 선행이 실패·0건·식별 컬럼 부재면 후속을 실행하지 않고 사유를 응답에 남긴다.
COMPOSITE_SEQUENTIAL_GATE_ENABLED=true
# 사후 대조: 후속 결과에서 선행 스코프 밖 서버 행을 제거하고 미조회 서버를 표기한다.
COMPOSITE_SCOPE_POSTCHECK_ENABLED=true
# DB별 스코프 분할: 선행 행의 _source_db로 후속 멀티 DB 조회의 IN 목록·대상 DB를 나눈다(단일 DB면 무영향).
COMPOSITE_PRIOR_SCOPE_BY_DB_ENABLED=true
# 2차 3종: 2026-09-10 실 실행 11건(plans/88 §11.5) 후 사용자 확정 on — 정상 분해 무개입 · 러너는 강등 기동 전용·HITL on이면 미진입.
# 분해 DAG 결정적 검증 + 위반 시 되먹임 1회(재분해와 예산 공유 = intent_planner LLM 최대 2회).
COMPOSITE_PLAN_DAG_VALIDATION_ENABLED=true
# 순차 표지("…를 찾아 그 서버들의…")가 있는데 단일 task로 분해되면 재분해 1회.
COMPOSITE_SEQUENTIAL_REPLAN_ENABLED=true
# 3단(semantic_router)·4단(legacy) 강등 기동 전용 sequential_runner 2-pass. 운영 1단 기동에서는 실효 없음.
# SQL 승인 플래그(ENABLE_SQL_APPROVAL)가 켜져 있으면 진입하지 않는다.
COMPOSITE_SEQUENTIAL_FALLBACK_TIERS_ENABLED=true
# 1단 선행 스코프 폭(plans/88 R-E · 2026-09-10 확정 (c)): 값 일치 우선 · 없으면 직전 1건. off면 전부 합집합(현행).
# 1단 실 재검증 통과(2026-09-10) → 기본 on. 만료일 2027-03-10(off 분기 삭제 판정).
COMPOSITE_PRIOR_SCOPE_LATEST_ONLY=true

# === 복합 질의 task 프레임 계약 (plans/111 C-3 — 기본 off = 현행 비트 동일) ===
# true면 분해 LLM이 task 질의문을 새로 쓰지 않고 원문 조각(spans)만 고르며, task 질의는 코드가 조각을 원문 순서로 잇는다.
# 조각이 원문(또는 직전 맥락) 밖이거나 원문의 숫자를 덮지 못하면 원문 단일 task로 폴백하고 사유를 남긴다
COMPOSITE_TASK_FRAME_ENABLED=false

# === 실행 경로 (오케스트레이션 사다리) ===
# 아래 세 플래그는 대등한 스위치가 아니라 위에서부터 성립하는 한 단만 확정되는 사다리를 만든다.
# 기준 경로는 3단 semantic_router다(D-225 · 2026-09-17). 1단은 부가 경로(opt-in) · 2단 배선은 기본 off.
# 상위 단이 성립하면 하위 단은 노드조차 등록되지 않는다(빌드 타임 배타) — 3단으로 돌리려면 1·2단 플래그가 off여야 한다.
#   1단 deep_agent (부가 경로)  <- ENABLE_DEEPAGENTS_PACKAGE + 오케스트레이터 가용 + 패키지 조립 성공
#   2단 intent_orchestration    <- ENABLE_INTENT_ORCHESTRATION (미입력 = off)
#   3단 semantic_router (기준)  <- ENABLE_SEMANTIC_ROUTING
#   4단 legacy                  <- 위 셋 모두 불성립
# 확정된 단은 기동 로그 '오케스트레이션 사다리 확정: tier=... degraded_reason=...'로 확인한다.
# 구조·확정 사유·모듈 의존 방향(상위 단이 하위 단 모듈을 재사용)은
# docs/21_orchestration_ladder.md가 단일 출처다. 경로 폐기 전 반드시 읽을 것.

# === 시멘틱 라우팅 (멀티 DB) ===
# tri-state: 미설정(주석 유지)이면 ACTIVE_DB_IDS 등록 여부로 자동 결정된다.
# ⚠ 값을 명시하는 순간 자동 결정이 꺼진다 — false를 그대로 붙여넣으면 멀티 DB 환경에서도
#   사다리 3단이 강제 비활성된다. 고정하려는 경우에만 해제해 명시할 것.
# ENABLE_SEMANTIC_ROUTING=true
# 활성 DB ID 목록 (쉼표 구분, MCP 서버에 등록된 소스명과 일치해야 함)
# ACTIVE_DB_IDS=polestar_b0,polestar_cm_gp,polestar_cm_yd

# 존 그룹 상호배타(D-143 후속3): true면 은행존(b0)과 공동존(gp/yd)을 함께 고를 수 없다(라디오 동작).
# false면 체크박스로 함께 선택할 수 있고, 실행기가 존 그룹으로 나눠 은행존 → 공동존 순차 실행한다(D-206).
# 코드 기본값은 true(옵트인 개방 — plans/82 U1 (a)). b0+gp 조합의 PII 차단 이슈(D-155) 미종결 시 롤백 경로.
# ZONE_GROUP_EXCLUSIVE=false

# === 의도 분해 오케스트레이션 = 사다리 2단 / 트랙 A (Plan 48 / D-037) ===
# 복합 의도를 sub-task로 분해하여 순차/병렬/데이터-의존 실행.
# 미입력(아래 줄 주석 유지)이면 멀티 DB 여부와 무관하게 off다(D-225 · 3단 기준 — 종전 멀티 DB 자동 on 폐지).
# 3단 순차 러너가 이 경로의 부품을 함수로 재사용하므로 off여도 모듈은 쓰인다.
#   - 2단 배선 사용: ENABLE_INTENT_ORCHESTRATION=true
# 구 이름 ENABLE_DEEPAGENT_ORCHESTRATION도 계속 인식한다(하위호환). **2027-02-20 폐기 예정** —
# 두 키를 동시에 두지 말 것: 신 이름이 우선하므로 구 키 수정이 무시된다.
# semantic_routing과 상호 배타 — 둘 다 활성이면 orchestration이 우선한다.
# ENABLE_INTENT_ORCHESTRATION=true
# 결과 기반 재계획 최대 반복 (무한 루프 방지, R-A3/R-11)
MAX_REPLAN=3
# 사다리 3단 계획 루프(plans/103 P2 · plans/111 C-4·C-5) — 복합 질의만 plan→task_run(Send)→join→replan→finalize, 단일 의도는 현행 직결
TIER3_PLAN_LOOP_ENABLED=false

# === deepagents 실제 패키지 — 트랙 B (Plan 49 / D-037) ===
# vLLM 오케스트레이터(tool-calling) + FabriX 워커(실질 응답처리) 분리 도입.
# 명시적 opt-in(기본 false) — vLLM 인프라가 필요하므로 자동 활성화하지 않는다.
# true + vLLM 가용 시 트랙 B, 그 외(false 또는 vLLM 미서빙)는 semantic_router 사용(가용성 분기).
# ENABLE_DEEPAGENTS_PACKAGE=true
# 오케스트레이터 provider: vllm(운영) | gemini(테스트/PoC 전용 — 외부 egress 필요, 폐쇄망 부적합)
# | mlx(Apple Silicon 로컬 테스트 전용 — 과금 없음, 아래 [로컬 모드] 참고)
ORCHESTRATOR_PROVIDER=vllm
# vLLM (OpenAI 호환) 오케스트레이터 — Qwen3.5-9B 서빙 엔드포인트
ORCHESTRATOR_BASE_URL=
# 오케스트레이터(제어 평면) 서빙 모델명 — vLLM에 로딩된 모델명과 정확히 같아야 한다
ORCHESTRATOR_MODEL=Qwen3.5-9B
# vLLM은 보통 API 키 불필요 (필요 시 .encenv에서 ORCHESTRATOR_API_KEY 관리 — .encenv.example 참고)

# 제어 평면 호출 1건 타임아웃(초)
# ORCHESTRATOR_TIMEOUT=120
# 기동 시 오케스트레이터 생존 확인(사다리 1단 성립 판정) 대기 시간(초)
# ORCHESTRATOR_HEALTH_TIMEOUT=3
# 제어 평면 그래프 순회 상한(LangGraph recursion_limit). 도구 호출 단계가 많은 복합 질의에서
# GraphRecursionError가 발생하면 상향한다.
# ORCHESTRATOR_RECURSION_LIMIT=25
# SSL 인증서 검증(D-060). 목적지 vLLM이 443을 listen하되 유효 인증서를 쓰지 않는 폐쇄망이면
# false로 설정하여 health check·tool-calling 요청의 SSL 검증을 건너뛴다(미설정 시 true).
# ORCHESTRATOR_VERIFY_SSL=false
# ── 제어 평면 컨텍스트 예산 (Plan 50 B6 — 모델 교체 시 .env만 조정) ──
# 제어 평면으로 반환하는 도구 결과 1건 요약 상한(토큰) — 이 블록에서 실소비되는 유일한 키
# ORCHESTRATOR_MAX_TOOL_RESULT_TOKENS=2000
# 아래 3개는 현재 미소비 자리예약 (Plan 67 Phase 0 ⑦ 실측 — 배선/삭제 시 카탈로그 동반 갱신)
# ORCHESTRATOR_MAX_INPUT_TOKENS=12000
# ORCHESTRATOR_CONTEXT_BUDGET_RATIO=0.8
# ORCHESTRATOR_MAX_HISTORY_TURNS=6
# 제어 평면 추론 모드 (Plan 50 B7). Qwen 계열은 false(no-think) 권장 — 추론 토큰 한계 압박과
# tool_call JSON 파싱 불안정 회피. 추론이 유리한 큰 모델로 교체 시 true 전환
# ORCHESTRATOR_ENABLE_THINKING=false
#
# [테스트 모드] vLLM 없이 Gemini로 deepagents 파이프라인 검증 (Plan 49 §4.7):
#   ORCHESTRATOR_PROVIDER=gemini
#   ORCHESTRATOR_MODEL=gemini-2.5-pro
#   API 키는 LLM_GEMINI_API_KEY(GOOGLE_API_KEY) 재사용 (또는 ORCHESTRATOR_API_KEY 별도 지정)
#
# [로컬 모드] 과금 없이 맥북(Apple Silicon)에서 1단 검증 (plans/100 — 한 서버·한 모델로 두 평면):
#   LLM_PROVIDER=mlx
#   ORCHESTRATOR_PROVIDER=mlx
#   ORCHESTRATOR_BASE_URL=http://127.0.0.1:8080/v1
#   ORCHESTRATOR_MODEL=mlx-community/Qwen3.5-9B-OptiQ-4bit
#   두 평면의 모델 ID가 다르면 요청마다 서버가 가중치를 재적재한다(수 초). 최대 생성 토큰은 LLM_MLX_MAX_TOKENS를 쓴다

# === 워커 provider 강제 교체 (테스트 전용) ===
# deepagent(트랙 B) 경로 검증 시 데이터 평면 LLM provider를 강제 교체 (ollama|fabrix|gemini).
# 미설정 = 운영 그대로(LLM_PROVIDER). 오케스트레이터는 ORCHESTRATOR_PROVIDER로 별도 지정
# WORKER_PROVIDER_OVERRIDE=gemini

# === 라우터 2단 분리·신뢰도 (Plan 79 트랙 B·C — 전부 기본값 = 현행 동작) ===
# intent/DB 2단 분리. ⚠ M-1~M-4 미검증 — S-1·S-2 실측 이후에만 켠다(SPEC-router-two-stage)
ROUTER_TWO_STAGE_ENABLED=false
# 의도 신뢰도 소스: self_report | logprob (FabriX KBGenAI는 logprobs 원천 불가 — 현재 자기보고만)
ROUTER_CONFIDENCE_SOURCE=self_report
# 1단계 저신뢰 시 2단계 호출 없이 조기 차단 (기본 off — 근거 없는 임계 신설 방지)
ROUTER_EARLY_STOP_ENABLED=false
# 조기 차단 임계 (미설정이면 차단하지 않는다)
# ROUTER_MIN_CONFIDENCE=0.5
# unknown 클래스: 분류 불가 시 답을 지어내는 대신 되묻기 (기본 off = 프롬프트 바이트 동일)
ROUTER_UNKNOWN_ENABLED=false
# 답변 영역 소유(plans/102 · D-224): 라우터·분해 프롬프트에 소유표를 렌더하고, LLM이 낸 답변 영역으로
# 정본 시스템(자산관리/폴스타)을 코드가 교정한다. 빈 분류 폴백도 응답에 표기 (기본 off = 프롬프트 바이트 동일)
ROUTER_CAPABILITY_OWNERSHIP_ENABLED=false

# === 교차 시스템 질의 (plans/102 · D-224 — 둘 다 기본 off = 현행 비트 동일) ===
# 값 기반 키 브리지: 선행 결과 서버 키를 컬럼명이 아니라 값(호스트명·FQDN·IP)으로 판정하고
# 대상 DB 프로필 entity_keys로 대상 컬럼을 확정한다. 켜기 전 D-203 순차 질의 시나리오를 재측정할 것
CROSS_SYSTEM_KEY_BRIDGE_ENABLED=false
# 식별자 소재 프로브: 3단 semantic_router 뒤 entity_locator 노드(시스템당 고정 조회 1회 · LLM 0회)
CROSS_SYSTEM_PROBE_ENABLED=false

# === 의도 프레임 · 확정 해석 병기 (plans/107 — 전부 기본 off = 현행 비트 동일) ===
# 확정된 질의 의도를 구조(프레임)로 만들어 기록할지. 이 값만 켜서는 어떤 프롬프트도 바뀌지 않는다(기록만)
INTENT_FRAME_ENABLED=false
# 확정 해석을 LLM 프롬프트에 병기할지: off | shadow(기록만) | augment(아래 소비자에게만 병기). 그 밖의 값은 경고 후 off.
# augment는 기준선 측정 없이 켜지 않는다 — SQL·응답 품질 영향이 아직 측정되지 않았다
CANONICAL_QUERY_MODE=off
# 해석 블록을 병기할 소비자 목록(쉼표 구분 — JSON 배열 아님): output_generator · general_inference · query_generator
CANONICAL_QUERY_CONSUMERS=
# 재작성 게이트: off | shadow(판정 기록만) | enforce(모호하지 않은 질의에는 병기하지 않음)
REWRITE_GATE_MODE=off
# 재작성 검증: off | shadow — LLM이 다시 쓴 질의가 확정 해석과 어긋나는지 대조해 기록만 한다
REWRITE_VERIFY_MODE=off

# === 구조화 출력 백엔드 (Plan 79 E-3 / D-169) ===
# none(기본 — 현행 비트동일) | instructor(optional extra "structured", 미설치 시 graceful 강등)
STRUCTURED_OUTPUT_BACKEND=none
# 검증 실패 재시도 횟수 (총 LLM 호출 = 값+1회, instructor max_retries 규약)
STRUCTURED_OUTPUT_MAX_RETRIES=1

# === 호스트 조사 인가 (Plan 78 W3-5 / R-9) ===
# admin_only = admin 역할만 조사 진입 허용. 미설정·미상 값도 차단(fail-closed)
HOST_AUTHZ_MODE=admin_only

# === Polestar 전용 프롬프트 ===
# Polestar EAV 구조 전용 시스템 프롬프트를 적용할 DB ID
# ACTIVE_DB_IDS에 포함된 DB 중 Polestar 전용 프롬프트를 적용할 DB ID (콤마 구분)
# 비어있으면 모든 DB에 범용 프롬프트 적용
# 로컬 샌드박스(polestar)도 폴스타 계열 — 포함해야 폴백 LLM 경로에 전용 규칙이 주입됨(D-076 후속3)
# 기본값 빈 값 — 폴스타 운영 배치에서는 아래 권장값을 해제해 설정한다
# POLESTAR_DB_IDS=polestar_b0,polestar_cm_gp,polestar_cm_yd,polestar

# === 멀티턴 대화 / Human-in-the-loop ===
# SQL 실행 전 사용자 승인 요구 여부
ENABLE_SQL_APPROVAL=false
# 대화 세션 최대 턴 수
# CONVERSATION_MAX_TURNS=20
# 대화 세션 유효 시간 (시간)
# CONVERSATION_TTL_HOURS=24

# ── 알람 분석·발송 기본 설정 (Plan 46 — AlarmWorker) ─────────
# true면 에이전트 서버 기동 시 AlarmWorker가 Redis Stream을 소비한다(기본 비활성 — 옵트인).
# 소켓 수신 서버(폴스타 TCP → Redis 적재)는 별도 설정: noise_gate/alarm_server/alarm_server.env.example
# ALARM_ENABLED=false
# 처리할 최소 심각도 (0=해소, 1=주의, 2=경고, 3=심각).
# ★ 노이즈 게이트(NOISE_ENABLE_NOISE_GATE=true) 활성 시 1 권장 — 아래 Plan 52 섹션 참고.
# ALARM_MIN_SEVERITY=2
# 알람 원문이 들어오는 Redis 스트림 이름 — 수신부(alarm_server)와 같은 이름이어야 한다
# ALARM_REDIS_STREAM_KEY=alarm:raw
# 스트림을 읽는 소비자 그룹 이름
# ALARM_REDIS_CONSUMER_GROUP=alarm-workers
# alarm_id 기반 동일 메시지 재처리 방지 TTL
# ALARM_DEDUP_TTL_SECONDS=300
# 알람 분석 테스트 API(POST /alarm/test)에서 db_id 생략 시 기본 인스턴스 (Plan 67 Phase 0 ⑫)
# ALARM_DEFAULT_TEST_DB_ID=polestar_b0
# (D-184) 워커 처리 실패 메시지 dead-letter — ACK 폐기 전에 원문+사유를 별도 스트림에 보관.
# 진단: redis-cli XRANGE alarm:dead - + COUNT 20 / 재처리: 원문 data를 alarm:raw에 다시 XADD. (상시 동작)
# ALARM_DEAD_LETTER_STREAM_KEY=alarm:dead
# dead-letter 스트림 근사 상한(XADD MAXLEN ~)
# ALARM_DEAD_LETTER_MAXLEN=1000
# (D-188) hostname → 폴스타 등록 서버명·IP 역조회(cmm_resource). 폴스타 템플릿이 platformName/
# ipAddress를 지원하지 않아 알람에는 hostname만 실린다 — 공동존(name≠hostname) 식별·이력 매칭용. (상시 동작)
# 역조회 전체 타임아웃(초) — 초과 시 이벤트 값 유지(graceful)
# ALARM_SERVER_IDENTITY_TIMEOUT_SECONDS=3.0
# 역조회 결과 Redis 캐시 TTL(초, 0=미캐시)
# ALARM_SERVER_IDENTITY_CACHE_TTL_SECONDS=3600
# 발송 채널 (CSV — 현재 지원: workb, webhook)
# ALARM_NOTIFICATION_CHANNELS_CSV=workb
# Generic Webhook 채널 (비어있으면 webhook 채널 자동 무시)
ALARM_WEBHOOK_URL=
# 웹훅 발송 타임아웃(초). 넘기면 발송 실패로 처리하고 다른 채널 발송은 계속한다
# ALARM_WEBHOOK_TIMEOUT_SECONDS=10

# ── worKB(사내메신저) 쪽지 발송 채널 설정 ─────────
# bearer 토큰은 민감정보 — .encenv에 WORKB_BEARER_TOKEN으로 저장 (.encenv.example 참고)
# (주의) 빈 값 뒤 인라인 주석은 값으로 파싱되므로 주석은 별도 줄에 둔다.
# base_url 예: http://kbone-portal.internal:28080
WORKB_BASE_URL=
# 시스템 구분자 (worKB 관리자 발급)
# WORKB_SYSTEM_DIV=
# 발송자 사번
# WORKB_SEND_ID=
# 기본 수신자 사번 목록 (쉼표 구분)
# WORKB_USER_IDS_CSV=
# 심각도 3 전용 수신자 (비면 기본 수신자)
# WORKB_CRITICAL_USER_IDS_CSV=
# 심각도 2 전용 수신자 (비면 기본 수신자)
# WORKB_WARNING_USER_IDS_CSV=
# 쪽지 제목 접두어
# WORKB_ALIAS=[인프라알람]
# 쪽지 발송 타임아웃(초). 넘기면 그 통보는 실패로 처리한다
# WORKB_TIMEOUT_SECONDS=10

# ── 알람 이력 패턴 분석 (Plan 47) ─────────
# ALARM_HISTORY_ENABLED=true
# 조회 기간(일): 90=일·주·월 주기 판정 가능(기본), 월 주기 작업이 많으면 180
# ALARM_HISTORY_LOOKBACK_DAYS=90
# 이력 조회 행 수 상한. 상한에 걸리면 잘렸다는 표시가 함께 남는다
# ALARM_HISTORY_MAX_ROWS=2000
# 이력 조회 결과 재사용 시간(초, 0=캐시 안 함)
# ALARM_HISTORY_CACHE_TTL_SECONDS=300
# 알람 보강(이력·프로세스·메트릭 조회) 전체 타임아웃(초). 넘으면 그때까지 모은 정보로 진행한다
# ALARM_ENRICH_TIMEOUT_SECONDS=5
# 같은 알람이 24시간 안에 이 횟수 이상 발생하면 급증으로 판정한다
# ALARM_BURST_THRESHOLD_24H=5

# ── 알람 영향 프로세스 보강 (Plan 47-1) ─────────
# CPU/메모리 발생 알람 시점에 폴스타 실시간 프로세스 API를 hostname으로 조회.
# 내부망 시스템 — http://, 인증 불필요. CSV는 db_id=base_url 형식 (JSON 아님).
# 코드 기본값은 공란이다(운영 호스트 하드코딩 제거 — Plan 67 Phase 0 ⑪).
# 아래 CSV를 설정하지 않으면 해당 db_id의 프로세스 보강이 비활성된다.
# ALARM_PROCESS_ENRICH_ENABLED=true
# DB별 프로세스 조회 API 주소(db_id=base_url 쉼표 목록)
# 기본값 빈 값 — 폴스타 운영 배치에서는 아래 권장값을 해제해 설정한다
# ALARM_PROCESS_API_BASE_URLS_CSV=polestar_cm_gp=http://polestar.kbonecloud.com,polestar_cm_yd=http://yd-polestar.kbonecloud.com,polestar_b0=http://10.37.16.51:9010
# 프로세스 조회 API 타임아웃(초)
# ALARM_PROCESS_API_TIMEOUT_SECONDS=3
# 알람에 싣는 상위 프로세스 수(자원 사용량 순)
# ALARM_PROCESS_TOP_N=5

# ── 게이트 경로 Prometheus (Plan 60 E3 baseline — ⚠ 현재 프로덕션 호출부 미배선, docs/27 §3.3) ──
# 조사(SRE) 경로의 PROMETHEUS_URL(mcp_server/.env)과 **별개 설정**이다. 호출부가 배선되지
# 않아 지금은 채워도 효과가 없다 — 처리 방식(배선/삭제)은 plans/70 P1-1 사용자 결정 대기.
# ALARM_PROMETHEUS_ENABLED=false
# 존별 CSV: db_id=http://prom:9090,… (미설정 시 전부 None)
# ALARM_PROMETHEUS_BASE_URLS_CSV=
# Prometheus 조회 타임아웃(초) — 호출부 미배선이라 현재 미소비
# ALARM_PROMETHEUS_TIMEOUT_SECONDS=3

# ── 알람 노이즈 캔슬링 게이트 (Plan 52, 기본 비활성 — 옵트인) ─────────
# enable_noise_gate=false면 기존 알람 발송 경로가 무변경(회귀 0). true로 켜면 4-티어
# (PAGE/TICKET/DASHBOARD/SUPPRESS) 발송 판단 게이트가 작동한다.
# ★ 게이트 활성 시 ALARM_MIN_SEVERITY=1 권장(§4.8): 게이트가 강등·억제를 수행하므로
#   주의(severity 1)까지 게이트에 도달해야 매트릭스 하단 행이 동작한다.
#   (severity 0 해소·severity 3 심각은 워커·게이트 어디서도 드롭하지 않음)
# NOISE_ENABLE_NOISE_GATE=false
# ── E1 (현재 구현) ──
# 억제 허용 상한 (심각도 3은 항상 PAGE)
# NOISE_SUPPRESS_MAX_SEVERITY=2
# IMPORTANCE_ID 코드→라벨 매핑(인스턴스별 확정 필요, 빈값=전부 보통취급). 예: 1=낮음,2=보통,3=높음
# NOISE_IMPORTANCE_VALUE_MAP_CSV=
# 자가복구 상관 창(발생+해소 매칭)
# NOISE_SELF_HEAL_WINDOW_SECONDS=300
# 재발생 재통보 간격(4h, 핑거프린트 dedup TTL)
# NOISE_REPEAT_INTERVAL_SECONDS=14400
# 억제 판단 배경 정보(이력·토폴로지·변경) 수집 타임아웃(초). 넘으면 있는 정보만으로 판단한다
# NOISE_NOISE_CONTEXT_TIMEOUT_SECONDS=3.0
# 배경 정보 재사용 시간(초, 0=매번 수집)
# NOISE_NOISE_CONTEXT_CACHE_TTL_SECONDS=300
# 독립 해소(severity 0)를 DASHBOARD로 표시할지
# NOISE_RESOLVED_TO_DASHBOARD=false
# 게이트 판단 기록(JSONL) 저장 경로 — 상대 경로는 서버 작업 디렉터리 기준
# NOISE_DECISION_STORE_PATH=logs/alarm_decisions.jsonl
# 게이트 판단 기록 on/off (기본 on — 끄면 오억제를 확인할 방법이 사라진다)
# NOISE_DECISION_STORE_ENABLED=true
# (Plan 54) 관제 화면 조회가 파일 끝에서 되짚는 줄 수 상한 (감사 파일은 그대로, 화면 응답만 보호)
# NOISE_DECISION_STORE_MAX_LINES=20000
# ── Plan 54 모듈 4: 운영자 침묵(Silence) 규칙 (기본 off — 심각도 3은 어떤 규칙으로도 침묵 불가) ──
# 운영자 침묵 규칙을 게이트가 적용할지 (끄면 규칙을 조회하지 않는다)
# NOISE_SILENCE_ENABLED=false
# 침묵 규칙 저장 경로(JSONL — 생성·해제를 덧붙이기만 한다)
# NOISE_SILENCE_STORE_PATH=logs/alarm_silences.jsonl
# 규칙 1건 최대 존속(초, 7일)
# NOISE_SILENCE_MAX_DURATION_SECONDS=604800
# 워커 활성 규칙 캐시 TTL(초, hot-path 보호)
# NOISE_SILENCE_CACHE_TTL_SECONDS=10
# ── E2 (의존성 억제·인히비션 구현, 그 외 자리예약) ──
# NOISE_DEBOUNCE_SECONDS=0
# (E2) 플래핑 진입 임계(%) — 상태 변화 비율이 이 값을 넘으면 진동으로 판정
# NOISE_FLAP_HIGH_THRESHOLD=20.0
# (E2) 플래핑 해제 임계(%) — 변화 비율이 이 값 아래로 내려가면 진동 종료
# NOISE_FLAP_LOW_THRESHOLD=5.0
# (E2) 플래핑 억제 on/off (상태 진동 시 안정화까지 보류)
# NOISE_FLAPPING_ENABLED=false
# (E2) 부모 리소스 비정상 시 자식 연쇄 노이즈 억제
# NOISE_DEPENDENCY_SUPPRESSION=false
# (E2) 동일 서버 상위 심각도 발생 중 하위 음소거
# NOISE_INHIBITION_ENABLED=false
# (E2) 상위 심각도 활성 간주 창
# NOISE_INHIBITION_WINDOW_SECONDS=300
# (E2) 스톰 그룹핑 on/off (동일 서버 다발 시 대표 외 억제)
# NOISE_STORM_GROUPING_ENABLED=false
# (E2) 스톰 사건창(초)
# NOISE_STORM_WINDOW_SECONDS=60
# (E2) 창 내 이 수 초과 시 스톰
# NOISE_STORM_THRESHOLD=5
# (§6.1) 심각도3 재통보 간격(기본=공통 4h, 운영서 단축 가능)
# NOISE_SEV3_REPEAT_INTERVAL_SECONDS=14400
# ── E3 (AI 심각도 보강·메타모니터링·운영지표·TICKET 일배치 큐 구현) ──
# (자리예약, 미구현) 시간대 강등용
# NOISE_BUSINESS_HOURS_CSV=
# (E3) 억제율 이 값 초과 시 메타경보
# NOISE_META_ALERT_SUPPRESS_RATIO=0.9
# (E3) 메타경보·운영지표 집계 창(1h)
# NOISE_META_ALERT_WINDOW_SECONDS=3600
# (E3) 창 내 이벤트 수가 이 값 미만이면 무수신 메타경보
# NOISE_META_ALERT_MIN_EVENTS=1
# (E3) AI 메시지 심각도 보강(상향 전용, 메시지형 알람 한정)
# NOISE_ENABLE_AI_SEVERITY_BOOST=false
# (E3) 상향만(하향 억제 금지) — 안전 고정
# NOISE_AI_SEVERITY_ESCALATE_ONLY=true
# (E3) TICKET 일배치 요약 큐
# NOISE_TICKET_BATCH_QUEUE_PATH=logs/alarm_ticket_queue.jsonl
# (E3) TICKET 티어를 일배치 요약 큐에 적재
# NOISE_TICKET_BATCH_QUEUE_ENABLED=true
# (E3 후속) 워커→UI 실시간 SSE Redis pub/sub 브리지 on/off
# NOISE_SSE_BRIDGE_ENABLED=false
# (E3 후속) SSE 브리지 Redis pub/sub 채널명
# NOISE_SSE_BRIDGE_CHANNEL=alarm:sse
# (Plan 83) SUPPRESS 티어도 SSE로 발행(관리자 전용 감사 레벨). 기본 off = 현행 동작
# NOISE_SSE_SUPPRESSED_ENABLED=false
# (D-049) ack/incident 라이프사이클 계측 on/off (MTTA/MTTR/사건전환율)
# NOISE_INCIDENT_TRACKING_ENABLED=false
# (D-049) incident 이벤트 Redis pub/sub 채널명
# NOISE_INCIDENT_EVENT_CHANNEL=alarm:incident
# (E4) LLM 피드백 few-shot 액션가능성 판단(기본 off)
# NOISE_ENABLE_LLM_ACTIONABILITY=false
# (E4) 운영자 피드백 JSONL 저장 경로
# NOISE_FEEDBACK_STORE_PATH=logs/alarm_feedback.jsonl
# (E4) 피드백 적재 on/off
# NOISE_FEEDBACK_STORE_ENABLED=true
# (E4) few-shot 예시 최대 개수
# NOISE_ACTIONABILITY_FEWSHOT_COUNT=3
# (Plan 83) 피드백 파일 회전 상한 = 조회 창 크기. 초과 시 오래된 절반이 .1로 이동
# NOISE_FEEDBACK_STORE_MAX_LINES=20000
# (Plan 86 · D-192) 알람 카드의 조회 질의 LLM 추천. 기본 off — 켜면 과금 경로가 붙는다.
# 결정적 축 매핑(resource_type 기반)이 0건인 알람에서만 호출한다. 제안된 질의도 확인 후 전송.
# NOISE_ALARM_PROMPT_LLM_SUGGEST_ENABLED=false
# ── E5: deepagents Advisory Enricher (agentic 보조 분석기, D-048.7, 기본 off) ──
# off면 E1~E4 배선·발송 판단 무변경. 판단은 결정적 게이트가 하고 enricher는 승격 전용 보조만.
# 트랙 B(agentic tool-calling)는 ORCHESTRATOR_PROVIDER=vllm(health OK) 또는 =gemini(+키)일 때 동작.
#   → vLLM 없이 Gemini API로 트랙 B 테스트: ORCHESTRATOR_PROVIDER=gemini + LLM_GEMINI_API_KEY 설정
#     (test_agentic_enricher_gemini_live.py 는 키 있으면 실 Gemini로 실행, 없으면 skip).
# (E5) 보조 분석기 옵트인
# NOISE_ENABLE_AGENTIC_ENRICHER=false
# (E5) vLLM 미서빙 시: semantic_routing | deterministic_only
# NOISE_AGENTIC_ENRICHER_FALLBACK=semantic_routing
# (E5) enricher 전체 타임아웃(초, 초과 시 no-op)
# NOISE_AGENTIC_ENRICHER_TIMEOUT_SECONDS=8.0
# (E5) 트랙 B ReAct 루프 도구 호출 상한
# NOISE_AGENTIC_ENRICHER_MAX_TOOL_CALLS=5
# (E5) LogMonitor/보안/앱 로그 한정
# NOISE_AGENTIC_ENRICHER_MESSAGE_ALARMS_ONLY=true

# ══ Plan 60 노이즈 캔슬링 정밀화 (D-106~D-114) — 전부 옵트인·기본 off ══
# off 상태에서 현행 게이트와 비트동일(회귀 0, test_plan60_flags_off_regression.py 고정).
# 검증 방법: docs/20_plan60_feature_test_guide.md / 아래 E1~E6 번호는 Plan 60 기준(위 Plan 52 E5와 무관)

# ── Plan 60 E1: 재발생 억제 감사 (D-106) — dedup TTL은 위 NOISE_REPEAT_INTERVAL_SECONDS ──
# (P60 E1) 재발생 억제 감사 적재 샘플링(1=매번, N이면 count%N==0만 적재)
# NOISE_RECURRENCE_AUDIT_EVERY_N=1

# ── Plan 60 E2: 크로스-호스트 상관 (D-109) — db_id(존) 경계 내만, 존 간 상관 금지 ──
# (P60 E2) 크로스-호스트 상관 on/off
# NOISE_CROSS_HOST_CORRELATION_ENABLED=false
# (P60 E2) Jaccard 필드유사도 임계(이상이면 동일 클러스터)
# NOISE_CORRELATION_SIM_THRESHOLD=0.5
# (P60 E2) 상관 사건창(초)
# NOISE_CORRELATION_WINDOW_SECONDS=120
# (P60 E2) 대표 포함 이 수 이상 멤버부터 억제 개시
# NOISE_CORRELATION_MIN_CLUSTER_SIZE=2
# (P60 E2) 스코프별 활성 클러스터 상한(메모리 가드)
# NOISE_CORRELATION_BUFFER_MAX=1000
# (P60 E2) 필드 가중 CSV (자리예약 — 현재 미소비)
# NOISE_CORRELATION_FIELD_WEIGHTS_CSV=
# (P60 E7-d) 사이트/위치 상관 차원 on/off — 존 경계(B-6) 불변, off면 현행 비트동일
# NOISE_CORRELATION_SITE_DIMENSION_ENABLED=false
# (P60 E2·D-112) E4 토폴로지 인접 클러스터 유사도 보너스 on/off (상관의 하위 옵트인)
# NOISE_CORRELATION_TOPOLOGY_WEIGHT_ENABLED=false
# (P60 E2·D-112) 인접 보너스 크기
# NOISE_CORRELATION_TOPOLOGY_WEIGHT=0.2

# ── Plan 60 E3: 동적 baseline 이상탐지 (D-110) — 상향 전용·게이트 무변경 ──
# (P60 E3) 동적 baseline on/off — 반영에는 NOISE_ENABLE_AI_SEVERITY_BOOST=true도 필요(AND 조건)
# NOISE_DYNAMIC_BASELINE_ENABLED=false
# (P60 E3) 잔차 z-score 상향 임계
# NOISE_ANOMALY_Z_HIGH=3.0
# (P60 E3) 적합 최소 주기 수(미만이면 계산 skip)
# NOISE_ANOMALY_MIN_PERIODS=3
# (P60 E3) baseline 파라미터 Redis 캐시 TTL(초)
# NOISE_ANOMALY_BASELINE_CACHE_TTL_SECONDS=3600
# (P60 E3 2차·D-113) STL 분해 이상탐지 — statsmodels 필요(pip install ".[stl]"), 미설치 시 HW 폴백
# NOISE_ANOMALY_STL_ENABLED=false
# (P67 R3-v) 알람 kind→메트릭 소스 매핑 오버라이드 "kind=resource_type:definition_name,…"
# 빈값이면 어댑터 기본 매핑(cpu=server.Cpus:Utilization, memory=server.Memory:Utilization)
# NOISE_ANOMALY_METRIC_SOURCE_MAP_CSV=

# ── Plan 67 R3-(v): 운영자 주석 3분류 LLM 전환 (D-132) — 기본 OFF ──
# ⚠ true로 켜면 알람 유입량만큼 LLM 호출(과금)이 발생한다 — 전환은 운영 결정(D-127).
# OFF면 기존 정규식 분류가 그대로 쓰이고, ON에서도 실패·타임아웃 시 정규식으로 강등된다.
# NOISE_ANNOTATION_LLM_CLASSIFICATION_ENABLED=false
# (P67 R3-v) 분류 1건 타임아웃(초) — 초과 시 정규식 분류로 강등
# NOISE_ANNOTATION_LLM_TIMEOUT_SECONDS=3.0
# (P67 R3-v) 주석 해시 캐시 항목 상한(0=캐시 비활성)
# NOISE_ANNOTATION_LLM_CACHE_MAX=500
# (P67 R3-v) 캐시 항목 TTL(초, 0=만료 sweep 비활성)
# NOISE_ANNOTATION_LLM_CACHE_TTL_SECONDS=3600

# ── Plan 60 E7: 실측 ITSM 사례 기반 텍스트·주석 신호 보완 (D-116 — 전부 기본 off) ──
# (E7-a) dedup 억제 시 계획작업/해소/운영자접수 주석을 추출해 원 인시던트에 보존
# NOISE_ANNOTATION_HARVEST_ENABLED=false
# (E7-a) 계획-무해 주석 코로보레이션 충족 시 후속 동종 알람 DASHBOARD 강등 (주석 단독 강등 금지)
# NOISE_ANNOTATION_PLANNED_SUPPRESS=false
# (E7-b) 비알람(승인/안내성) 사전 억제 — 애매하면 알람 간주(재현율 우선)
# NOISE_NON_ALARM_FILTER_ENABLED=false
# (E7-c) 이질 포맷 graceful 폴백 파싱 (침묵 드롭·크래시 금지, 알려진 포맷은 비트동일)
# NOISE_FORMAT_TOLERANT_PARSING_ENABLED=false

# ── Plan 60 E4: 토폴로지 다홉 연쇄 억제 (D-107) — root 통보 확인 시 SUPPRESS, 미확인 시 DASHBOARD ──
# (P60 E4) 다홉 연쇄 억제 on/off
# NOISE_MULTI_HOP_CASCADE_ENABLED=false
# (P60 E4) 정적 엣지 그래프 캐시 TTL(초, 24h)
# NOISE_TOPOLOGY_CACHE_TTL_SECONDS=86400
# (P60 E4) BFS 홉 상한
# NOISE_TOPOLOGY_MAX_HOPS=5

# ── Plan 60 E5: 변경 상관 (D-111) — 폴스타 변경이력 read-only 오버레이 ──
# (P60 E5) 변경 상관 on/off
# NOISE_CHANGE_CORRELATION_ENABLED=false
# (P60 E5) 알람 직전 이 창(초) 내 변경만 원인 후보로 오버레이
# NOISE_CHANGE_WINDOW_SECONDS=3600

# ── Plan 60 E6: 통보 컨텍스트 보강 L1 (D-108) — post-gate·본문 첨부만(판정 불변) ──
# (P60 E6) 메시지 기반 L1 보강 첨부 on/off (프로세스 스냅샷 자체는 ALARM_PROCESS_ENRICH_ENABLED)
# NOISE_MESSAGE_ENRICHMENT_ENABLED=false
# (P60 E6) 이 티어 이상 통보 결정 시에만 보강 첨부 (PAGE|TICKET|DASHBOARD|SUPPRESS)
# NOISE_ENRICHMENT_MIN_TIER=PAGE
# (P60 E6) L1 추가 조회(host-wide 프로세스) 상한(초)
# NOISE_ENRICHMENT_L1_TIMEOUT_SECONDS=3.0
# (P60 E6) kind→요지 제목 오버라이드 CSV ("disk=...,log=...")
# NOISE_ENRICHMENT_PROFILE_MAP_CSV=

# ── Plan 60 B-7: 로컬 임베딩 주석 (D-114) — 주석 전용·판정 불변(D-035)·런타임 다운로드 금지 ──
# 모델 설치·배치: docs/19_embedding_model_install_guide.md (확정 모델: multilingual-e5-small)
# (P60 B-7 L-2) 의미적 근접중복 주석 on/off
# NOISE_SEMANTIC_DEDUP_ANNOTATION_ENABLED=false
# (P60 B-7 L-4) 토폴로지+텍스트 융합 주석 on/off
# NOISE_TOPOLOGY_TEXT_FUSION_ENABLED=false
# (P60 B-7) 로컬 모델 디렉토리 절대경로 — 미설정/비디렉토리면 임베딩 inert
# NOISE_EMBEDDING_MODEL_PATH=
# (P60 B-7 L-2) 근접중복 주석 임계 — e5-small 실측 0.87 (bge-m3 교체 시 ~0.65 재튜닝)
# NOISE_EMBEDDING_SIMILARITY_THRESHOLD=0.87
# (P60 B-7) 임베딩 hot-path 예산(초)
# NOISE_EMBEDDING_TIMEOUT_SECONDS=2.0

# ── Plan 64 CW-A: sre_agent 알람 자동 조사 트리거 (push · D-118/D-123) — docs/26 §5.5 ──
# ★ 전부 기본 off — 켜기 전 sre_agent 조사 서비스(:9098)가 같은 서버에 떠 있어야 한다(docs/26 §5.4).
# (CW-A) 게이트 PAGE 판정 직후 자동 조사 submit/poll·브리핑 첨부 on/off (off면 트리거 노드 미배선 — 통보 경로 비트동일)
# NOISE_INVESTIGATION_TRIGGER_ENABLED=false
# (CW-A) 이 티어 이상 결정 시에만 트리거
# NOISE_INVESTIGATION_TRIGGER_MIN_TIER=PAGE
# (CW-A) sre_agent 조사 서비스 MCP SSE 엔드포인트 — 서비스가 127.0.0.1:9098 고정 바인드라 본체와 같은 서버여야 함
NOISE_INVESTIGATION_SERVICE_URL=http://localhost:9098/sse
# (CW-A) 정적 Bearer 토큰 — sre_agent/.env의 SERVICE_BEARER_TOKEN과 일치시킬 것(D-125). 비면 무헤더
NOISE_INVESTIGATION_SERVICE_TOKEN=
# (CW-A) submit/poll 개별 호출 타임아웃(초)
# NOISE_INVESTIGATION_MCP_CALL_TIMEOUT_SECONDS=10.0
# (CW-A) poll 재조회 간격(초)
# NOISE_INVESTIGATION_POLL_INTERVAL_SECONDS=1.0
# (CW-A) 전체(submit+poll) 타임아웃(초) — 실 LLM 조사(기준치 161s)에는 짧으므로 상향 대신 아래 후속 발송 권장
# NOISE_INVESTIGATION_TOTAL_TIMEOUT_SECONDS=45.0

# ── Plan 66 3-E: 즉시통보 + 후속 브리핑 (D-124) — submit까지만 하고 즉시 통보, 브리핑은 별도 발송 ──
# (3-E) 후속 발송 on/off (off면 CW-A 인라인 첨부 — PAGE 통보가 조사 완료까지 지연)
# NOISE_INVESTIGATION_FOLLOWUP_ENABLED=false
# (3-E) 후속 poll 전체 타임아웃(초 · 조사 서비스 dispatcher 상한 정렬)
# NOISE_INVESTIGATION_FOLLOWUP_TIMEOUT_SECONDS=300.0
# (3-E) 동시 진행 후속 태스크 상한 (알람 폭주 시 spawn 차단·사유 로그)
# NOISE_INVESTIGATION_FOLLOWUP_MAX_INFLIGHT=8

# ── Plan 64 CW-B/CW-C: 챗 장애 진단 pull 위임 · escalate-only 승격 ──
# (CW-B) 챗 "○○ 서버 원인 분석해줘" → sre_diagnose 위임 on/off (연결 설정은 위 CW-A의 URL/토큰/타임아웃 재사용)
# NOISE_FAULT_DIAGNOSIS_ENABLED=false
# (CW-C) 조사 verdict.escalate=True면 통보에 중요도 상향 안내 첨부 (게이트 판정 소급 변경 없음 · escalate-only)
# NOISE_FAULT_ESCALATION_ENABLED=false

# ── plans/91 1-6 · Plan 60 §18 E8 (나)안: post-gate 비차단 L3 진단 보강 (D-189 허용목록 명령 · D-209) ──
# PAGE 통보를 보낸 **뒤** 대상 호스트에서 kind별 읽기 전용 명령을 돌려 상태 요지를 후속 발송한다.
# 게이트 동기 경계 probe는 폐기됐다(U-H 확정) — 통보 지연 0. 기본 off면 수집·후속 발송·감사
# 전부 미수행이라 통보 경로가 비트 동일하다. 만료일 2027-02-20(D-161 C1 — 기한 도래 시 on 확정 또는 삭제).
# (E8) PAGE 통보 뒤 L3 수집 → 결정적 요지 후속 발송 on/off
# NOISE_L3_ENRICHMENT_ENABLED=false
# (E8) 수집 명령·상태지문·전이를 decision_store에 감사(type="l3_state")
# NOISE_L3_AUDIT_ENABLED=false
# (E8) 실행 채널 — D-189 경로 B. 현재 allowlist_exec(ssh)만 구현
# NOISE_L3_HOST_ACCESS_MODE=allowlist_exec
# (E8) kind→프로파일 오버라이드("memory=memory,process=process"). 미지정 시 kind와 동명
# NOISE_L3_PROFILE_MAP_CSV=
# (E8) 명령당 상한(초) — 부하 가드 접두(timeout 20 nice -n 10)와 같은 값
# NOISE_L3_COMMAND_TIMEOUT_SECONDS=20.0
# (E8) allowlist_exec ssh 사용자. 빈 값이면 서비스 실행 계정을 그대로 쓴다
# NOISE_L3_SSH_USER=
# (E8) 동시 L3 수집 태스크 상한(알람 폭주 시 스폰 차단·사유 로그)
# NOISE_L3_MAX_INFLIGHT=4

# ═══ 실시간 사용률 API (Plan 71 / D-144 — 폴스타 measurement REST) ═══
# "실시간/현재/지금" + CPU/메모리 질의를 SQL 대신 폴스타 measurement API로 조회한다(B안 게이트).
# ★ 기본 off — 활성화하려면 아래 한 줄을 true로 (off면 기존 SQL 경로 무변경, 회귀 0).
POLESTAR_REST_REALTIME_USAGE_ENABLED=false
# db_id=base_url CSV. 은행존(b0)은 포트 9010 명시 필수 (Plan 75 §1.3-5 실측).
# 주석은 별도 줄에만 작성할 것 (.env 인라인 주석 금지 — Known Mistakes)
POLESTAR_REST_BASE_URLS_CSV=polestar_b0=http://10.37.16.51:9010,polestar_cm_gp=http://polestar.kbonecloud.com,polestar_cm_yd=http://yd-polestar.kbonecloud.com
# measurement 전용 타임아웃(초) — 프로세스 API(3s)와 별도. gp 200대 실측 2.46s라 여유 확보.
POLESTAR_REST_MEASUREMENT_TIMEOUT_SECONDS=10
# 1콜당 서버 수(청크). 200대/콜 실측 확정 — URL 길이·응답 크기 안전 범위.
POLESTAR_REST_MEASUREMENT_CHUNK_SIZE=200
# 수집 시각(time)이 이보다 오래되면 "수집 지연" 표기(분).
POLESTAR_REST_STALE_AFTER_MINUTES=15

# NOTE: DB 연결 문자열은 MCP 서버 VM에서 관리합니다.
# MCP 서버 설정: mcp_server/config.toml + mcp_server/.env

# ── DRM 해제 (Plan 74 / D-156) — Softcamp ServiceLinker(scsl.jar) 연동 ──
# 기본 false=Passthrough(현행 동일). 운영(RHEL 9.6)에서만 단계적 활성화(계획서 §4.1).
# 주의: softcamp.properties의 내용(LinkSystemIP 등)은 scsl이 직접 읽음 — env로 대체 불가, 경로만 지정.
DRM_ENABLED=false
# 복호화에 쓸 Java 실행 파일(1.8 이상). 서비스로 띄울 때는 절대 경로가 안전하다
DRM_JAVA_BIN=java
# 경로 4종 기본값은 빈 값 — 운영(RHEL) 배치 시 아래 예시 경로를 해제해 설정한다

# 복호화 래퍼 소스(Decrypt.java) 절대 경로 — 비면 복호화가 동작하지 않는다
# DRM_WRAPPER_PATH=/opt/collectorinfra/tools/drm-wrapper/Decrypt.java
# 벤더 복호화 라이브러리(scsl.jar) 절대 경로
# DRM_SCSL_JAR_PATH=/home/softcamp/02_Module/02_ServiceLinker/scsl.jar
# 벤더 설정 파일(softcamp.properties) 절대 경로 — 파일 내용은 라이브러리가 직접 읽는다
# DRM_PROPERTIES_PATH=/home/softcamp/02_Module/02_ServiceLinker/softcamp.properties
# 복호화 키 파일 절대 경로(24시간 주기 갱신)
# DRM_KEY_FILE_PATH=/home/softcamp/04_KeyFile/keyDAC_SVR0.sc
# 보안 도메인 식별자 — 벤더 가이드 고정값(수정 금지)
DRM_GROUP_ID=SECURITYDOMAIN
# 복호화 중간 파일 디렉터리. 비우면 시스템 임시 경로 아래에 자동 생성한다(평문이 잠시 머문다 — 접근 권한 관리)
# DRM_TEMP_DIR=
# 복호화 프로세스 타임아웃(초, JVM 기동 시간 포함)
DRM_TIMEOUT_SEC=20

# === 화면 표시 ===
# 웹 화면의 기본 테마. light(밝게) | dark(어둡게)
# 운영자 대시보드 헤더의 테마 버튼이 이 값을 저장한다. 개인이 자기 화면에서 고른 테마가 있으면 그 선택이 우선한다.
UI_DEFAULT_THEME=light
