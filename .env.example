# ============================================================
# 인프라 데이터 조회 에이전트 — 환경변수 설정
# ============================================================
# 이 파일을 .env로 복사하여 실제 값으로 수정하세요.
#   cp .env.example .env
#
# pydantic-settings 규칙:
#   - list[str] 필드는 반드시 JSON 배열 형식 (예: ["a","b"])
#   - bool 필드는 true / false (소문자)
#   - 값 뒤 인라인 주석 금지 (KEY=v  # 주석 → 주석이 값에 포함되어 파싱 에러)
#
# 웹UI 편집: 운영자 대시보드(/admin) "환경변수 설정" 탭에서 이 파일의 모든 옵션을
#   조회·수정할 수 있다(타입별 위젯·형식 검증·백업 포함). 시크릿(.encenv 관리 키)은
#   읽기 전용이며, 대부분의 설정은 저장 후 서버 재시작이 필요하다.
#   ※ 이 파일의 키 직전 주석 블록이 웹UI 도움말로 그대로 노출된다.
# ============================================================

# === LLM 설정 ===
# provider: ollama | fabrix | gemini
LLM_PROVIDER=ollama
# 오픈소스 LLM 모델명 (예: llama3.1:8b, llama3.1:70b, gemma2:9b, gemma3:12b, qwen2.5:14b, mistral:7b)
LLM_MODEL=llama3.1:8b
# Ollama 서버 주소
LLM_OLLAMA_BASE_URL=http://localhost:11434
# Ollama 요청 타임아웃 (초) — 모델/프롬프트 복잡도에 따라 조정
LLM_OLLAMA_TIMEOUT=180
# Ollama Gateway API 키 → .encenv에서 관리 (LLM_API_KEY)

# Gemini 설정 (LLM_PROVIDER=gemini 시)
# API 키는 .encenv 파일에서 관리 (LLM_GEMINI_API_KEY)
# Gemini 모델명 (비어있으면 LLM_MODEL 사용)
# 권장: gemini-2.0-flash (안정), gemini-3.1-pro (최신)
LLM_GEMINI_MODEL=gemini-2.0-flash

# FabriX 설정 (LLM_PROVIDER=fabrix 시)
LLM_FABRIX_BASE_URL=
# FabriX API 키 / 클라이언트 키 → .encenv에서 관리 (FABRIX_API_KEY, FABRIX_CLIENT_KEY)
# FabriX 모델명 (비어있으면 LLM_MODEL 사용)
LLM_FABRIX_CHAT_MODEL=

# === DB 연결 ===
# db_backend: dbhub (MCP 서버 경유) | direct (PostgreSQL 직접 연결)
DB_BACKEND=direct
# direct 모드 시 PostgreSQL 연결 문자열
DB_CONNECTION_STRING=postgresql://infra_user:infra_pass_2024@localhost:5433/infra_db

# === MCP 서버 (DBHub) 설정 (DB_BACKEND=dbhub 시) ===
DBHUB_SERVER_URL=http://localhost:9099/sse
# ※ 반드시 mcp_server/config.toml의 [[sources]] name 값과 정확히 일치해야 함
# ※ 불일치 시 "알 수 없는 소스" 에러 발생
DBHUB_SOURCE_NAME=infra_db
# MCP 호출 전체 대기시간 (초)
DBHUB_MCP_CALL_TIMEOUT=60

# === 클라이언트 쿼리 정책 ===
# SQL 생성 실패 시 최대 재시도 횟수
QUERY_MAX_RETRY_COUNT=3
# SQL 생성 시 기본 LIMIT 절 값
QUERY_DEFAULT_LIMIT=1000
# 데이터 충분성 검사: hint/synonym 매핑의 최소 매칭 비율 (0.0~1.0)
QUERY_SUFFICIENCY_REQUIRED_THRESHOLD=0.7
# 데이터 충분성 검사: LLM 추론 매핑의 최소 매칭 비율 (0.0~1.0)
QUERY_SUFFICIENCY_OPTIONAL_THRESHOLD=0.5

# === 보안 ===
# 마스킹 대상 컬럼명 목록 (JSON 배열 형식 필수)
SECURITY_SENSITIVE_COLUMNS=["password","secret","token","api_key","private_key","credential"]
# 마스킹 치환 문자열
SECURITY_MASK_PATTERN=***MASKED***
# 부분 마스킹 대상 컬럼 (JSON 배열 형식, 예: ["email","phone"])
SECURITY_PARTIAL_MASK_COLUMNS=[]
# IP 주소 마스킹 여부
SECURITY_MASK_IP=false
# 이메일 주소 마스킹 여부
SECURITY_MASK_EMAIL=false

# --- FabriX 개인정보(PII) 필터 진단·예방 (src/security/pii_filter.py) ---
# 판정 규칙 근거: docs/pii_filtering_rules.md / 규칙 변경은 pii_filter.PII_RULES 에서.
# FabriX가 프롬프트/응답을 PII로 차단할 때 유형·텍스트·filter_log_id 경고 1건 로깅 (차단 시에만 발화)
SECURITY_PII_FILTER_LOG_ENABLED=true
# 위 로그의 감지 문자열을 원문 그대로 남길지 (기본 false=마스킹). 오탐(타임스탬프 등) 판정 시에만 한시적 true
SECURITY_PII_FILTER_LOG_UNMASK=false
# 프롬프트 주입 전 샘플 데이터(라이브 DB 행)의 PII를 형식보존 마스킹 스크럽 (기본 true=차단 예방)
SECURITY_PII_SCRUB_SAMPLES=true
# 차단 시 전송 프롬프트·응답 전문을 logs/pii_block/ 에 무마스킹 덤프 (기본 true, D-155 후속1)
# 트리거 특정: python scripts/pii_probe.py <덤프파일> (이등분 재전송, 최신 100개 보존)
SECURITY_PII_BLOCK_DUMP_ENABLED=true
# 날짜·타임스탬프 무해화(구분자 점 치환) 스크럽 (기본 false, D-155 후속3).
# 계좌번호(851) 차단인데 계좌 유사 문자열이 없으면 날짜형 광폭 매칭 의심 — 진단 로그의
# "[의심]" 표기로 확정 후 true로 전환 (2026-06-17 02:30:45 → 2026.06.17.02:30:45)
SECURITY_PII_SCRUB_SUSPECT_DATES=false

# === API 서버 ===
API_HOST=0.0.0.0
API_PORT=8000
# CORS 허용 오리진 (JSON 배열 형식, 운영: ["https://your-domain.com"])
API_CORS_ORIGINS=["*"]
# 일반 질의 타임아웃 (초) — 그래프 전체 실행 제한
API_QUERY_TIMEOUT=60
# 파일 업로드 질의 타임아웃 (초) — 엑셀/Word 템플릿 처리 시 LLM 호출이 많으므로 넉넉히
API_FILE_QUERY_TIMEOUT=120

# === 운영자 인증 ===
ADMIN_USERNAME=admin
# 운영자 비밀번호 / JWT 시크릿 → .encenv에서 관리 (ADMIN_PASSWORD, ADMIN_JWT_SECRET, AUTH_JWT_SECRET)
# JWT 토큰 만료 시간 (시간)
ADMIN_JWT_EXPIRE_HOURS=24

# === 사용자 인증 (Plan 39/59) ===
# 운영 모드. true면 로그인 필수 + 운영자 크레덴셜/시크릿 미설정 시 기동 거부
AUTH_ENABLED=false

# === 감사 로그 (Plan 40/59-a) ===
# 감사 로그 보관 일수. 이 기간이 지난 DB 로그는 기동 시 1회 + 하루 1회 자동 삭제(0 이하면 비활성)
AUDIT_RETENTION_DAYS=90

# === 체크포인트 (대화 상태 저장) ===
# checkpoint_backend: sqlite | postgres
CHECKPOINT_BACKEND=sqlite
# SQLite 파일 경로 또는 :memory:
CHECKPOINT_DB_URL=checkpoints.db

# === 로그 ===
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# === 실행 로그·트레이스 (D-140/D-141) ===
# 실행된 SQL 전량을 logs/sql/YYYY-MM-DD.sql에 기록
OBS_SQL_LOG_ENABLED=true
# SQL 로그 보존 일수 (0 이하면 자동 정리 비활성)
OBS_SQL_LOG_RETENTION_DAYS=30
# 정상 응답을 내지 못한 요청의 노드별 단계를 logs/trace/에 덤프 (정상 요청은 파일 미생성)
OBS_TRACE_ENABLED=true
# 트레이스 보존 일수 (0 이하면 자동 정리 비활성)
OBS_TRACE_RETENTION_DAYS=14
# 요청당 트레이스 링버퍼 단계 상한 (초과 시 가장 오래된 단계부터 밀어냄)
OBS_TRACE_MAX_STEPS=200

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis 비밀번호 → .encenv에서 관리 (REDIS_PASSWORD)
# TLS/SSL 사용 여부
REDIS_SSL=false
# Redis 소켓 타임아웃 (초)
REDIS_SOCKET_TIMEOUT=5

# === 스키마 캐시 ===
# 캐시 백엔드: redis | file
SCHEMA_CACHE_BACKEND=redis
# 파일 캐시 디렉토리 (SCHEMA_CACHE_BACKEND=file 시)
SCHEMA_CACHE_CACHE_DIR=.cache/schema
# 스키마 캐시 활성화 여부
SCHEMA_CACHE_ENABLED=true
# 컬럼 설명 자동 생성 여부 (LLM 사용)
SCHEMA_CACHE_AUTO_GENERATE_DESCRIPTIONS=true

# === 동의어 매칭 보강 (Plan 61 트랙 B / D-075) ===
# 전 기능 기본 OFF — 활성 전에는 기존 정확일치 경로가 바이트 단위 무변경(회귀 0).
# 주의: .env 계열 파일에는 인라인 주석 금지(값 뒤 # 금지). 설명은 반드시 별도 줄.
# E5-1 유연 매칭(자모 분해·편집거리·부분어) on/off
# 활성화 예: SYNONYM_FUZZY_MATCH=true — 배선 지점은 field_mapper(폼필 헤더 매핑)와
#   schema_analyzer allowed_tables 보완. 텍스트 질의의 EAV 매핑은 LLM 프롬프트 의존이라 무관.
SYNONYM_FUZZY_MATCH=false
# E5-2 실측 값 검색(distinct resource_type·EAV NAME 인덱싱·검색) on/off
SYNONYM_VALUE_RETRIEVAL=false
# E5-4 임베딩 의미 검색 — 보류(자리예약, 미구현). 항상 false.
SYNONYM_SEMANTIC_MATCH=false
# 퍼지/의미 매칭 확정 신뢰도 임계(이하는 확정 매핑 아닌 후보 제시)
SYNONYM_MATCH_CONFIDENCE_MIN=0.85
# E5-3 유사어 보완 테이블 상한(D-051, 기본 15). 낮추면 토큰↓·리콜↓
SYNONYM_MAX_SYNONYM_SUPPLEMENT_TABLES=15
# E5-3 사전 위생·거버넌스 마스터 스위치(유사어 메타 추적·충돌 우선순위). 기본 OFF=저장 무변경
SYNONYM_GOVERNANCE=false
# 장기 미사용 감쇠/정리 임계(일). governance ON + 명시적 prune 호출 시에만 적용
SYNONYM_DECAY_DAYS=180

# === 시맨틱 모델 결정적 SQL 조합 (Plan 61 트랙 C / D-076) ===
# 전 기능 기본 OFF — 활성 전에는 기존 SQL 생성 경로가 바이트 단위 무변경(회귀 0).
# 주의: .env 계열 파일에는 인라인 주석 금지(값 뒤 # 금지). 설명은 반드시 별도 줄.
# E6 결정적 조합 경로 전체 스위치(커버리지 내 정형 질의는 시맨틱 모델로 결정적 컴파일)
# 활성화 예: TEXT2SQL_SEMANTIC_COMPOSE=true — db_id별 시맨틱 모델 파일
#   config/semantic_models/<db_id>.yaml 이 있는 DB에서만 컴파일 시도(없으면 기존 경로).
#   커버리지 밖(서버명 필터·LOB 속성·80% 임계·동적 기간 등)은 SEMANTIC_FALLBACK으로 라우팅.
TEXT2SQL_SEMANTIC_COMPOSE=false
# 커버리지 밖 라우팅(3단 폴백). 트랙 A 착수로 기본값 candidate_then_human 전환.
# 값: candidate_then_human(트랙 A→저신뢰 시 사람검토) | llm(과도기 자유생성) | human(항상 검토).
# multi_candidate OFF이면 candidate_then_human/human은 llm으로 우아하게 강등(회귀 0).
TEXT2SQL_SEMANTIC_FALLBACK=candidate_then_human
# 3단 폴백 2차 게이트 — 트랙 A 선택 신뢰도 임계(미달 시 사람검토 강등). 0.0=전패 시에만 강등
TEXT2SQL_FALLBACK_CONFIDENCE_MIN=0.0

# === 다중 후보 생성·선택 (Plan 61 트랙 A / D-073·D-074) ===
# 전 기능 기본 OFF — 활성 전에는 기존 단일 생성 경로가 바이트 단위 무변경(회귀 0).
# 주의: .env 계열 파일에는 인라인 주석 금지(값 뒤 # 금지). 설명은 반드시 별도 줄.
# E2/E4 다중 후보 경로 전체 스위치(N개 후보 생성 → 실행기반 선택)
TEXT2SQL_MULTI_CANDIDATE=false
# 후보 수 N(비용 무제한 §9-4 — E1 하네스로 이득 곡선 측정 후 상향)
TEXT2SQL_CANDIDATE_COUNT=3
# 다양화 방식: multi_prompt(현행/분할정복/실행계획 CoT) | temperature(재샘플 보조)
TEXT2SQL_CANDIDATE_STRATEGIES=multi_prompt
# E3 복잡도 게이트: true면 복잡 질의만 다중 후보(단순 질의는 단일 — 품질 목적, 비용 컷 아님)
TEXT2SQL_COMPLEXITY_GATE=false
# E4 선택 전략: hybrid(결과일관성 1차 + LLM 쌍대비교 병용) | consistency | llm
TEXT2SQL_SELECTION=hybrid

# === 실행 경로 (오케스트레이션 사다리) ===
# 아래 세 플래그는 대등한 스위치가 아니라 **1 정본 + 3 폴백 사다리**를 만든다.
# 상위 단이 성립하면 하위 단은 노드조차 등록되지 않는다(빌드 타임 배타).
#   1단 deep_agent  <- ENABLE_DEEPAGENTS_PACKAGE + 오케스트레이터 가용 + 패키지 조립 성공
#   2단 intent_orchestration <- ENABLE_INTENT_ORCHESTRATION
#   3단 semantic_router      <- ENABLE_SEMANTIC_ROUTING
#   4단 legacy               <- 위 셋 모두 불성립
# 확정된 단은 기동 로그 '오케스트레이션 사다리 확정: tier=... degraded_reason=...'로 확인한다.
# 구조·강등 사유·모듈 의존 방향(상위 단이 하위 단 모듈을 재사용)은
# docs/21_orchestration_ladder.md가 단일 출처다. 경로 폐기 전 반드시 읽을 것.

# === 시멘틱 라우팅 (멀티 DB) ===
# true: 멀티 DB 시멘틱 라우팅 활성화 (ACTIVE_DB_IDS가 있으면 자동 활성화)
ENABLE_SEMANTIC_ROUTING=false
# 활성 DB ID 목록 (쉼표 구분, MCP 서버에 등록된 소스명과 일치해야 함)
# ACTIVE_DB_IDS=polestar_b0,polestar_cm_gp,polestar_cm_yd

# === 의도 분해 오케스트레이션 = 사다리 2단 / 트랙 A (Plan 48 / D-037) ===
# 복합 의도를 sub-task로 분해하여 순차/병렬/데이터-의존 실행.
# 미입력(아래 줄 주석 유지) 시 멀티 DB 환경에서 '신규 경로가 기본 동작'한다.
#   - 강제 비활성(기존 semantic_router로 회귀): ENABLE_INTENT_ORCHESTRATION=false
#   - 강제 활성: ENABLE_INTENT_ORCHESTRATION=true
# 구 이름 ENABLE_DEEPAGENT_ORCHESTRATION도 계속 인식한다(하위호환). **2027-02-20 폐기 예정** —
# 두 키를 동시에 두지 말 것: 신 이름이 우선하므로 구 키 수정이 무시된다.
# semantic_routing과 상호 배타 — 둘 다 활성이면 orchestration이 우선한다.
# ENABLE_INTENT_ORCHESTRATION=true

# === deepagents 실제 패키지 — 트랙 B (Plan 49 / D-037) ===
# vLLM 오케스트레이터(tool-calling) + FabriX 워커(실질 응답처리) 분리 도입.
# 명시적 opt-in(기본 false) — vLLM 인프라가 필요하므로 자동 활성화하지 않는다.
# true + vLLM 가용 시 트랙 B, 그 외(false 또는 vLLM 미서빙)는 semantic_router 사용(가용성 분기).
# ENABLE_DEEPAGENTS_PACKAGE=true
# 오케스트레이터 provider: vllm(운영) | gemini(테스트/PoC 전용 — 외부 egress 필요, 폐쇄망 부적합)
ORCHESTRATOR_PROVIDER=vllm
# vLLM (OpenAI 호환) 오케스트레이터 — Qwen3.5-9B 서빙 엔드포인트
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_MODEL=Qwen3.5-9B
# vLLM은 보통 API 키 불필요 (필요 시 .encenv에서 ORCHESTRATOR_API_KEY 관리)
# ORCHESTRATOR_TIMEOUT=120
# ORCHESTRATOR_HEALTH_TIMEOUT=3
# 제어 평면 그래프 순회 상한(LangGraph recursion_limit). 도구 호출 단계가 많은 복합 질의에서
# GraphRecursionError가 발생하면 상향한다.
# ORCHESTRATOR_RECURSION_LIMIT=25
# SSL 인증서 검증(D-060). 목적지 vLLM이 443을 listen하되 유효 인증서를 쓰지 않는 폐쇄망이면
# false로 설정하여 health check·tool-calling 요청의 SSL 검증을 건너뛴다(미설정 시 true).
# ORCHESTRATOR_VERIFY_SSL=false
#
# [테스트 모드] vLLM 없이 Gemini로 deepagents 파이프라인 검증 (Plan 49 §4.7):
#   ORCHESTRATOR_PROVIDER=gemini
#   ORCHESTRATOR_MODEL=gemini-2.5-pro
#   API 키는 LLM_GEMINI_API_KEY(GOOGLE_API_KEY) 재사용 (또는 ORCHESTRATOR_API_KEY 별도 지정)

# === Polestar 전용 프롬프트 ===
# Polestar EAV 구조 전용 시스템 프롬프트를 적용할 DB ID
# ACTIVE_DB_IDS에 포함된 DB 중 Polestar 전용 프롬프트를 적용할 DB ID (콤마 구분)
# 비어있으면 모든 DB에 범용 프롬프트 적용
# 로컬 샌드박스(polestar)도 폴스타 계열 — 포함해야 폴백 LLM 경로에 전용 규칙이 주입됨(D-076 후속3)
POLESTAR_DB_IDS=polestar_b0,polestar_cm_gp,polestar_cm_yd,polestar

# === 멀티턴 대화 / Human-in-the-loop ===
# SQL 실행 전 사용자 승인 요구 여부
ENABLE_SQL_APPROVAL=false
# 대화 세션 최대 턴 수
CONVERSATION_MAX_TURNS=20
# 대화 세션 유효 시간 (시간)
CONVERSATION_TTL_HOURS=24

# ── 알람 분석·발송 기본 설정 (Plan 46 — AlarmWorker) ─────────
# true면 에이전트 서버 기동 시 AlarmWorker가 Redis Stream을 소비한다(기본 비활성 — 옵트인).
# 소켓 수신 서버(폴스타 TCP → Redis 적재)는 별도 설정: alarm_server/alarm_server.env.sample
ALARM_ENABLED=false
# 처리할 최소 심각도 (0=해소, 1=주의, 2=경고, 3=심각).
# ★ 노이즈 게이트(NOISE_ENABLE_NOISE_GATE=true) 활성 시 1 권장 — 아래 Plan 52 섹션 참고.
ALARM_MIN_SEVERITY=2
ALARM_REDIS_STREAM_KEY=alarm:raw
ALARM_REDIS_CONSUMER_GROUP=alarm-workers
# alarm_id 기반 동일 메시지 재처리 방지 TTL
ALARM_DEDUP_TTL_SECONDS=300
# (D-175) 워커 처리 실패 메시지 dead-letter — ACK 폐기 전에 원문+사유를 별도 스트림에 보관.
# 진단: redis-cli XRANGE alarm:dead - + COUNT 20 / 재처리: 원문 data를 alarm:raw에 다시 XADD. (상시 동작)
ALARM_DEAD_LETTER_STREAM_KEY=alarm:dead
# dead-letter 스트림 근사 상한(XADD MAXLEN ~)
ALARM_DEAD_LETTER_MAXLEN=1000
# (D-179) hostname → 폴스타 등록 서버명·IP 역조회(cmm_resource). 폴스타 템플릿이 platformName/
# ipAddress를 지원하지 않아 알람에는 hostname만 실린다 — 공동존(name≠hostname) 식별·이력 매칭용. (상시 동작)
# 역조회 전체 타임아웃(초) — 초과 시 이벤트 값 유지(graceful)
ALARM_SERVER_IDENTITY_TIMEOUT_SECONDS=3.0
# 역조회 결과 Redis 캐시 TTL(초, 0=미캐시)
ALARM_SERVER_IDENTITY_CACHE_TTL_SECONDS=3600
# 발송 채널 (CSV — 현재 지원: workb, webhook)
ALARM_NOTIFICATION_CHANNELS_CSV=workb
# Generic Webhook 채널 (비어있으면 webhook 채널 자동 무시)
ALARM_WEBHOOK_URL=
ALARM_WEBHOOK_TIMEOUT_SECONDS=10

# ── worKB(사내메신저) 쪽지 발송 채널 설정 ─────────
# bearer 토큰은 민감정보 — .encenv에 WORKB_BEARER_TOKEN으로 저장 (.encenv.example 참고)
# (주의) 빈 값 뒤 인라인 주석은 값으로 파싱되므로 주석은 별도 줄에 둔다.
# base_url 예: http://kbone-portal.internal:28080
WORKB_BASE_URL=
# 시스템 구분자 (worKB 관리자 발급)
WORKB_SYSTEM_DIV=
# 발송자 사번
WORKB_SEND_ID=
# 기본 수신자 사번 목록 (쉼표 구분)
WORKB_USER_IDS_CSV=
# 심각도 3 전용 수신자 (비면 기본 수신자)
WORKB_CRITICAL_USER_IDS_CSV=
# 심각도 2 전용 수신자 (비면 기본 수신자)
WORKB_WARNING_USER_IDS_CSV=
# 쪽지 제목 접두어
WORKB_ALIAS=[인프라알람]
WORKB_TIMEOUT_SECONDS=10

# ── 알람 이력 패턴 분석 (Plan 47) ─────────
ALARM_HISTORY_ENABLED=true
# 조회 기간(일): 90=일·주·월 주기 판정 가능(기본), 월 주기 작업이 많으면 180
ALARM_HISTORY_LOOKBACK_DAYS=90
ALARM_HISTORY_MAX_ROWS=2000
ALARM_HISTORY_CACHE_TTL_SECONDS=300
ALARM_ENRICH_TIMEOUT_SECONDS=5
ALARM_BURST_THRESHOLD_24H=5

# ── 알람 영향 프로세스 보강 (Plan 47-1) ─────────
# CPU/메모리 발생 알람 시점에 폴스타 실시간 프로세스 API를 hostname으로 조회.
# 내부망 시스템 — http://, 인증 불필요. CSV는 db_id=base_url 형식 (JSON 아님).
# 코드 기본값은 공란이다(운영 호스트 하드코딩 제거 — Plan 67 Phase 0 ⑪).
# 아래 CSV를 설정하지 않으면 해당 db_id의 프로세스 보강이 비활성된다.
ALARM_PROCESS_ENRICH_ENABLED=true
ALARM_PROCESS_API_BASE_URLS_CSV=polestar_cm_gp=http://polestar.kbonecloud.com,polestar_cm_yd=http://yd-polestar.kbonecloud.com,polestar_b0=http://10.37.16.51:9010
ALARM_PROCESS_API_TIMEOUT_SECONDS=3
ALARM_PROCESS_TOP_N=5

# ── 알람 노이즈 캔슬링 게이트 (Plan 52, 기본 비활성 — 옵트인) ─────────
# enable_noise_gate=false면 기존 알람 발송 경로가 무변경(회귀 0). true로 켜면 4-티어
# (PAGE/TICKET/DASHBOARD/SUPPRESS) 발송 판단 게이트가 작동한다.
# ★ 게이트 활성 시 ALARM_MIN_SEVERITY=1 권장(§4.8): 게이트가 강등·억제를 수행하므로
#   주의(severity 1)까지 게이트에 도달해야 매트릭스 하단 행이 동작한다.
#   (severity 0 해소·severity 3 심각은 워커·게이트 어디서도 드롭하지 않음)
NOISE_ENABLE_NOISE_GATE=false
# ── E1 (현재 구현) ──
# 억제 허용 상한 (심각도 3은 항상 PAGE)
NOISE_SUPPRESS_MAX_SEVERITY=2
# IMPORTANCE_ID 코드→라벨 매핑(인스턴스별 확정 필요, 빈값=전부 보통취급). 예: 1=낮음,2=보통,3=높음
NOISE_IMPORTANCE_VALUE_MAP_CSV=
# 자가복구 상관 창(발생+해소 매칭)
NOISE_SELF_HEAL_WINDOW_SECONDS=300
# 재발생 재통보 간격(4h, 핑거프린트 dedup TTL)
NOISE_REPEAT_INTERVAL_SECONDS=14400
NOISE_NOISE_CONTEXT_TIMEOUT_SECONDS=3.0
NOISE_NOISE_CONTEXT_CACHE_TTL_SECONDS=300
# 독립 해소(severity 0)를 DASHBOARD로 표시할지
NOISE_RESOLVED_TO_DASHBOARD=false
NOISE_DECISION_STORE_PATH=logs/alarm_decisions.jsonl
NOISE_DECISION_STORE_ENABLED=true
# ── E2 (의존성 억제·인히비션 구현, 그 외 자리예약) ──
NOISE_DEBOUNCE_SECONDS=0
NOISE_FLAP_HIGH_THRESHOLD=20.0
NOISE_FLAP_LOW_THRESHOLD=5.0
# (E2) 플래핑 억제 on/off (상태 진동 시 안정화까지 보류)
NOISE_FLAPPING_ENABLED=false
# (E2) 부모 리소스 비정상 시 자식 연쇄 노이즈 억제
NOISE_DEPENDENCY_SUPPRESSION=false
# (E2) 동일 서버 상위 심각도 발생 중 하위 음소거
NOISE_INHIBITION_ENABLED=false
# (E2) 상위 심각도 활성 간주 창
NOISE_INHIBITION_WINDOW_SECONDS=300
# (E2) 스톰 그룹핑 on/off (동일 서버 다발 시 대표 외 억제)
NOISE_STORM_GROUPING_ENABLED=false
# (E2) 스톰 사건창(초)
NOISE_STORM_WINDOW_SECONDS=60
# (E2) 창 내 이 수 초과 시 스톰
NOISE_STORM_THRESHOLD=5
# (§6.1) 심각도3 재통보 간격(기본=공통 4h, 운영서 단축 가능)
NOISE_SEV3_REPEAT_INTERVAL_SECONDS=14400
# ── E3 (AI 심각도 보강·메타모니터링·운영지표·TICKET 일배치 큐 구현) ──
# (자리예약, 미구현) 시간대 강등용
NOISE_BUSINESS_HOURS_CSV=
# (E3) 억제율 이 값 초과 시 메타경보
NOISE_META_ALERT_SUPPRESS_RATIO=0.9
# (E3) 메타경보·운영지표 집계 창(1h)
NOISE_META_ALERT_WINDOW_SECONDS=3600
# (E3) 창 내 이벤트 수가 이 값 미만이면 무수신 메타경보
NOISE_META_ALERT_MIN_EVENTS=1
# (E3) AI 메시지 심각도 보강(상향 전용, 메시지형 알람 한정)
NOISE_ENABLE_AI_SEVERITY_BOOST=false
# (E3) 상향만(하향 억제 금지) — 안전 고정
NOISE_AI_SEVERITY_ESCALATE_ONLY=true
# (E3) TICKET 일배치 요약 큐
NOISE_TICKET_BATCH_QUEUE_PATH=logs/alarm_ticket_queue.jsonl
# (E3) TICKET 티어를 일배치 요약 큐에 적재
NOISE_TICKET_BATCH_QUEUE_ENABLED=true
# (E3 후속) 워커→UI 실시간 SSE Redis pub/sub 브리지 on/off
NOISE_SSE_BRIDGE_ENABLED=false
# (E3 후속) SSE 브리지 Redis pub/sub 채널명
NOISE_SSE_BRIDGE_CHANNEL=alarm:sse
# (D-049) ack/incident 라이프사이클 계측 on/off (MTTA/MTTR/사건전환율)
NOISE_INCIDENT_TRACKING_ENABLED=false
# (D-049) incident 이벤트 Redis pub/sub 채널명
NOISE_INCIDENT_EVENT_CHANNEL=alarm:incident
# (E4) LLM 피드백 few-shot 액션가능성 판단(기본 off)
NOISE_ENABLE_LLM_ACTIONABILITY=false
# (E4) 운영자 피드백 JSONL 저장 경로
NOISE_FEEDBACK_STORE_PATH=logs/alarm_feedback.jsonl
# (E4) 피드백 적재 on/off
NOISE_FEEDBACK_STORE_ENABLED=true
# (E4) few-shot 예시 최대 개수
NOISE_ACTIONABILITY_FEWSHOT_COUNT=3
# ── E5: deepagents Advisory Enricher (agentic 보조 분석기, D-048.7, 기본 off) ──
# off면 E1~E4 배선·발송 판단 무변경. 판단은 결정적 게이트가 하고 enricher는 승격 전용 보조만.
# 트랙 B(agentic tool-calling)는 ORCHESTRATOR_PROVIDER=vllm(health OK) 또는 =gemini(+키)일 때 동작.
#   → vLLM 없이 Gemini API로 트랙 B 테스트: ORCHESTRATOR_PROVIDER=gemini + LLM_GEMINI_API_KEY 설정
#     (test_agentic_enricher_gemini_live.py 는 키 있으면 실 Gemini로 실행, 없으면 skip).
# (E5) 보조 분석기 옵트인
NOISE_ENABLE_AGENTIC_ENRICHER=false
# (E5) vLLM 미서빙 시: semantic_routing | deterministic_only
NOISE_AGENTIC_ENRICHER_FALLBACK=semantic_routing
# (E5) enricher 전체 타임아웃(초, 초과 시 no-op)
NOISE_AGENTIC_ENRICHER_TIMEOUT_SECONDS=8.0
# (E5) 트랙 B ReAct 루프 도구 호출 상한
NOISE_AGENTIC_ENRICHER_MAX_TOOL_CALLS=5
# (E5) LogMonitor/보안/앱 로그 한정
NOISE_AGENTIC_ENRICHER_MESSAGE_ALARMS_ONLY=true

# ══ Plan 60 노이즈 캔슬링 정밀화 (D-106~D-114) — 전부 옵트인·기본 off ══
# off 상태에서 현행 게이트와 비트동일(회귀 0, test_plan60_flags_off_regression.py 고정).
# 검증 방법: docs/20_plan60_feature_test_guide.md / 아래 E1~E6 번호는 Plan 60 기준(위 Plan 52 E5와 무관)

# ── Plan 60 E1: 재발생 억제 감사 (D-106) — dedup TTL은 위 NOISE_REPEAT_INTERVAL_SECONDS ──
# (P60 E1) 재발생 억제 감사 적재 샘플링(1=매번, N이면 count%N==0만 적재)
NOISE_RECURRENCE_AUDIT_EVERY_N=1

# ── Plan 60 E2: 크로스-호스트 상관 (D-109) — db_id(존) 경계 내만, 존 간 상관 금지 ──
# (P60 E2) 크로스-호스트 상관 on/off
NOISE_CROSS_HOST_CORRELATION_ENABLED=false
# (P60 E2) Jaccard 필드유사도 임계(이상이면 동일 클러스터)
NOISE_CORRELATION_SIM_THRESHOLD=0.5
# (P60 E2) 상관 사건창(초)
NOISE_CORRELATION_WINDOW_SECONDS=120
# (P60 E2) 대표 포함 이 수 이상 멤버부터 억제 개시
NOISE_CORRELATION_MIN_CLUSTER_SIZE=2
# (P60 E2) 스코프별 활성 클러스터 상한(메모리 가드)
NOISE_CORRELATION_BUFFER_MAX=1000
# (P60 E2·D-112) E4 토폴로지 인접 클러스터 유사도 보너스 on/off (상관의 하위 옵트인)
NOISE_CORRELATION_TOPOLOGY_WEIGHT_ENABLED=false
# (P60 E2·D-112) 인접 보너스 크기
NOISE_CORRELATION_TOPOLOGY_WEIGHT=0.2

# ── Plan 60 E3: 동적 baseline 이상탐지 (D-110) — 상향 전용·게이트 무변경 ──
# (P60 E3) 동적 baseline on/off — 반영에는 NOISE_ENABLE_AI_SEVERITY_BOOST=true도 필요(AND 조건)
NOISE_DYNAMIC_BASELINE_ENABLED=false
# (P60 E3) 잔차 z-score 상향 임계
NOISE_ANOMALY_Z_HIGH=3.0
# (P60 E3) 적합 최소 주기 수(미만이면 계산 skip)
NOISE_ANOMALY_MIN_PERIODS=3
# (P60 E3) baseline 파라미터 Redis 캐시 TTL(초)
NOISE_ANOMALY_BASELINE_CACHE_TTL_SECONDS=3600
# (P60 E3 2차·D-113) STL 분해 이상탐지 — statsmodels 필요(pip install ".[stl]"), 미설치 시 HW 폴백
NOISE_ANOMALY_STL_ENABLED=false
# (P67 R3-v) 알람 kind→메트릭 소스 매핑 오버라이드 "kind=resource_type:definition_name,…"
# 빈값이면 어댑터 기본 매핑(cpu=server.Cpus:Utilization, memory=server.Memory:Utilization)
NOISE_ANOMALY_METRIC_SOURCE_MAP_CSV=

# ── Plan 67 R3-(v): 운영자 주석 3분류 LLM 전환 (D-132) — 기본 OFF ──
# ⚠ true로 켜면 알람 유입량만큼 LLM 호출(과금)이 발생한다 — 전환은 운영 결정(D-127).
# OFF면 기존 정규식 분류가 그대로 쓰이고, ON에서도 실패·타임아웃 시 정규식으로 강등된다.
NOISE_ANNOTATION_LLM_CLASSIFICATION_ENABLED=false
# (P67 R3-v) 분류 1건 타임아웃(초) — 초과 시 정규식 분류로 강등
NOISE_ANNOTATION_LLM_TIMEOUT_SECONDS=3.0
# (P67 R3-v) 주석 해시 캐시 항목 상한(0=캐시 비활성)
NOISE_ANNOTATION_LLM_CACHE_MAX=500
# (P67 R3-v) 캐시 항목 TTL(초, 0=만료 sweep 비활성)
NOISE_ANNOTATION_LLM_CACHE_TTL_SECONDS=3600

# ── Plan 60 E4: 토폴로지 다홉 연쇄 억제 (D-107) — root 통보 확인 시 SUPPRESS, 미확인 시 DASHBOARD ──
# (P60 E4) 다홉 연쇄 억제 on/off
NOISE_MULTI_HOP_CASCADE_ENABLED=false
# (P60 E4) 정적 엣지 그래프 캐시 TTL(초, 24h)
NOISE_TOPOLOGY_CACHE_TTL_SECONDS=86400
# (P60 E4) BFS 홉 상한
NOISE_TOPOLOGY_MAX_HOPS=5

# ── Plan 60 E5: 변경 상관 (D-111) — 폴스타 변경이력 read-only 오버레이 ──
# (P60 E5) 변경 상관 on/off
NOISE_CHANGE_CORRELATION_ENABLED=false
# (P60 E5) 알람 직전 이 창(초) 내 변경만 원인 후보로 오버레이
NOISE_CHANGE_WINDOW_SECONDS=3600

# ── Plan 60 E6: 통보 컨텍스트 보강 L1 (D-108) — post-gate·본문 첨부만(판정 불변) ──
# (P60 E6) 메시지 기반 L1 보강 첨부 on/off (프로세스 스냅샷 자체는 ALARM_PROCESS_ENRICH_ENABLED)
NOISE_MESSAGE_ENRICHMENT_ENABLED=false

# ── Plan 60 B-7: 로컬 임베딩 주석 (D-114) — 주석 전용·판정 불변(D-035)·런타임 다운로드 금지 ──
# 모델 설치·배치: docs/19_embedding_model_install_guide.md (확정 모델: multilingual-e5-small)
# (P60 B-7 L-2) 의미적 근접중복 주석 on/off
NOISE_SEMANTIC_DEDUP_ANNOTATION_ENABLED=false
# (P60 B-7 L-4) 토폴로지+텍스트 융합 주석 on/off
NOISE_TOPOLOGY_TEXT_FUSION_ENABLED=false
# (P60 B-7) 로컬 모델 디렉토리 절대경로 — 미설정/비디렉토리면 임베딩 inert
NOISE_EMBEDDING_MODEL_PATH=
# (P60 B-7 L-2) 근접중복 주석 임계 — e5-small 실측 0.87 (bge-m3 교체 시 ~0.65 재튜닝)
NOISE_EMBEDDING_SIMILARITY_THRESHOLD=0.87
# (P60 B-7) 임베딩 hot-path 예산(초)
NOISE_EMBEDDING_TIMEOUT_SECONDS=2.0

# ═══ 실시간 사용률 API (Plan 71 / D-144 — 폴스타 measurement REST) ═══
# "실시간/현재/지금" + CPU/메모리 질의를 SQL 대신 폴스타 measurement API로 조회한다(B안 게이트).
# ★ 기본 off — 활성화하려면 아래 한 줄을 true로 (off면 기존 SQL 경로 무변경, 회귀 0).
POLESTAR_REST_REALTIME_USAGE_ENABLED=false
# db_id=base_url CSV. 은행존(b0)은 포트 9010 명시 필수 (Plan 75 §1.3-5 실측).
# 주석은 별도 줄에만 작성할 것 (.env 인라인 주석 금지 — Known Mistakes)
POLESTAR_REST_BASE_URLS_CSV=polestar_b0=http://10.37.16.51:9010,polestar_cm_gp=http://polestar.kbonecloud.com,polestar_cm_yd=http://yd-polestar.kbonecloud.com
# measurement 전용 타임아웃(초) — 프로세스 API(3s)와 별도. gp 200대 실측 2.46s라 여유 확보.
POLESTAR_REST_MEASUREMENT_TIMEOUT_SECONDS=10
# 1콜당 서버 수(청크). 200대/콜 실측 확정 — URL 길이·응답 크기 안전 범위.
POLESTAR_REST_MEASUREMENT_CHUNK_SIZE=200
# 수집 시각(time)이 이보다 오래되면 "수집 지연" 표기(분).
POLESTAR_REST_STALE_AFTER_MINUTES=15

# NOTE: DB 연결 문자열은 MCP 서버 VM에서 관리합니다.
# MCP 서버 설정: mcp_server/config.toml + mcp_server/.env

# ── DRM 해제 (Plan 74 / D-156) — Softcamp ServiceLinker(scsl.jar) 연동 ──
# 기본 false=Passthrough(현행 동일). 운영(RHEL 9.6)에서만 단계적 활성화(계획서 §4.1).
# 주의: softcamp.properties의 내용(LinkSystemIP 등)은 scsl이 직접 읽음 — env로 대체 불가, 경로만 지정.
DRM_ENABLED=false
DRM_JAVA_BIN=java
DRM_WRAPPER_PATH=/opt/collectorinfra/tools/drm-wrapper/Decrypt.java
DRM_SCSL_JAR_PATH=/home/softcamp/02_Module/02_ServiceLinker/scsl.jar
DRM_PROPERTIES_PATH=/home/softcamp/02_Module/02_ServiceLinker/softcamp.properties
DRM_KEY_FILE_PATH=/home/softcamp/04_KeyFile/keyDAC_SVR0.sc
DRM_GROUP_ID=SECURITYDOMAIN
DRM_TEMP_DIR=
DRM_TIMEOUT_SEC=20
