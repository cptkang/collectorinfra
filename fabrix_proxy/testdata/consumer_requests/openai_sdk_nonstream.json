{
  "consumer": "openai_sdk_nonstream",
  "description": "openai AsyncOpenAI chat.completions.create(tools=…) 비스트림",
  "fake_base_url": "http://127.0.0.1:<port>/v1",
  "versions": {
    "python": "3.13.1",
    "openai": "2.42.0",
    "langchain-openai": "1.3.2",
    "langchain-core": "1.4.7",
    "langchain": "1.3.9",
    "langgraph": "1.2.5",
    "deepagents": "0.6.10",
    "httpx": "0.28.1",
    "litellm": "not installed"
  },
  "error": null,
  "requests": [
    {
      "seq": 1,
      "case": "tool_call_turn",
      "method": "POST",
      "path": "/v1/chat/completions",
      "header_names": [
        "accept",
        "accept-encoding",
        "authorization",
        "connection",
        "content-length",
        "content-type",
        "host",
        "user-agent",
        "x-stainless-arch",
        "x-stainless-async",
        "x-stainless-lang",
        "x-stainless-os",
        "x-stainless-package-version",
        "x-stainless-read-timeout",
        "x-stainless-retry-count",
        "x-stainless-runtime",
        "x-stainless-runtime-version"
      ],
      "body": {
        "messages": [
          {
            "role": "user",
            "content": "What is the weather in Springfield right now?"
          }
        ],
        "model": "fabrix-tools",
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "lookup_weather",
              "description": "Look up the current weather for a city.",
              "parameters": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string",
                    "description": "City name"
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "celsius",
                      "fahrenheit"
                    ]
                  }
                },
                "required": [
                  "city"
                ]
              }
            }
          },
          {
            "type": "function",
            "function": {
              "name": "get_order_status",
              "description": "Get the shipping status of an order.",
              "parameters": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string"
                  },
                  "include_items": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "order_id"
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
