# fabrix_proxy 설정 예시 (plans/148) — 복사해 fabrix_proxy/.env로 쓴다.
# 인라인 주석 금지. list/dict 값은 JSON으로 적는다. 자격증명 값은 .env/.encenv에만 둔다.

# 프록시 표면 — 토큰이 비면 기동을 거부한다
FABRIX_PROXY_TOKEN=
FABRIX_PROXY_HOST=127.0.0.1
FABRIX_PROXY_PORT=9095
FABRIX_PROXY_LOG_LEVEL=INFO
FABRIX_PROXY_MODEL_ALIASES=["fabrix-tools"]

# 업스트림 FabriX KBGenAI
FABRIX_BASE_URL=
FABRIX_API_KEY=
FABRIX_CLIENT_KEY=
# KBGenAI modelId(asset_id)
FABRIX_MODEL=
FABRIX_VERIFY_SSL=false
FABRIX_TIMEOUT=300
FABRIX_TOTAL_TIMEOUT=300
# D-194 llmConfig — 비우면 페이로드에 llmConfig를 넣지 않는다. 예: {"temperature": 0.1, "top_p": 0.9}
FABRIX_LLM_CONFIG={}

# passthrough(네이티브 OpenAI 호환 엔드포인트) — 비우면 passthrough 요청은 400
FABRIX_NATIVE_URL=
FABRIX_NATIVE_MODEL=

# 에뮬레이션 선택지 — turns|transcript · en|ko · none|static|dynamic · system|contents
# POC 요청 선택지(fabrix_proxy_options)가 오면 아래 설정보다 항상 우선한다 — protocol_lang만 오면 패키지 기본 규약(PROTOCOL_FILE 무시) · fewshot만 오면 패키지 기본 예시(FEWSHOT_FILE 무시) · passthrough=false면 PASSTHROUGH=true도 끈다
FABRIX_PROXY_CONTENTS_MODE=turns
FABRIX_PROXY_PROTOCOL_LANG=en
FABRIX_PROXY_PROTOCOL_FILE=
FABRIX_PROXY_FEWSHOT=static
FABRIX_PROXY_FEWSHOT_PLACEMENT=system
FABRIX_PROXY_FEWSHOT_FILE=
FABRIX_PROXY_REPAIR_MAX=1
FABRIX_PROXY_PASSTHROUGH=false
# PoC 전용 — 요청별 fabrix_proxy_options 덮어쓰기와 응답 fabrix_proxy_diag 허용
FABRIX_PROXY_POC_MODE=false
