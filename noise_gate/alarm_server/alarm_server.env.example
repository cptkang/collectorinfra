# 알람 소켓 수신 서버 전용 설정
# 복사 후 alarm_server.env로 이름 변경: cp alarm_server.env.example alarm_server.env
ALARM_SERVER_SOCKET_HOST=0.0.0.0
ALARM_SERVER_SOCKET_PORT=9100
ALARM_SERVER_REDIS_HOST=localhost
ALARM_SERVER_REDIS_PORT=6379
ALARM_SERVER_REDIS_DB=0
# ALARM_SERVER_REDIS_PASSWORD=<비밀번호>
ALARM_SERVER_STREAM_KEY=alarm:raw
ALARM_SERVER_LOG_LEVEL=INFO
# 설정 관리 리스너(plans/191) — 포트·토큰이 모두 있을 때만 기동한다. 비우면 미기동(현행 동일).
# 호스트는 기본 127.0.0.1(외부 노출 금지). 토큰은 본체 COMPONENT_ADMIN_TOKENS의 alarm_server 항목과 같은 값을 쓴다.
# ALARM_SERVER_ADMIN_HOST=127.0.0.1
# ALARM_SERVER_ADMIN_PORT=9101
# ALARM_SERVER_ADMIN_TOKEN=<관리 토큰>
