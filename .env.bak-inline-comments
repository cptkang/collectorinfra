# ============================================================
# 인프라 데이터 조회 에이전트 — 환경변수 설정
# ============================================================
# pydantic-settings 규칙:
#   - list[str] 필드는 반드시 JSON 배열 형식 (예: ["a","b"])
#   - bool 필드는 true / false (소문자)
# ============================================================

# === LLM 설정 ===
# LLM 프로바이더 선택 (ollama: 로컬/원격 Ollama | fabrix: FabriX 클라우드 | gemini: Google Gemini API)
LLM_PROVIDER=gemini
# 사용할 LLM 모델명 (Ollama Hub 모델 태그)
# 예: llama3.1:8b, llama3.1:70b, gemma2:9b, gemma3:12b, qwen2.5:14b, qwen3-coder:30b, mistral:7b
#LLM_MODEL=llama3.1:8b
#LLM_MODEL=qwen3-coder:30b
LLM_MODEL=gemma3:12b
# Ollama 서버 주소 (로컬: http://localhost:11434, 원격: http://<host>:11434)
LLM_OLLAMA_BASE_URL=http://localhost:11434
# Ollama 단일 요청 타임아웃 (초)
# 모델 크기·프롬프트 복잡도에 따라 조정. 파이프라인 내 LLM 호출이 여러 번 발생하므로
# 전체 그래프 타임아웃(API_QUERY_TIMEOUT)보다 작게 설정 권장
LLM_OLLAMA_TIMEOUT=600
# Ollama Gateway API 키 → .encenv에서 관리 (LLM_API_KEY)

# Gemini 설정 (LLM_PROVIDER=gemini 시에만 사용)
# API 키는 .encenv 파일에서 관리 (LLM_GEMINI_API_KEY)
# Gemini 모델명 (비어있으면 LLM_MODEL 사용)
# 권장: gemini-2.0-flash (안정), gemini-3.1-pro (최신)
LLM_GEMINI_MODEL=gemini-2.5-flash-lite

# 추천 대체 모델
#  LLM_GEMINI_MODEL=gemini-2.0-flash-001    # 특정 버전 지정
#  LLM_GEMINI_MODEL=gemini-2.5-flash        # 최신 flash 계열
#  LLM_GEMINI_MODEL=gemini-3.1-pro          # docs/decision.md에 이미 권장된 최신 추론 모델
# gemini-2.5-flash-lite

# FabriX 설정 (LLM_PROVIDER=fabrix 시에만 사용)
# FabriX API 엔드포인트 URL
LLM_FABRIX_BASE_URL=
# FabriX API 키 / 클라이언트 키 → .encenv에서 관리 (FABRIX_API_KEY, FABRIX_CLIENT_KEY)
# FabriX 모델명 (비어있으면 LLM_MODEL 값 사용)
LLM_FABRIX_CHAT_MODEL=

# === DB 연결 ===
# DB 접속 방식 (dbhub: MCP 서버 경유, read-only 보장 | direct: PostgreSQL 직접 연결)
DB_BACKEND=dbhub
# direct 모드 시 PostgreSQL 연결 문자열 (형식: postgresql://user:pass@host:port/dbname)
DB_CONNECTION_STRING=postgresql://infra_user:infra_pass_2024@localhost:5434/infradb

# === MCP 서버 (DBHub) 설정 ===
# DB_BACKEND=dbhub 시에만 사용
# MCP 서버 SSE 엔드포인트 URL (mcp_server/.env의 SERVER_PORT와 일치해야 함)
DBHUB_SERVER_URL=http://localhost:9099/sse
# 단일 DB 모드에서 사용할 기본 데이터소스 이름
# ※ 반드시 mcp_server/config.toml의 [[sources]] name 값과 정확히 일치해야 함
# ※ 불일치 시 "알 수 없는 소스" 에러 발생
# 현재 config.toml에 등록된 소스: infra_db, infra_db2, polestar, cloud_portal, itsm, itam
DBHUB_SOURCE_NAME=polestar
# MCP 호출 1회당 전체 대기시간 (초, 네트워크+쿼리 실행 포함)
DBHUB_MCP_CALL_TIMEOUT=600

# 멀티 DB 모드에서 사용할 활성 DB 식별자 목록 (쉼표 구분)
# ※ 반드시 mcp_server/config.toml의 [[sources]] name 값과 정확히 일치해야 함
# ※ 해당 소스의 연결 문자열이 mcp_server/.env에 설정되어 있어야 실제 동작
# 예: ACTIVE_DB_IDS=polestar,cloud_portal,itsm,itam
ACTIVE_DB_IDS=polestar

# === 클라이언트 쿼리 정책 ===
# SQL 생성/검증/실행 실패 시 최대 재시도 횟수 (query_generator ↔ query_validator 루프)
QUERY_MAX_RETRY_COUNT=3
# SQL 생성 시 자동 부여되는 기본 LIMIT 절 값 (대량 조회 방지)
QUERY_DEFAULT_LIMIT=1000

# === 보안 (민감 데이터 마스킹) ===
# 전체 마스킹 대상 컬럼명 목록 (JSON 배열 형식 필수)
# 이 목록에 포함된 컬럼은 조회 결과에서 값이 SECURITY_MASK_PATTERN으로 대체됨
SECURITY_SENSITIVE_COLUMNS=["password","secret","token","api_key","private_key","credential"]
# 마스킹 시 대체되는 문자열
SECURITY_MASK_PATTERN=***MASKED***
# 부분 마스킹 대상 컬럼 (JSON 배열 형식, 예: ["email","phone"])
# 전체가 아닌 일부만 마스킹 (예: user@ex.com → u***@ex.com)
SECURITY_PARTIAL_MASK_COLUMNS=[]
# IP 주소 마스킹 여부 (true: 조회 결과 내 IP를 부분 마스킹)
SECURITY_MASK_IP=false
# 이메일 주소 마스킹 여부 (true: 조회 결과 내 이메일을 부분 마스킹)
SECURITY_MASK_EMAIL=false

# === 체크포인트 (멀티턴 대화 상태 저장) ===
# 저장 백엔드 (sqlite: 파일 기반, 개발용 | postgres: 운영 환경 권장)
CHECKPOINT_BACKEND=sqlite
# SQLite 파일 경로 (상대경로는 프로젝트 루트 기준) 또는 :memory: (메모리 전용, 재시작 시 소멸)
CHECKPOINT_DB_URL=checkpoints.db

# === 로그 ===
# 로그 출력 레벨 (DEBUG: 전체 | INFO: 일반 | WARNING: 경고만 | ERROR: 에러만)
LOG_LEVEL=INFO

# === 운영자 인증 (관리 대시보드 접근용) ===
# 운영자 로그인 아이디
ADMIN_USERNAME=admin
# 운영자 비밀번호 / JWT 시크릿 → .encenv에서 관리 (ADMIN_PASSWORD, ADMIN_JWT_SECRET)
# JWT 토큰 만료 시간 (시간 단위)
ADMIN_JWT_EXPIRE_HOURS=24

# === API 서버 ===
# 바인딩 호스트 (0.0.0.0: 모든 인터페이스 | 127.0.0.1: 로컬만)
API_HOST=0.0.0.0
# 서버 포트
API_PORT=8050
# CORS 허용 오리진 (JSON 배열 형식)
# 개발: ["*"] | 운영: ["https://your-domain.com"]
API_CORS_ORIGINS=["*"]
# 일반 질의(/api/v1/query) 전체 타임아웃 (초)
# LangGraph 그래프 전체 실행 시간 제한. 초과 시 504 Gateway Timeout 반환
API_QUERY_TIMEOUT=240
# 파일 업로드 질의(/api/v1/query/file) 전체 타임아웃 (초)
# 엑셀/Word 템플릿 처리 시 시트별 LLM 호출이 누적되므로 일반 질의보다 넉넉히 설정
# 504 에러 발생 시 이 값을 먼저 늘릴 것
API_FILE_QUERY_TIMEOUT=300

# === Redis (스키마 캐시·유사어 사전 저장소) ===
# Redis 서버 호스트
REDIS_HOST=localhost
# Redis 서버 포트
REDIS_PORT=6380
# 사용할 Redis DB 번호 (0~15)
REDIS_DB=0
# Redis 비밀번호 → .encenv에서 관리 (REDIS_PASSWORD)
# TLS/SSL 암호화 연결 여부 (클라우드 Redis 사용 시 true)
REDIS_SSL=false
# Redis 소켓 읽기/쓰기 타임아웃 (초, 네트워크 지연 고려)
REDIS_SOCKET_TIMEOUT=5

# === 스키마 캐시 ===
# 캐시 저장 백엔드 (redis: Redis 사용 | file: 로컬 파일 사용)
# Redis 장애 시 자동으로 file 폴백
SCHEMA_CACHE_BACKEND=redis
# 파일 캐시 저장 디렉토리 (SCHEMA_CACHE_BACKEND=file 또는 Redis 폴백 시 사용)
SCHEMA_CACHE_CACHE_DIR=.cache/schema
# 스키마 캐시 활성화 여부 (false: 매 요청마다 DB 스키마 조회 — 개발/디버깅용)
SCHEMA_CACHE_ENABLED=true
# 컬럼 설명 자동 생성 여부 (true: LLM으로 컬럼 설명 생성 후 캐시에 저장)
SCHEMA_CACHE_AUTO_GENERATE_DESCRIPTIONS=true

# === 시멘틱 라우팅 (멀티 DB) ===
# 멀티 DB 시멘틱 라우팅 활성화 여부
# true: semantic_router 노드가 질의를 분석하여 적절한 DB로 라우팅
# false: 단일 DB 모드 (ACTIVE_DB_IDS가 설정되어 있으면 자동 true로 전환)
ENABLE_SEMANTIC_ROUTING=true

# === 멀티턴 대화 / Human-in-the-loop ===
# SQL 실행 전 사용자 승인(approve/reject/modify) 요구 여부
# true: query_validator 통과 후 approval_gate에서 대기, 사용자 승인 후 실행
ENABLE_SQL_APPROVAL=false
# 하나의 대화 세션에서 허용되는 최대 턴(질의-응답 쌍) 수
CONVERSATION_MAX_TURNS=20
# 대화 세션 유효 시간 (시간 단위, 초과 시 체크포인트 만료 처리)
CONVERSATION_TTL_HOURS=24

# NOTE: DB 연결 문자열은 MCP 서버 VM에서 관리합니다.
# MCP 서버 설정: mcp_server/config.toml + mcp_server/.env

# === deepagents 의도 분해 오케스트레이션 (Plan 48 / D-037) ===
# 복합 의도를 sub-task로 분해하여 순차/병렬/데이터-의존 실행.
# 미입력(아래 줄 주석 유지) 시 멀티 DB 환경에서 '신규 경로가 기본 동작'한다.
#   - 강제 비활성(기존 semantic_router로 회귀): ENABLE_DEEPAGENT_ORCHESTRATION=false
#   - 강제 활성: ENABLE_DEEPAGENT_ORCHESTRATION=true
# semantic_routing과 상호 배타 — 둘 다 활성이면 orchestration이 우선한다.
ENABLE_DEEPAGENT_ORCHESTRATION=true

# === deepagents 실제 패키지 — 트랙 B (Plan 49 / D-037) ===
# vLLM 오케스트레이터(tool-calling) + FabriX 워커(실질 응답처리) 분리 도입.
# 명시적 opt-in(기본 false) — vLLM 인프라가 필요하므로 자동 활성화하지 않는다.
# true + vLLM 가용 시 트랙 B, 그 외(false 또는 vLLM 미서빙)는 semantic_router 사용(가용성 분기).
ENABLE_DEEPAGENTS_PACKAGE=true
# [테스트 전용] deepagent 경로 전체의 워커(데이터 평면) provider 강제 교체.
#   - 운영: 주석 유지(미설정) → config의 LLM_PROVIDER(보통 fabrix) 그대로 사용.
#   - 테스트: WORKER_PROVIDER_OVERRIDE=gemini → FabriX 없이 deepagent 경로를 gemini로 검증
#     (오케스트레이터는 아래 ORCHESTRATOR_PROVIDER로 별도 지정).
# WORKER_PROVIDER_OVERRIDE=gemini
# 오케스트레이터 provider: vllm(운영) | gemini(테스트/PoC 전용 — 외부 egress 필요, 폐쇄망 부적합)
ORCHESTRATOR_PROVIDER=gemini
# vLLM (OpenAI 호환) 오케스트레이터 — Qwen3.5-9B 서빙 엔드포인트
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_MODEL=gemini-2.5-flash-lite
# vLLM은 보통 API 키 불필요 (필요 시 .encenv에서 ORCHESTRATOR_API_KEY 관리)
# ORCHESTRATOR_TIMEOUT=120
# ORCHESTRATOR_HEALTH_TIMEOUT=3
#
# [테스트 모드] vLLM 없이 Gemini로 deepagents 파이프라인 검증 (Plan 49 §4.7):
#   ORCHESTRATOR_PROVIDER=gemini
#   ORCHESTRATOR_MODEL=gemini-2.5-pro
#   API 키는 LLM_GEMINI_API_KEY(GOOGLE_API_KEY) 재사용 (또는 ORCHESTRATOR_API_KEY 별도 지정)

# ── 알람 노이즈 캔슬링 게이트 (Plan 52, 기본 비활성 — 옵트인) ─────────
# enable_noise_gate=false면 기존 알람 발송 경로가 무변경(회귀 0). true로 켜면 4-티어
# (PAGE/TICKET/DASHBOARD/SUPPRESS) 발송 판단 게이트가 작동한다.
# ★ 게이트 활성 시 ALARM_MIN_SEVERITY=1 권장(§4.8): 게이트가 강등·억제를 수행하므로
#   주의(severity 1)까지 게이트에 도달해야 매트릭스 하단 행이 동작한다.
#   (severity 0 해소·severity 3 심각은 워커·게이트 어디서도 드롭하지 않음)
NOISE_ENABLE_NOISE_GATE=true
# ── E1 (현재 구현) ──
NOISE_SUPPRESS_MAX_SEVERITY=2                               # 억제 허용 상한 (심각도 3은 항상 PAGE)
# IMPORTANCE_ID 코드→라벨 매핑(인스턴스별 확정 필요, 빈값=전부 보통취급). 예: 1=낮음,2=보통,3=높음
NOISE_IMPORTANCE_VALUE_MAP_CSV=
NOISE_SELF_HEAL_WINDOW_SECONDS=300                          # 자가복구 상관 창(발생+해소 매칭)
NOISE_REPEAT_INTERVAL_SECONDS=14400                         # 재발생 재통보 간격(4h, 핑거프린트 dedup TTL)
NOISE_NOISE_CONTEXT_TIMEOUT_SECONDS=3.0
NOISE_NOISE_CONTEXT_CACHE_TTL_SECONDS=300
NOISE_RESOLVED_TO_DASHBOARD=false                           # 독립 해소(severity 0)를 DASHBOARD로 표시할지
NOISE_DECISION_STORE_PATH=logs/alarm_decisions.jsonl
NOISE_DECISION_STORE_ENABLED=true
# ── E2 (의존성 억제·인히비션 구현, 그 외 자리예약) ──
NOISE_DEBOUNCE_SECONDS=0
NOISE_FLAP_HIGH_THRESHOLD=20.0
NOISE_FLAP_LOW_THRESHOLD=5.0
NOISE_FLAPPING_ENABLED=false                                # (E2) 플래핑 억제 on/off (상태 진동 시 안정화까지 보류)
NOISE_DEPENDENCY_SUPPRESSION=false                          # (E2) 부모 리소스 비정상 시 자식 연쇄 노이즈 억제
NOISE_INHIBITION_ENABLED=false                              # (E2) 동일 서버 상위 심각도 발생 중 하위 음소거
NOISE_INHIBITION_WINDOW_SECONDS=300                         # (E2) 상위 심각도 활성 간주 창
NOISE_STORM_GROUPING_ENABLED=false                          # (E2) 스톰 그룹핑 on/off (동일 서버 다발 시 대표 외 억제)
NOISE_STORM_WINDOW_SECONDS=60                               # (E2) 스톰 사건창(초)
NOISE_STORM_THRESHOLD=5                                     # (E2) 창 내 이 수 초과 시 스톰
NOISE_SEV3_REPEAT_INTERVAL_SECONDS=14400                    # (§6.1) 심각도3 재통보 간격(기본=공통 4h, 운영서 단축 가능)
# ── E3 (AI 심각도 보강·메타모니터링·운영지표·TICKET 일배치 큐 구현) ──
NOISE_BUSINESS_HOURS_CSV=                                   # (자리예약, 미구현) 시간대 강등용
NOISE_META_ALERT_SUPPRESS_RATIO=0.9                         # (E3) 억제율 이 값 초과 시 메타경보
NOISE_META_ALERT_WINDOW_SECONDS=3600                        # (E3) 메타경보·운영지표 집계 창(1h)
NOISE_META_ALERT_MIN_EVENTS=1                               # (E3) 창 내 이벤트 수가 이 값 미만이면 무수신 메타경보
NOISE_ENABLE_AI_SEVERITY_BOOST=false                        # (E3) AI 메시지 심각도 보강(상향 전용, 메시지형 알람 한정)
NOISE_AI_SEVERITY_ESCALATE_ONLY=true                        # (E3) 상향만(하향 억제 금지) — 안전 고정
NOISE_TICKET_BATCH_QUEUE_PATH=logs/alarm_ticket_queue.jsonl # (E3) TICKET 일배치 요약 큐
NOISE_TICKET_BATCH_QUEUE_ENABLED=true                       # (E3) TICKET 티어를 일배치 요약 큐에 적재
NOISE_SSE_BRIDGE_ENABLED=false                              # (E3 후속) 워커→UI 실시간 SSE Redis pub/sub 브리지 on/off
NOISE_SSE_BRIDGE_CHANNEL=alarm:sse                          # (E3 후속) SSE 브리지 Redis pub/sub 채널명
NOISE_INCIDENT_TRACKING_ENABLED=false                       # (D-049) ack/incident 라이프사이클 계측 on/off (MTTA/MTTR/사건전환율)
NOISE_INCIDENT_EVENT_CHANNEL=alarm:incident                 # (D-049) incident 이벤트 Redis pub/sub 채널명
NOISE_ENABLE_LLM_ACTIONABILITY=false                        # (E4) LLM 피드백 few-shot 액션가능성 판단(기본 off)
NOISE_FEEDBACK_STORE_PATH=logs/alarm_feedback.jsonl         # (E4) 운영자 피드백 JSONL 저장 경로
NOISE_FEEDBACK_STORE_ENABLED=true                           # (E4) 피드백 적재 on/off
NOISE_ACTIONABILITY_FEWSHOT_COUNT=3                         # (E4) few-shot 예시 최대 개수
# ── E5: deepagents Advisory Enricher (agentic 보조 분석기, D-048.7, 기본 off) ──
# off면 E1~E4 배선·발송 판단 무변경. 판단은 결정적 게이트가 하고 enricher는 승격 전용 보조만.
# 트랙 B(agentic tool-calling)는 ORCHESTRATOR_PROVIDER=vllm(health OK) 또는 =gemini(+키)일 때 동작.
#   → vLLM 없이 Gemini API로 트랙 B 테스트: ORCHESTRATOR_PROVIDER=gemini + LLM_GEMINI_API_KEY 설정
#     (test_agentic_enricher_gemini_live.py 는 키 있으면 실 Gemini로 실행, 없으면 skip).
NOISE_ENABLE_AGENTIC_ENRICHER=false                         # (E5) 보조 분석기 옵트인
NOISE_AGENTIC_ENRICHER_FALLBACK=semantic_routing            # (E5) vLLM 미서빙 시: semantic_routing | deterministic_only
NOISE_AGENTIC_ENRICHER_TIMEOUT_SECONDS=8.0                  # (E5) enricher 전체 타임아웃(초, 초과 시 no-op)
NOISE_AGENTIC_ENRICHER_MAX_TOOL_CALLS=5                     # (E5) 트랙 B ReAct 루프 도구 호출 상한
NOISE_AGENTIC_ENRICHER_MESSAGE_ALARMS_ONLY=true             # (E5) LogMonitor/보안/앱 로그 한정

