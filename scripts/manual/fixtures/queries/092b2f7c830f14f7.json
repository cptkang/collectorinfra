      "db_origin": "classified",
      "generated_sql": "-- cocm-hdkapp01 서버의 IP 주소와 OS 종류 조회\n-- 폴스타(로컬 샌드박스) 전용: 필터는 장비명(name) 사용, 출력은 호스트명(hostname)과 IP(ipaddress) 사용\nSELECT\n  COALESCE(r.name, r.hostname) AS server_name,\n  r.hostname AS os_hostname,\n  r.ipaddress AS ip_address,\n  cc_ostype.stringvalue_short AS os_type\nFROM polestar.cmm_resource r\nLEFT JOIN polestar.core_config_prop cc_ostype\n  ON r.resource_conf_id = cc_ostype.configuration_id\n  AND cc_ostype.name = 'OSType'\nWHERE r.resource_type = 'server.Server'\n  AND r.dtime IS NULL\n  AND (r.name = 'cocm-hdkapp01' OR r.hostname = 'cocm-hdkapp01')\nLIMIT 1000;"
     }
