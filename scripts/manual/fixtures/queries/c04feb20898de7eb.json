      "db_origin": "classified",
      "generated_sql": "-- cocm-hdkapp01 서버의 메모리 용량 조회\n-- 폴스타(로컬 샌드박스) 전용: 서버 식별은 장비명(name) 사용, 호스트명(hostname)은 출력용만 사용\n-- 메모리 용량은 server.Memory 리소스의 EAV 속성 'TotalSize'에서 조회\nSELECT\n    COALESCE(c.platform_resource_id, c.id) AS id,\n    MAX(CASE WHEN c.resource_type = 'server.Server' THEN COALESCE(c.name, c.hostname) END) AS server_name,\n    MAX(CASE WHEN c.resource_type = 'server.Server' THEN c.hostname END) AS hostname,\n    MAX(CASE WHEN c.resource_type = 'server.Memory' AND cc.name = 'TotalSize' THEN cc.stringvalue_short END) AS memory_size\nFROM polestar.cmm_resource c\nLEFT JOIN polestar.core_config_prop cc\n      ON c.resource_conf_id = cc.configuration_id\nWHERE c.resource_type IN ('server.Server', 'server.Memory')\n  AND c.dtime IS NULL\nGROUP BY COALESCE(c.platform_resource_id, c.id)\nHAVING MAX(CASE WHEN c.resource_type = 'server.Server' THEN c.name END) = 'cocm-hdkapp01'\nLIMIT 1000;"
     }
