            "title": "Thread Id"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "결과·작업 소유자(불투명 문자열). 작업 도구는 같은 owner일 때만 응답한다",
            "title": "Owner"
          },
          "wait_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "이 초 안에 끝나지 않으면 작업 핸들(job)을 돌려주고 백그라운드로 계속한다(apm_job_status로 확인). 비우면 끝날 때까지 기다린다",
            "title": "Wait Seconds"
          },
          "targets": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
