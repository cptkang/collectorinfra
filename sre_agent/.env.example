# sre_agent 환경 변수 예시 — 실제 값은 .env에 작성 (커밋 금지)
# 주의: 인라인 주석 금지 — 주석은 반드시 별도 줄에 작성한다.

# 운영 LLM 제공자 API 키 (사용하는 제공자 것만 설정 — OS env/systemd로 주입해야 litellm이 읽는다)
# Anthropic Claude 사용 시
# ANTHROPIC_API_KEY=

# OpenAI 사용 시
# OPENAI_API_KEY=

# HolmesGPT 운영 모델 (litellm 표기)
# 예: anthropic/claude-sonnet-5, openai/gpt-4o
MODEL=anthropic/claude-sonnet-5

# 운영 LLM API 키 (settings.api_key — litellm에 직접 전달, SecretStr. 기본값 None)
# API_KEY=

# 사내 OpenAI 호환 엔드포인트(vLLM 등)의 base_url — litellm api_base로 전달.
# 미설정(None)이면 프로바이더 기본 경로(SaaS). FabriX(KBGenAIChat)는 OpenAI 비호환이라 불가 —
# 조사 LLM은 tool-calling 되는 엔드포인트여야 한다.
# API_BASE=http://vllm-host:8000/v1

# 조사 1건 LLM 호출 step 상한. 상한 도달 시 graceful 반환(하드 실패 금지),
# dispatcher 전체 타임아웃이 하드 백스톱. 다중 메트릭 실측 마진 40
MAX_STEPS=40

# 폴스타 MCP(mcp_server) SSE 엔드포인트 (D-119 — Prometheus 접속 설정은 여기가 아니라
# mcp_server 측 PROMETHEUS_URL로 일원화. sre_agent는 Prometheus 주소를 모른다)
POLESTAR_MCP_URL=http://localhost:9099/sse
# mcp_server 정적 Bearer 토큰 (서버 MCP_BEARER_TOKEN과 일치. 미설정=무인증 로컬 경로)
# POLESTAR_MCP_TOKEN=

# 조사 서비스(interface/mcp_service) 정적 Bearer 토큰 (D-125 — 본체
# NOISE_INVESTIGATION_SERVICE_TOKEN과 일치시킬 것. 미설정=무인증 로컬/개발)
# SERVICE_BEARER_TOKEN=

# ── 조사 dispatcher 폭주 방지 가드 (Plan 02 §4·§10 — 기본 off/보수값) ──
# 조사 1건 전체 타임아웃(초, per-call 아님). MCP 동기 타임아웃(60s)보다 길어야
# submit/poll 비동기 잡 패턴이 성립한다
INVESTIGATION_TIMEOUT_SECONDS=300
# 동일 fingerprint 재조사 최소 간격(초). 미설정(None)=TTL dedup off(활성 fingerprint dedup만).
# ⚠ 숫자 필드 — 빈 값(KEY=)으로 두면 설정 로드가 실패하므로 켤 때만 해제한다
# INVESTIGATION_DEDUP_TTL_SECONDS=600
# 동시 조사 상한(세마포어)
INVESTIGATION_MAX_CONCURRENT=2
# 시간당 조사 횟수 상한. 미설정(None)=예산 가드 off. 초과 시 신규 조사 거부.
# ⚠ 숫자 필드 — 빈 값(KEY=)으로 두면 설정 로드가 실패하므로 켤 때만 해제한다
# INVESTIGATION_HOURLY_BUDGET=20

# 비선두 system 메시지 강등 가드 (D-213). Qwen 템플릿(vLLM)은 system을 맨 앞에만 허용하는데
# holmes 컨텍스트 압축이 말미에 system 안내를 붙여 "System message must be at the beginning."
# 으로 조사가 실패한다. 가드는 0번이 아닌 system의 role만 user로 바꾸고 content는 보존한다.
# ★ 기본 on(명시적 예외) — 교정할 것이 없으면 원본 그대로라 정상 경로는 비트 동일하고,
# off는 곧 "압축 발동 시 실패"를 뜻한다. 만료일 2027-03-11에 유지/삭제 판정.
SYSTEM_MESSAGE_POSITION_FIX=true
# 중요도 2차 판정(severity_judge, escalate-only). 기본 off — off면 게이트 판정 승계
SEVERITY_JUDGE_ENABLED=false
# 조치 권고(remediation_recommender, D-011 제시 전용 — 실행 경로 없음 D-003). 기본 off.
# severity_judge off면 매칭 시그니처가 없어 권고도 비어 있다
REMEDIATION_RECOMMENDER_ENABLED=false

# 개발·테스트 LLM — Gemini API (D-120)
# 외부 SaaS: 개발·테스트 전용, 운영 투입 금지 — 송신 입력은 목업·로컬 픽스처만.
# litellm 1.89.0 실측: 모델 문자열 prefix 'gemini/', 키 GEMINI_API_KEY(또는 LLM_GEMINI_API_KEY).
# 기본값 gemini/gemini-3.5-flash — 2026-07-28 ListModels 실측(2.0-flash는 서버측 퇴역 404,
# 2.5-*는 D-021 사용 금지). settings.py 주석 참조.
INVESTIGATION_LLM_MODEL=gemini/gemini-3.5-flash

# Gemini API 키 (미설정 시 스모크·e2e 보류. 기본값 None)
# GEMINI_API_KEY=

# 조사 지침 추가 문구 (plans/50 G5). 미설정(None)이면 기본 지침(원격 셸 안내·사건 구간·부하 가드)만 주입.
# Plan 51 §6 플레이북을 편입할 때 여기에 넣는다.
# INVESTIGATION_GUIDANCE_EXTRA=

# 사건 구간 증거 사전수집 + 결정적 상관 (plans/50 G4). 기본 false. 켜면 reference_time이 있는 조사에서
# 조사 전에 mcp_server 도구를 코드가 호출해 선행 신호·타임라인을 계산한다(LLM 호출 없음).
EVIDENCE_CORRELATION_ENABLED=false
EVIDENCE_BASELINE_PERIODS=24
# 사전수집 MCP 호출 **1건당** 상한(초). 배치 전체 wedge는 dispatcher가 별도로 끊는다(D-211)
EVIDENCE_PREFETCH_TIMEOUT_SECONDS=20.0
# 변경 이벤트 오버레이 (plans/91 1-2 · D-209). 켜면 사전수집 배치 말미에 polestar_change_history를
# 1건 더 불러 "변경 직후" 가설을 rank 1(confidence medium)로 세운다. 만료일 2027-03-10
EVIDENCE_CHANGE_OVERLAY_ENABLED=false
# 연관 호스트 알람 소비 대수 (plans/91 1-3 · D-209). 0=off. 게이트가 넘긴 root 서버의 알람만
# 배치 말미에 1건 조회한다(지표는 대표 서버만 — U-I 확정). 만료일 2027-03-10
EVIDENCE_CORRELATION_RELATED_HOSTS=0
