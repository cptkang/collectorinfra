# sre_agent 환경 변수 예시 — 실제 값은 .env에 작성 (커밋 금지)
# 주의: 인라인 주석 금지 — 주석은 반드시 별도 줄에 작성한다.

# 운영 LLM 제공자 API 키 (사용하는 제공자 것만 설정 — OS env/systemd로 주입해야 litellm이 읽는다)
# Anthropic Claude 사용 시
# ANTHROPIC_API_KEY=

# OpenAI 사용 시
# OPENAI_API_KEY=

# HolmesGPT 운영 모델 (litellm 표기)
# 예: anthropic/claude-sonnet-5, openai/gpt-4o
MODEL=anthropic/claude-sonnet-5

# 운영 LLM API 키 (settings.api_key — litellm에 직접 전달, SecretStr. 기본값 None)
# API_KEY=

# 사내 OpenAI 호환 엔드포인트(vLLM 등)의 base_url — litellm api_base로 전달.
# 미설정(None)이면 프로바이더 기본 경로(SaaS). FabriX(KBGenAIChat)는 OpenAI 비호환이라 불가 —
# 조사 LLM은 tool-calling 되는 엔드포인트여야 한다.
# API_BASE=http://vllm-host:8000/v1

# holmes 토큰 예산 — litellm 목록에 없는 모델(vLLM served name 등)이면 holmes가 매 요청 max_tokens=64000,
# 컨텍스트 200000으로 잡는다. 미설정=holmes 기본 그대로. 둘은 함께 설정한다(출력 예약분이 컨텍스트 이상이면
# 매 호출 거부). vLLM은 입력+출력 <= --max-model-len이어야 한다 — 32768이면 30000·2048 (D-213).
# holmes의 같은 이름 환경변수와 달리 .env에 적어도 적용된다(AgentSettings 필드).
# ⚠ 숫자 필드 — 빈 값(KEY=)으로 두면 설정 로드가 실패하므로 켤 때만 해제한다
# OVERRIDE_MAX_CONTENT_SIZE=30000
# OVERRIDE_MAX_OUTPUT_TOKEN=2048

# 조사 1건 LLM 호출 step 상한. 상한 도달 시 graceful 반환(하드 실패 금지),
# dispatcher 전체 타임아웃이 하드 백스톱. 다중 메트릭 실측 마진 40
MAX_STEPS=40

# 폴스타 MCP(mcp_server) SSE 엔드포인트 (D-119 — Prometheus 접속 설정은 여기가 아니라
# mcp_server 측 PROMETHEUS_URL로 일원화. sre_agent는 Prometheus 주소를 모른다)
POLESTAR_MCP_URL=http://localhost:9099/sse
# mcp_server 정적 Bearer 토큰 (서버 MCP_BEARER_TOKEN과 일치. 미설정=무인증 로컬 경로)
# POLESTAR_MCP_TOKEN=

# 제니퍼 APM 게이트웨이(apm_gateway) SSE 엔드포인트 (plans/87 J3 · D-274). 미설정=등록 안 함(종전과 동일).
# 폴스타 URL 없이 이것만 있어도 등록된다. 제니퍼가 있는 환경에만 둔다.
# APM_MCP_URL=http://127.0.0.1:9096/sse
# 게이트웨이 정적 Bearer 토큰 (게이트웨이 APM_GATEWAY_BEARER_TOKEN과 일치. 미설정=무인증)
# APM_MCP_TOKEN=

# 조사 서비스(interface/mcp_service) 정적 Bearer 토큰 (D-125 — 본체
# NOISE_INVESTIGATION_SERVICE_TOKEN과 일치시킬 것. 미설정=무인증 로컬/개발)
# SERVICE_BEARER_TOKEN=

# 조사 서비스 listen 호스트 (기본 127.0.0.1. 0.0.0.0으로 열면 SERVICE_BEARER_TOKEN 필수)
# SERVICE_HOST=127.0.0.1

# 설정 관리 API(/admin/config · plans/191 · D-345) 관리 토큰. 미설정=관리 라우트 미등록(종전과 동일).
# 시크릿이므로 sre_agent/.encenv에 둔다. SERVICE_BEARER_TOKEN과 다른 값이어야 한다(같으면 등록하지 않는다).
# 웹 저장은 sre_agent/ 디렉토리를 CWD로 기동했을 때만 허용된다(레포 루트 CWD면 쓰기 차단).
# SRE_AGENT_ADMIN_TOKEN=

# ── 조사 dispatcher 폭주 방지 가드 (Plan 02 §4·§10 — 기본 off/보수값) ──
# 조사 1건 전체 타임아웃(초, per-call 아님). MCP 동기 타임아웃(60s)보다 길어야
# submit/poll 비동기 잡 패턴이 성립한다. 기본 600(plans/187 W22 — 수집 예산 + 소견 + 종합보다 길어야 한다).
# 정렬 규칙(plans/190 W4): 본체 NOISE_INVESTIGATION_FOLLOWUP_TIMEOUT_SECONDS(후속 대기) > 이 값(조사 예산).
# 권장 후속 대기 = 워치독 임계 max(600, 2×INVESTIGATION_TIMEOUT_SECONDS) — 예: 300이면 600, 600이면 1200.
# 기동 로그 「조사 시간 사슬」 1줄로 sre_agent 안쪽 값의 정합을 확인한다
INVESTIGATION_TIMEOUT_SECONDS=600
# 동일 fingerprint 재조사 최소 간격(초). 미설정(None)=TTL dedup off(활성 fingerprint dedup만).
# ⚠ 숫자 필드 — 빈 값(KEY=)으로 두면 설정 로드가 실패하므로 켤 때만 해제한다
# INVESTIGATION_DEDUP_TTL_SECONDS=600
# 동시 조사 상한(세마포어)
INVESTIGATION_MAX_CONCURRENT=2
# 동시 상한 슬롯을 기다릴 수 있는 잡 수 (plans/194 W3 · 기본 4). 넘치면 즉시 거부(queue_full).
# ⚠ 숫자 필드 — 빈 값(KEY=)·null은 설정 로드 실패(무제한은 .env로 못 준다 — 큰 값으로 늘린다)
INVESTIGATION_MAX_QUEUED=4
# 시간 초과로 버린 조사 스레드가 슬롯·호스트 키를 붙드는 최대 시간(초 · plans/194 W3 · 기본 120)
INVESTIGATION_ABANDON_GRACE_SECONDS=120
# 시간당 전역 조사 횟수 상한 (코드 기본 20 — 사용자 확정 2026-10-26 · D-347 ②). 초과 시 신규 조사 거부.
# 미설정=20. 바꿀 때만 해제한다. 끌 수는 없다(None은 .env로 못 준다 — 큰 값으로 늘린다).
# ⚠ 숫자 필드 — 빈 값(KEY=)으로 두면 설정 로드가 실패한다
# INVESTIGATION_HOURLY_BUDGET=20
# 조사 감사 JSONL 경로 (plans/154 — 벤치 감사를 운영 감사와 분리). 미설정=sre_agent/.data/investigation_audit.jsonl
# INVESTIGATION_AUDIT_PATH=.data/investigation_bench/run/audit.jsonl

# 비선두 system 메시지 강등 가드 (D-213). Qwen 템플릿(vLLM)은 system을 맨 앞에만 허용하는데
# holmes 컨텍스트 압축이 말미에 system 안내를 붙여 "System message must be at the beginning."
# 으로 조사가 실패한다. 가드는 0번이 아닌 system의 role만 user로 바꾸고 content는 보존한다.
# ★ 기본 on(명시적 예외) — 교정할 것이 없으면 원본 그대로라 정상 경로는 비트 동일하고,
# off는 곧 "압축 발동 시 실패"를 뜻한다. 만료일 2027-03-11에 유지/삭제 판정.
SYSTEM_MESSAGE_POSITION_FIX=true
# Gemma 도구 호출 마크업 클라이언트 측 파싱 (plans/188 C8). vLLM --tool-call-parser가 모델과
# 맞지 않으면 도구 호출이 content 본문(<|tool_call>call:이름{...}<tool_call|>)으로 돌아와 조사가
# 1턴에서 끝난다. 가드는 그 블록을 해석해 tool_calls로 바꾼다(해석 실패면 원본 유지 → 미결 종결).
# ★ 기본 on(명시적 예외) — 마크업이 없으면 원본 그대로라 정상 경로는 비트 동일하고,
# off는 곧 "파서 불일치 환경에서 조사 전건 실패"를 뜻한다. 만료일 2027-04-19에 유지/삭제 판정.
TOOL_CALL_MARKUP_PARSE_ENABLED=true
# bash 쓰기 형태 거부 가드 (D-235). holmes 허용목록은 prefix 매칭이라 `uptime`이 허용이면
# `uptime > /tmp/x`도 통과한다 — 설정으로 막을 수단이 없어 검증 경계에서 거부한다.
# ★ 기본 on(명시적 예외) — 쓰기 형태가 아니면 원본 판정 그대로라 읽기 조사 경로는 비트 동일하고,
# off는 곧 "읽기 전용 프로파일이 파일을 쓸 수 있다"를 뜻한다. 만료일 2027-03-21에 유지/삭제 판정.
BASH_WRITE_GUARD_ENABLED=true

# 중요도 2차 판정(severity_judge, escalate-only). 기본 off — off면 게이트 판정 승계
SEVERITY_JUDGE_ENABLED=false
# 조치 권고(remediation_recommender, D-011 제시 전용 — 실행 경로 없음 D-003). 기본 off.
# severity_judge off면 매칭 시그니처가 없어 권고도 비어 있다
REMEDIATION_RECOMMENDER_ENABLED=false
# 값 대조 인용 검증(plans/198 I-4). 기본 off. 켜면 조사 서술의 수치·시각·서버 이름을 실제 도구 결과와
# 맞대 보고, 결과에 없는 값을 쓴 문장은 가설로 낮추고 한계에 「원장에 없는 값: …」을 적는다
CITATION_VALUE_CHECK_ENABLED=false
# 실패 모드 가드(plans/198 I-10). 셋 다 기본 off. HolmesGPT 조사에만 걸린다
# 미완주(step 상한·정체 중단)·전체 타임아웃이면 빈 안내 대신 그때까지 받은 도구 결과로 부분 브리핑을 만든다
PARTIAL_BRIEFING_ON_INCOMPLETE=false
# 같은 조회를 STALL_REPEAT_THRESHOLD번 반복하거나 새 근거 없는 도구 단계가 STALL_IDLE_STEPS번 이어지면 조사를 멈춘다
STALL_STOP_ENABLED=false
STALL_REPEAT_THRESHOLD=3
STALL_IDLE_STEPS=4
# 알람 종류별 기대 소스(config/expected_sources.yaml) 중 한 번도 조회하지 않은 소스를 한계에 적는다
UNCHECKED_SOURCE_LIMITATION_ENABLED=false
# 플레이북 모드 심층 조사 지시에 그 플레이북의 단계 순서를 조사 계획으로 넣는다(결과는 넣지 않는다)
SOP_ANCHOR_ENABLED=false
# 알람 종류별 허용 소스(config/expected_sources.yaml의 allowed)로 그 조사의 도구를 좁힌다.
# 범위 밖 소스가 필요하면 조사 결론에 「추가 조사 필요: …」로 적게 한다(실행하지 않는다)
KIND_TOOLSET_NARROWING_ENABLED=false

# 개발·테스트 LLM — Gemini API (D-120)
# 외부 SaaS: 개발·테스트 전용, 운영 투입 금지 — 송신 입력은 목업·로컬 픽스처만.
# litellm 1.89.0 실측: 모델 문자열 prefix 'gemini/', 키 GEMINI_API_KEY(또는 LLM_GEMINI_API_KEY).
# 기본값 gemini/gemini-3.5-flash — 2026-07-28 ListModels 실측(2.0-flash는 서버측 퇴역 404,
# 2.5-*는 D-021 사용 금지). settings.py 주석 참조.
INVESTIGATION_LLM_MODEL=gemini/gemini-3.5-flash

# Gemini API 키 (미설정 시 스모크·e2e 보류. 기본값 None)
# GEMINI_API_KEY=

# 실 조사 LLM 게이트 (D-230). 미설정=종전 판정(GEMINI_API_KEY가 있어야 실 조사, 없으면 스텁)
# true=키 없이 실 조사(사내 vLLM 권장 — 종전의 GEMINI_API_KEY=dummy 우회 대체) · false=키가 있어도 항상 스텁
# ⚠ tri-state 필드 — 빈 값(KEY=)이나 null은 미설정이 아니라 설정 로드 실패다. 미설정으로 두려면 줄을 두지 않는다
# 미설정(키 추론) 경로 만료일 2027-03-17 — 도래 시 명시 필수화 여부 판정(D-161 ①)
# INVESTIGATION_LLM_ENABLED=true

# 조사 지침 추가 문구 (plans/50 G5). 미설정(None)이면 기본 지침(원격 셸 안내·사건 구간·부하 가드)만 주입.
# Plan 51 §6 플레이북을 편입할 때 여기에 넣는다.
# INVESTIGATION_GUIDANCE_EXTRA=
# OpenMetrics 서술 노트 (plans/92 O3). 기본 false — mcp_server EXPOSE_OPENMETRICS_TOOLS=true 배치와 함께 켠다. 만료일 2027-03-22(D-161)
OPENMETRICS_GUIDANCE_ENABLED=false
# Prometheus 호스트 앵커 지침 (plans/189 W5). 기본 false — mcp_server PROMETHEUS_ANCHOR_MODE=polestar_host 배치와 함께 켠다.
# 켜면 prom_* 도구의 hostname 의미·source(알람 dbId)·0건 reason 처리 지침이 붙는다. 만료일 2027-04-20(D-161)
PROMETHEUS_ANCHOR_GUIDANCE_ENABLED=false
# APM 조사 지침 (plans/87 J3). 기본 false — APM_MCP_URL 배치와 함께 켠다. 켜면 apm_* 앵커·APM 조사 순서·현재값·폴백 노트,
# apm 사건의 APM 플레이북, 브리핑 소스 라벨·APM 한계, 정체 가드(같은 도구·같은 인자 3회 → 미결)가 붙는다. 만료일 2027-03-29(D-161)
APM_GUIDANCE_ENABLED=false
# APM 판정 승격 (plans/87 J3). 기본 false — 게이트웨이 도구 출력의 was_signals를 중요도 판정 신호로 옮긴다.
# SEVERITY_JUDGE_ENABLED=true와 함께 켠다(judge가 꺼져 있으면 합칠 판정이 없다). 만료일 2027-03-29(D-161)
APM_SIGNATURES_ENABLED=false
# 크로스소스 조사 (plans/153 W5 · D-325). 기본 false — 페이로드 meta.episode(noise_gate 사건 스냅샷)를 무시한다.
# 켜면 인프라·애플리케이션 멤버가 모두 있는 사건에서 크로스소스 질문 · OS+APM 플레이북 병기 · 사건 멤버 타임라인 ·
# 규칙 가설 · 브리핑 cross_source 블록이 붙는다. APM_MCP_URL과 함께 켠다(비면 브리핑 한계에 APM 도구 미연결이 실린다).
# 본체 NOISE_INVESTIGATION_EPISODE_CONTEXT_ENABLED=true가 있어야 meta.episode가 실린다. 만료일 2027-04-12(D-161)
CROSS_SOURCE_INVESTIGATION_ENABLED=false

# 사건 구간 증거 사전수집 + 결정적 상관 (plans/50 G4). 기본 false. 켜면 reference_time이 있는 조사에서
# 조사 전에 mcp_server 도구를 코드가 호출해 선행 신호·타임라인을 계산한다(LLM 호출 없음).
EVIDENCE_CORRELATION_ENABLED=false
EVIDENCE_BASELINE_PERIODS=24
# MCP 도구 호출 **1건당** 상한(초 · 사전수집과 플레이북 스텝 공용). 배치 전체 wedge는 dispatcher가 별도로 끊는다(D-211).
# 기본 60 — 게이트웨이 제니퍼 API 1건 상한(30s)보다 크고 플레이북 스텝 기본 상한(90s)보다 작아야 한다
EVIDENCE_PREFETCH_TIMEOUT_SECONDS=60.0
# 변경 이벤트 오버레이 (plans/91 1-2 · D-209). 켜면 사전수집 배치 말미에 polestar_change_history를
# 1건 더 불러 "변경 직후" 가설을 rank 1(confidence medium)로 세운다. 만료일 2027-03-10
EVIDENCE_CHANGE_OVERLAY_ENABLED=false
# 연관 호스트 알람 소비 대수 (plans/91 1-3 · D-209). 0=off. 게이트가 넘긴 root 서버의 알람만
# 배치 말미에 1건 조회한다(지표는 대표 서버만 — U-I 확정). 만료일 2027-03-10
EVIDENCE_CORRELATION_RELATED_HOSTS=0
# 토폴로지 1홉 이웃 (plans/198 I-7). 기본 false = 종전 동일. EVIDENCE_CORRELATION_ENABLED와 함께 켠다.
# 켜면 폴스타 토폴로지(1홉)와 이전에 확정한 제니퍼→폴스타 연결로만 이웃 서버를 최대
# EVIDENCE_TOPOLOGY_NEIGHBORS_MAX대(기본 5) 골라 그 알람을 한 번 더 조회한다(이웃당 1건). 이웃 알람이
# 대상보다 먼저 울렸으면 외부 원인 후보로 브리핑에 따로 적고, 조사에는 이웃 밖 서버를 보지 말라고 지시한다.
# 플레이북 모드에서는 쓰이지 않는다
EVIDENCE_TOPOLOGY_NEIGHBORS_ENABLED=false
EVIDENCE_TOPOLOGY_NEIGHBORS_MAX=5

# 알람 유형별 조사 플레이북 (plans/187 W4 · D-341). 기본 false = 종전 조사(HolmesGPT + 사전수집) 그대로.
# 켜면 알람 조사가 플레이북(결정적 수집 S0~S8 → 판독 → 가설 → 종합)으로 돌고, 웹 알람 카드에 요약형과
# 「조사 대화로 열기」가 나온다. 켜져 있으면 사전수집(EVIDENCE_*)은 생략한다. 진단 잡(sre_diagnose)은 그대로다.
# 본체 NOISE_INVESTIGATION_TRIGGER_ENABLED=true · NOISE_INVESTIGATION_SERVICE_URL이 있어야 알람 조사가 들어온다.
SRE_PLAYBOOK_ENABLED=false
# 심층 조사(HolmesGPT) 방식 — off(플레이북만) · conditional(1순위 판단 보류 · 결손 단계 2개 이상 · fallback일 때만)
# · parallel(늘 함께 돌려 웹에 엔진 비교 표시 · 도입 초기 권장). 플레이북이 켜져 있을 때만 읽는다.
# 유형별 플레이북 YAML의 deep_dive.mode가 이 값보다 우선한다.
SRE_DEEP_DIVE_MODE=parallel
# 플레이북 YAML 폴더. 미설정이면 패키지 기본(sre_agent/config/playbooks/). 기동 때 한 번 읽는다
# SRE_PLAYBOOK_DIR=
# 플레이북 한 번의 수집 시간 예산(초). 조사 전체 시간 상한 안에서 쓴다(기본 240)
SRE_PLAYBOOK_BUDGET_S=240.0
# 플레이북 APM 게이트웨이 도구 호출 1건당 상한(초 · plans/190 W3). 미설정 또는 0 이하 =
# 종전대로 EVIDENCE_PREFETCH_TIMEOUT_SECONDS(기본 60 · plans/187 W22)를 같이 쓴다.
# 이 상한 위에 두 겹이 더 있다 — ① 스텝 1개 대기 상한(플레이북 YAML 스텝 timeout_s · 없으면 90초 ·
# 대상 확정 스텝 120초 · plans/187 W21·W22, 남은 예산보다 길지 않음) ② 수집 예산 SRE_PLAYBOOK_BUDGET_S.
# 더 짧은 쪽이 먼저 끊으므로 이 값은 스텝 대기 상한보다 작게 둔다.
# ⚠ 숫자 필드 — 빈 값(KEY=)으로 두면 설정 로드가 실패하므로 켤 때만 해제한다
# APM_TOOL_TIMEOUT_SECONDS=60
# X-View 사전 확인 상한(plans/190 W2). 기간 모드 apm_app_health가 부를 X-View 호출 수(1분 조각 × 소스·도메인)가
# 이 수를 넘으면 게이트웨이가 데이터 호출 없이 confirm_required를 돌려주고, 플레이북은 시 단위 통계
# (apm_period_compare)로 대체한 뒤 [한계]로 노출한다. 0 이하 = 인자 미전송(종전 동작).
# 기본 10 — 기본 off 원칙의 예외(off면 폐쇄망 정체 · 도구 1건 8~11분 · 2026-10-20가 그대로 남는다)
APM_XVIEW_CONFIRM_OVER=10
# 시간 안에 끝나지 않아 빠진 단계를 수집 뒤 남은 예산 안에서 1회 다시 확인한다(plans/187 W22 · 기본 true).
# 이미 받은 조회는 다시 부르지 않는다. 첫 시도에서 오류로 끝난 조회(도구 1건 상한 초과 포함)도 그 조사 안에서는
# 오류로 남아 다시 부르지 않는다. false면 종전처럼 빠진 채로 둔다
SRE_PLAYBOOK_RETRY_TIMED_OUT_STEPS=true
# 판단 보류 가설을 가르는 추가 조회를 1회 돈다(plans/198 I-2 · 기본 false = 종전 동일). 수집 뒤 남은 예산 안에서
# 상위 판단 보류 가설 SRE_PLAYBOOK_DISCRIMINATOR_TOP_N개(기본 2)에 대해 플레이북에 없는 단계만 돌리고, 그 가설만
# 규칙으로 다시 판정한다(결과 hypotheses[].verification). 심층 조사 결과는 가설 상태를 바꾸지 않는다
SRE_PLAYBOOK_DISCRIMINATOR_ENABLED=false
SRE_PLAYBOOK_DISCRIMINATOR_TOP_N=2
# 도구 배치 한 번에 동시에 보내는 호출 수 (plans/187 W21 · 1~8). 1 = 하나씩 차례로(종전). 사전수집에도 같이 적용된다.
# 실제 동시 호출은 스텝 4개 × 이 값 × 동시 조사 수까지 늘 수 있다
SRE_TOOL_BATCH_CONCURRENCY=4
# 프로세스 전체에서 한 축(폴스타 MCP · APM 각각)에 동시에 보내는 도구 호출 상한 (plans/194 W3 · 기본 8).
# 자리를 도구 1건 상한 안에 못 얻으면 그 호출만 결손(tool_concurrency_wait_timeout)
SRE_TOOL_GLOBAL_CONCURRENCY=8
# 단계 소견(LLM) 한 건의 시간 상한(초 · 기본 60). 남은 조사 시간이 적으면 자동으로 줄어든다
SRE_NARRATOR_STEP_TIMEOUT_S=60.0
# 종합 소견(LLM) 한 건의 시간 상한(초 · 기본 90 · plans/187 W22). 남은 조사 시간이 적으면 자동으로 줄어든다
SRE_NARRATOR_SYNTHESIS_TIMEOUT_S=90.0
# APM(제니퍼) 소스 ID → 폴스타 DB 매핑(JSON). 알람에 폴스타 DB 정보가 없을 때만 대신 쓴다.
# 존이 다른 알람이면 다른 서버를 조회할 수 있으니 소스와 존이 1:1일 때만 적는다. 예: {"cm_prd":"polestar_cm_gp"}
SRE_PLAYBOOK_POLESTAR_SOURCE_MAP={}

# 조사 잡 실행 기록 (plans/187 W13 · D-341). 기본 true(2026-10-29부터) = 조사마다 동시 조사 대기·단계·도구 호출·
# 소견 LLM·HolmesGPT 도구/판단 회차/AI 메모를 메모리에 남기고
# (조사당 최근 300건 · 발췌·AI 메모 1건 2KB · 조사당 256KB), 본체 「장애 진단」 탭이 진행 상황을 읽는다.
# 비밀번호·토큰 꼴은 남기기 전에 가린다. 조사 기록 보관 시간(1시간)이 지나면 함께 사라진다.
# 끄려면 false로 둔다 — 기록하지 않고 조사 조회 응답이 종전과 같다.
SRE_ACTIVITY_LOG_ENABLED=true
